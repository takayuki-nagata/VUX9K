/dts-v1/;

#include "vux9k-common.dtsi"

/ {
	model = "VUX9K Tang Nano 9K SoC";
};

/* I-RAM 0x0000-0x37FF: the second stage's `run` window for RV32 applications in I-RAM,
 * which start in place of the first stage (until the board moves to the PSRAM) */
&flash0 {
	reg = <0x00000000 0x3800>;
};

/* D-RAM 0x2000_0000-0x2000_1FF7 (less the old boot chain's mailbox words, kept until the
 * board moves to the PSRAM) */
&sram0 {
	reg = <0x20000000 0x1FF8>;
};
