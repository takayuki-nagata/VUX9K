 *
 * The VUX9K SoC as soc/soc_top.veryl builds it; vux9k.dts adds the memories (the nodes
 * flash0 and sram0 under soc, in the PSRAM).
 */

#include <mem.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	compatible = "vux9k,vux9k";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <18000000>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "riscv";
			riscv,isa = "rv32im_zicsr_zifencei";
			reg = <0>;
			clock-frequency = <18000000>;

			cpu0_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				interrupt-controller;
				#address-cells = <0>;
				#interrupt-cells = <1>;
			};
		};
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges;

		/* Machine external interrupt (cause 11) while the RX FIFO holds data */
		uart0: uart@40000000 {
			compatible = "vux9k,uart";
			reg = <0x40000000 0x10>;
			interrupts-extended = <&cpu0_intc 11>;
			status = "okay";
		};

		/*
		 * soc/timer_core.veryl, the CLINT (RV32 region 2): msip at +0x0, mtimecmp at
		 * +0x4000, mtime at +0xbff8, SiFive's layout, which Zephyr's riscv_machine_timer
		 * driver serves; it takes the timer interrupt from the second entry (MSI, MTI).
		 */
		clint: clint@20000000 {
			compatible = "sifive,clint0";
			reg = <0x20000000 0x10000>;
			interrupts-extended = <&cpu0_intc 3>, <&cpu0_intc 7>;
			status = "okay";
		};
	};
};
