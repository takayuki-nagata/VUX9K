// Robust Standard UART Transmitter (8N1: 1 Start, 8 Data, 1 Stop bit)
pub module uart_tx #(
    param CNT  : u32 = 234, // 27 MHz / 115200 bps
    param CSIZE: u32 = 10 ,
) (
    clk : input  clock   ,
    rst : input  reset   ,
    data: input  logic<8>,
    we  : input  logic   ,
    busy: output logic   ,
    txd : output logic   ,
) {
    const CNT_M1: u32 = CNT - 1;

    var bit_counter    : logic<10>; // Counts 0 .. CNT-1 per bit
    var bit_index      : logic<4> ; // Counts 0 .. 9 (0: start, 1..8: data, 9: stop)
    var shift_reg      : logic<10>; // {1'b1, data, 1'b0}
    var is_transmitting: logic    ;

    assign busy = is_transmitting;
    assign txd  = if is_transmitting ? shift_reg[0] : 1'b1;

    always_ff (clk, rst) {
        if_reset {
            bit_counter     = 10'd0;
            bit_index       = 4'd0;
            shift_reg       = 10'h3ff;
            is_transmitting = 1'b0;
        } else {
            if !is_transmitting {
                if we {
                    shift_reg       = {1'b1, data, 1'b0};
                    bit_counter     = 10'd0;
                    bit_index       = 4'd0;
                    is_transmitting = 1'b1;
                }
            } else {
                if (bit_counter as u32) == CNT_M1 {
                    bit_counter = 10'd0;
                    if bit_index == 4'd9 {
                        is_transmitting = 1'b0;
                    } else {
                        bit_index = bit_index + 1'b1;
                        shift_reg = {1'b1, shift_reg[9:1]};
                    }
                } else {
                    bit_counter = bit_counter + 1'b1;
                }
            }
        }
    }
}
