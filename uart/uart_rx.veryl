// Robust Standard UART Receiver (8N1: Center-Sampled at 115200 baud)
pub module uart_rx #(
    param CNT  : u32 = 234, // 27 MHz / 115200 bps
    param CSIZE: u32 = 10 ,
) (
    clk : input  clock   ,
    rst : input  reset   ,
    data: output logic<8>,
    rdy : output logic   ,
    rxd : input  logic   ,
) {
    const CNT_M1  : u32 = CNT - 1;
    const HALF_CNT: u32 = CNT / 2;

    var rxd_sync    : logic<2> ;
    var bit_counter : logic<10>;
    var bit_index   : logic<4> ;
    var rx_shift    : logic<8> ;
    var rx_rdy      : logic    ;
    var is_receiving: logic    ;

    assign data = rx_shift;
    assign rdy  = rx_rdy;

    always_ff (clk, rst) {
        if_reset {
            rxd_sync     = 2'b11;
            bit_counter  = 10'd0;
            bit_index    = 4'd0;
            rx_shift     = 8'd0;
            rx_rdy       = 1'b0;
            is_receiving = 1'b0;
        } else {
            rxd_sync = {rxd_sync[0], rxd};
            rx_rdy   = 1'b0;

            if !is_receiving {
                // Detect falling edge of start bit
                if rxd_sync == 2'b10 {
                    bit_counter  = 10'd0;
                    bit_index    = 4'd0;
                    is_receiving = 1'b1;
                }
            } else {
                if (bit_counter as u32) == CNT_M1 {
                    bit_counter = 10'd0;
                    if bit_index == 4'd9 {
                        // End of stop bit period
                        is_receiving = 1'b0;
                    } else {
                        bit_index = bit_index + 1'b1;
                    }
                } else {
                    if (bit_counter as u32) == HALF_CNT {
                        case bit_index {
                            4'd0: {
                                // Verify valid start bit (must be 0)
                                if rxd_sync[1] != 1'b0 {
                                    is_receiving = 1'b0; // Spurious glitch
                                }
                            }
                            4'd1, 4'd2, 4'd3, 4'd4, 4'd5, 4'd6, 4'd7, 4'd8: {
                                // Sample data bit in middle of period (LSB first)
                                rx_shift = {rxd_sync[1], rx_shift[7:1]};
                            }
                            4'd9: {
                                // Verify valid stop bit (must be 1) and assert ready pulse
                                if rxd_sync[1] == 1'b1 {
                                    rx_rdy = 1'b1;
                                }
                            }
                            default: {}
                        }
                    }
                    bit_counter = bit_counter + 1'b1;
                }
            }
        }
    }
}
