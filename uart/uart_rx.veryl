// Robust Standard UART Receiver (8N1: Center-Sampled at 115200 baud)
pub module uart_rx #(
    param CNT  : u32 = 234,
    param CSIZE: u32 = 10 ,
) (
    clk : input  clock   ,
    rst : input  reset   ,
    data: output logic<8>,
    rdy : output logic   ,
    rxd : input  logic   ,
) {
    const CNT_M1  : u32 = CNT - 1;
    const HALF_CNT: u32 = CNT / 2;

    var rxd_sync    : logic<2> ;
    var bit_counter : logic<10>;
    var bit_index   : logic<4> ;
    var rx_shift    : logic<8> ;
    var rx_rdy      : logic    ;
    var is_receiving: logic    ;

    assign data = rx_shift;
    assign rdy  = rx_rdy;

    always_ff (clk, rst) {
        if_reset {
            rxd_sync     = 2'b11;
            bit_counter  = 10'd0;
            bit_index    = 4'd0;
            rx_shift     = 8'd0;
            rx_rdy       = 1'b0;
            is_receiving = 1'b0;
        } else {
            rxd_sync = {rxd_sync[0], rxd};
            rx_rdy   = 1'b0;

            if !is_receiving {
                // Falling edge / Start bit detection
                if rxd_sync == 2'b10 {
                    bit_counter  = 10'd0;
                    bit_index    = 4'd0;
                    is_receiving = 1'b1;
                }
            } else {
                if (bit_counter as u32) == CNT_M1 {
                    bit_counter = 10'd0;
                    if bit_index == 4'd8 { // Stop bit reached
                        is_receiving = 1'b0;
                        if rxd_sync[1] == 1'b1 { // Valid stop bit
                            rx_rdy = 1'b1;
                        }
                    } else {
                        bit_index = bit_index + 1'b1;
                    }
                } else {
                    if (bit_counter as u32) == HALF_CNT && bit_index >: 4'd0 {
                        // Sample bit in center of bit period (bits 1..8)
                        rx_shift = {rxd_sync[1], rx_shift[7:1]};
                    }
                    bit_counter = bit_counter + 1'b1;
                }
            }
        }
    }
}
