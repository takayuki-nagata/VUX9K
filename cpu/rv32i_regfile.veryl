// RISC-V RV32I Dual-Write Register File (with Hack multi-dest support)
// Single-write-port prioritized structure for optimal FPGA Distributed RAM mapping
pub module rv32i_regfile (
    clk     : input  clock    ,
    rst     : input  reset    ,
    we      : input  logic    ,
    rd_addr : input  logic<5> ,
    wr_data : input  logic<32>,
    we2     : input  logic    ,
    rd2_addr: input  logic<5> ,
    wr2_data: input  logic<32>,
    rs1_addr: input  logic<5> ,
    rs2_addr: input  logic<5> ,
    rs1_data: output logic<32>,
    rs2_data: output logic<32>,
) {
    var registers: logic<32> [32];

    assign rs1_data = if rs1_addr == 5'd0 ? 32'd0 : registers[rs1_addr];
    assign rs2_data = if rs2_addr == 5'd0 ? 32'd0 : registers[rs2_addr];

    always_ff (clk) {
        if we && rd_addr != 5'd0 {
            registers[rd_addr] = wr_data;
        } else if we2 && rd2_addr != 5'd0 {
            registers[rd2_addr] = wr2_data;
        }
    }
}
