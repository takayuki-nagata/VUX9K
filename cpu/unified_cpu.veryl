// Unified Dual-ISA CPU Core (RISC-V 32-bit + Hack 16-bit) in Veryl
// Robust 2-Stage Multi-Cycle FSM Architecture (Fetch -> Execute) for 100% Gowin FPGA Synchronous Block RAM Compatibility
pub module unified_cpu (
    clk         : input  clock    ,
    rst         : input  reset    ,
    instr_in    : input  logic<32>,
    data_in     : input  logic<32>,
    timer_irq_in: input  logic    ,
    ext_irq_in  : input  logic    ,
    sw_irq_in   : input  logic    ,
    pc_out      : output logic<32>,
    data_addr   : output logic<32>,
    data_out    : output logic<32>,
    mem_write   : output logic    ,
    mem_byte_we : output logic<4> ,
    active_mode : output logic    , // 0: Hack 16-bit, 1: RISC-V 32-bit
) {
    enum CpuState {
        FETCH,
        EXECUTE,
        MEM_WAIT,
    }

    var state        : CpuState ;
    var is_riscv_mode: logic    ;
    var pc_reg       : logic<32>;
    var next_pc      : logic<32>;
    var ir_reg       : logic<32>; // Instruction Register

    // Hack Translator signals
    var h_rs1       : logic           <5> ;
    var h_rs2       : logic           <5> ;
    var h_rd        : logic           <5> ;
    var h_imm       : logic           <32>;
    var h_alu_op    : rv32i_pkg::AluOp    ;
    var h_use_imm   : logic               ;
    var h_use_mem   : logic               ;
    var h_we_reg_a  : logic               ;
    var h_we_reg_d  : logic               ;
    var h_we_mem    : logic               ;
    var h_jump_cond : logic           <3> ;
    var h_is_c_instr: logic               ;

    // RV32I Decoder signals
    var rv_opcode  : logic<7> ;
    var rv_rd      : logic<5> ;
    var rv_funct3  : logic<3> ;
    var rv_rs1     : logic<5> ;
    var rv_rs2     : logic<5> ;
    var rv_funct7  : logic<7> ;
    var rv_imm     : logic<32>;
    var rv_csr_addr: logic<12>;
    var rv_uimm    : logic<32>;

    // Register File Signals
    var rf_rs1_addr: logic<5> ;
    var rf_rs2_addr: logic<5> ;
    var rf_rd_addr : logic<5> ;
    var rf_we      : logic    ;
    var rf_wr_data : logic<32>;
    var rf_rd2_addr: logic<5> ;
    var rf_we2     : logic    ;
    var rf_wr2_data: logic<32>;
    var rf_rs1_data: logic<32>;
    var rf_rs2_data: logic<32>;

    // ALU Signals
    var alu_operand_a: logic           <32>;
    var alu_operand_b: logic           <32>;
    var alu_ctrl     : rv32i_pkg::AluOp    ;
    var alu_result   : logic           <32>;
    var alu_zero     : logic               ;

    // CSR Module Signals
    var csr_we     : logic    ;
    var csr_rdata  : logic<32>;
    var trap_entry : logic    ;
    var trap_cause : logic<32>;
    var trap_val   : logic<32>;
    var trap_return: logic    ;
    var irq_pending: logic    ;
    var mtvec_out  : logic<32>;
    var mepc_out   : logic<32>;
    var is_ecall   : logic    ;
    var is_ebreak  : logic    ;
    var is_mret    : logic    ;

    // Internal Helper Signals
    var is_neg        : logic                ;
    var byte_sel      : u32                  ;
    var load_val      : logic            <32>;
    var r_mem_write   : logic                ;
    var r_mem_byte_we : logic            <4> ;
    var r_data_out    : logic            <32>;
    var rv_branch_take: logic                ;
    var hack_jump_take: logic                ;
    var rv_op         : rv32i_pkg::Opcode    ;
    var rv_f3         : rv32i_pkg::Funct3    ;

    assign active_mode = is_riscv_mode;
    assign pc_out      = if (state == CpuState::EXECUTE || state == CpuState::MEM_WAIT) ? next_pc : pc_reg;
    assign data_addr   = if is_riscv_mode ? alu_result : rf_rs2_data;
    assign data_out    = r_data_out;
    assign mem_byte_we = r_mem_byte_we;
    assign mem_write   = if (state == CpuState::EXECUTE) ? r_mem_write : 1'b0;

    assign is_riscv_mode = 1'b1;

    // Hack Translator (16-bit Front-End)
    var h_instr_16: logic<16>;
    assign h_instr_16 = if pc_reg[1] ? ir_reg[31:16] : ir_reg[15:0];

    inst hack_trans: hack_translator (
        instr_16  : h_instr_16  ,
        rs1       : h_rs1       ,
        rs2       : h_rs2       ,
        rd        : h_rd        ,
        imm       : h_imm       ,
        alu_op    : h_alu_op    ,
        use_imm   : h_use_imm   ,
        use_mem   : h_use_mem   ,
        we_reg_a  : h_we_reg_a  ,
        we_reg_d  : h_we_reg_d  ,
        we_mem    : h_we_mem    ,
        jump_cond : h_jump_cond ,
        is_c_instr: h_is_c_instr,
    );

    // RV32I Instruction Decoder
    inst rv_decode: rv32i_decode (
        instruction: ir_reg     ,
        opcode     : rv_opcode  ,
        rd         : rv_rd      ,
        funct3     : rv_funct3  ,
        rs1        : rv_rs1     ,
        rs2        : rv_rs2     ,
        funct7     : rv_funct7  ,
        imm        : rv_imm     ,
        csr_addr   : rv_csr_addr,
        uimm       : rv_uimm    ,
    );

    // Dual-Port Register File
    inst reg_file: rv32i_regfile (
        clk     : clk        ,
        rst     : rst        ,
        we      : if (state == CpuState::EXECUTE && rv_op != rv32i_pkg::Opcode::LOAD) || (state == CpuState::MEM_WAIT) ? rf_we : 1'b0,
        rd_addr : rf_rd_addr ,
        wr_data : rf_wr_data ,
        we2     : if (state == CpuState::EXECUTE) ? rf_we2 : 1'b0,
        rd2_addr: rf_rd2_addr,
        wr2_data: rf_wr2_data,
        rs1_addr: rf_rs1_addr,
        rs2_addr: rf_rs2_addr,
        rs1_data: rf_rs1_data,
        rs2_data: rf_rs2_data,
    );

    // Main 32-bit ALU
    inst main_alu: rv32i_alu (
        a     : alu_operand_a,
        b     : alu_operand_b,
        alu_op: alu_ctrl     ,
        result: alu_result   ,
        zero  : alu_zero     ,
    );

    // Control and Status Registers (CSR)
    inst csrs_inst: rv32i_csrs (
        clk         : clk                                                 ,
        rst         : rst                                                 ,
        csr_addr    : rv_csr_addr                                         ,
        csr_wdata   : if rv_funct3[2] ? rv_uimm : rf_rs1_data             ,
        csr_op      : if (state == CpuState::EXECUTE) ? rv_funct3 : 3'b000,
        csr_rdata   : csr_rdata                                           ,
        trap_entry  : trap_entry                                          ,
        trap_cause  : trap_cause                                          ,
        trap_pc     : pc_reg                                              ,
        trap_val    : trap_val                                            ,
        trap_return : trap_return                                         ,
        timer_irq_in: timer_irq_in                                        ,
        ext_irq_in  : ext_irq_in                                          ,
        sw_irq_in   : sw_irq_in                                           ,
        irq_pending : irq_pending                                         ,
        mtvec_out   : mtvec_out                                           ,
        mepc_out    : mepc_out                                            ,
    );

    // Combinational Execution Datapath
    always_comb {
        rv_op       = rv_opcode as rv32i_pkg::Opcode;
        rv_f3       = rv_funct3 as rv32i_pkg::Funct3;
        is_ecall    = 1'b0;
        is_ebreak   = 1'b0;
        is_mret     = 1'b0;
        trap_entry  = 1'b0;
        trap_return = 1'b0;
        trap_cause  = 32'd0;
        trap_val    = 32'd0;
        csr_we      = 1'b0;

        // Branch & Jump Condition Evaluation
        is_neg = alu_result[31];
        case rv_f3 {
            rv32i_pkg::Funct3::ADD_SUB: rv_branch_take = alu_zero;
            rv32i_pkg::Funct3::SLL    : rv_branch_take = !alu_zero;
            rv32i_pkg::Funct3::XOR    : rv_branch_take = is_neg;
            rv32i_pkg::Funct3::SRL_SRA: rv_branch_take = !is_neg;
            rv32i_pkg::Funct3::OR     : rv_branch_take = (rf_rs1_data as u32) <: (rf_rs2_data as u32);
            rv32i_pkg::Funct3::AND    : rv_branch_take = !((rf_rs1_data as u32) <: (rf_rs2_data as u32));
            default                   : rv_branch_take = 1'b0;
        }

        // Hack Jump Conditions
        case h_jump_cond {
            3'b001 : hack_jump_take = (!alu_zero) && (!is_neg); // JGT
            3'b010 : hack_jump_take = alu_zero;                // JEQ
            3'b011 : hack_jump_take = (!is_neg);               // JGE
            3'b100 : hack_jump_take = is_neg;                  // JLT
            3'b101 : hack_jump_take = !alu_zero;               // JNE
            3'b110 : hack_jump_take = is_neg || alu_zero;      // JLE
            3'b111 : hack_jump_take = 1'b1;                    // JMP
            default: hack_jump_take = 1'b0;
        }

        // Sub-word Load Steering
        byte_sel = alu_result[1:0] as u32;
        case rv_f3 {
            rv32i_pkg::Funct3::ADD_SUB: { // LB
                case byte_sel {
                    0      : load_val = {data_in[7] repeat 24, data_in[7:0]};
                    1      : load_val = {data_in[15] repeat 24, data_in[15:8]};
                    2      : load_val = {data_in[23] repeat 24, data_in[23:16]};
                    default: load_val = {data_in[31] repeat 24, data_in[31:24]};
                }
            }
            rv32i_pkg::Funct3::XOR: { // LBU
                case byte_sel {
                    0      : load_val = {24'd0, data_in[7:0]};
                    1      : load_val = {24'd0, data_in[15:8]};
                    2      : load_val = {24'd0, data_in[23:16]};
                    default: load_val = {24'd0, data_in[31:24]};
                }
            }
            rv32i_pkg::Funct3::SLL: { // LH
                if alu_result[1] == 1'b0 {
                    load_val = {data_in[15] repeat 16, data_in[15:0]};
                } else {
                    load_val = {data_in[31] repeat 16, data_in[31:16]};
                }
            }
            rv32i_pkg::Funct3::SRL_SRA: { // LHU
                if alu_result[1] == 1'b0 {
                    load_val = {16'd0, data_in[15:0]};
                } else {
                    load_val = {16'd0, data_in[31:16]};
                }
            }
            default: { // LW
                load_val = data_in;
            }
        }

        if is_riscv_mode {
            // RISC-V Mode
            rf_rs1_addr = rv_rs1;
            rf_rs2_addr = rv_rs2;
            rf_rd_addr  = rv_rd;
            rf_we2      = 1'b0;
            rf_rd2_addr = 5'd0;
            rf_wr2_data = 32'd0;

            case rv_op {
                rv32i_pkg::Opcode::AUIPC: {
                    alu_operand_a = pc_reg;
                    alu_operand_b = rv_imm;
                    alu_ctrl      = rv32i_pkg::AluOp::ADD;
                }
                rv32i_pkg::Opcode::LUI: {
                    alu_operand_a = 32'd0;
                    alu_operand_b = rv_imm;
                    alu_ctrl      = rv32i_pkg::AluOp::COPY_B;
                }
                rv32i_pkg::Opcode::I_TYPE: {
                    alu_operand_a = rf_rs1_data;
                    alu_operand_b = rv_imm;
                    case rv_f3 {
                        rv32i_pkg::Funct3::ADD_SUB: alu_ctrl = rv32i_pkg::AluOp::ADD;
                        rv32i_pkg::Funct3::SLL    : alu_ctrl = rv32i_pkg::AluOp::SLL;
                        rv32i_pkg::Funct3::SLT    : alu_ctrl = rv32i_pkg::AluOp::SLT;
                        rv32i_pkg::Funct3::SLTU   : alu_ctrl = rv32i_pkg::AluOp::SLTU;
                        rv32i_pkg::Funct3::XOR    : alu_ctrl = rv32i_pkg::AluOp::XOR;
                        rv32i_pkg::Funct3::SRL_SRA: if rv_funct7[5] {
                            alu_ctrl = rv32i_pkg::AluOp::SRA;
                        } else {
                            alu_ctrl = rv32i_pkg::AluOp::SRL;
                        }
                        rv32i_pkg::Funct3::OR     : alu_ctrl = rv32i_pkg::AluOp::OR;
                        rv32i_pkg::Funct3::AND    : alu_ctrl = rv32i_pkg::AluOp::AND;
                        default                   : alu_ctrl = rv32i_pkg::AluOp::ADD;
                    }
                }
                rv32i_pkg::Opcode::LOAD: {
                    alu_operand_a = rf_rs1_data;
                    alu_operand_b = rv_imm;
                    alu_ctrl      = rv32i_pkg::AluOp::ADD;
                }
                rv32i_pkg::Opcode::STORE: {
                    alu_operand_a = rf_rs1_data;
                    alu_operand_b = rv_imm;
                    alu_ctrl      = rv32i_pkg::AluOp::ADD;
                }
                rv32i_pkg::Opcode::JALR: {
                    alu_operand_a = rf_rs1_data;
                    alu_operand_b = rv_imm;
                    alu_ctrl      = rv32i_pkg::AluOp::ADD;
                }
                rv32i_pkg::Opcode::R_TYPE: {
                    alu_operand_a = rf_rs1_data;
                    alu_operand_b = rf_rs2_data;
                    case rv_f3 {
                        rv32i_pkg::Funct3::ADD_SUB: if rv_funct7[5] {
                            alu_ctrl = rv32i_pkg::AluOp::SUB;
                        } else {
                            alu_ctrl = rv32i_pkg::AluOp::ADD;
                        }
                        rv32i_pkg::Funct3::SLL    : alu_ctrl = rv32i_pkg::AluOp::SLL;
                        rv32i_pkg::Funct3::SLT    : alu_ctrl = rv32i_pkg::AluOp::SLT;
                        rv32i_pkg::Funct3::SLTU   : alu_ctrl = rv32i_pkg::AluOp::SLTU;
                        rv32i_pkg::Funct3::XOR    : alu_ctrl = rv32i_pkg::AluOp::XOR;
                        rv32i_pkg::Funct3::SRL_SRA: if rv_funct7[5] {
                            alu_ctrl = rv32i_pkg::AluOp::SRA;
                        } else {
                            alu_ctrl = rv32i_pkg::AluOp::SRL;
                        }
                        rv32i_pkg::Funct3::OR     : alu_ctrl = rv32i_pkg::AluOp::OR;
                        rv32i_pkg::Funct3::AND    : alu_ctrl = rv32i_pkg::AluOp::AND;
                        default                   : alu_ctrl = rv32i_pkg::AluOp::ADD;
                    }
                }
                rv32i_pkg::Opcode::BRANCH: {
                    alu_operand_a = rf_rs1_data;
                    alu_operand_b = rf_rs2_data;
                    alu_ctrl      = rv32i_pkg::AluOp::SUB;
                }
                default: {
                    alu_operand_a = rf_rs1_data;
                    alu_operand_b = rf_rs2_data;
                    alu_ctrl      = rv32i_pkg::AluOp::ADD;
                }
            }

            // Sub-word Store Steering
            if rv_op == rv32i_pkg::Opcode::STORE {
                case rv_f3 {
                    rv32i_pkg::Funct3::ADD_SUB: { // SB
                        r_data_out = {rf_rs2_data[7:0] repeat 4};
                        case byte_sel {
                            0      : r_mem_byte_we = 4'b0001;
                            1      : r_mem_byte_we = 4'b0010;
                            2      : r_mem_byte_we = 4'b0100;
                            default: r_mem_byte_we = 4'b1000;
                        }
                    }
                    rv32i_pkg::Funct3::SLL: { // SH
                        r_data_out = {rf_rs2_data[15:0] repeat 2};
                        if alu_result[1] == 1'b0 {
                            r_mem_byte_we = 4'b0011;
                        } else {
                            r_mem_byte_we = 4'b1100;
                        }
                    }
                    default: { // SW
                        r_data_out    = rf_rs2_data;
                        r_mem_byte_we = 4'b1111;
                    }
                }
            } else {
                r_data_out    = rf_rs2_data;
                r_mem_byte_we = 4'b1111;
            }

            // Writeback
            case rv_op {
                rv32i_pkg::Opcode::R_TYPE: {
                    rf_we      = if (state == CpuState::EXECUTE) ? 1'b1 : 1'b0;
                    rf_wr_data = alu_result;
                }
                rv32i_pkg::Opcode::I_TYPE: {
                    rf_we      = if (state == CpuState::EXECUTE) ? 1'b1 : 1'b0;
                    rf_wr_data = alu_result;
                }
                rv32i_pkg::Opcode::LUI: {
                    rf_we      = if (state == CpuState::EXECUTE) ? 1'b1 : 1'b0;
                    rf_wr_data = alu_result;
                }
                rv32i_pkg::Opcode::AUIPC: {
                    rf_we      = if (state == CpuState::EXECUTE) ? 1'b1 : 1'b0;
                    rf_wr_data = alu_result;
                }
                rv32i_pkg::Opcode::LOAD: {
                    rf_we      = if (state == CpuState::MEM_WAIT) ? 1'b1 : 1'b0;
                    rf_wr_data = load_val;
                }
                rv32i_pkg::Opcode::JAL: {
                    rf_we      = if (state == CpuState::EXECUTE) ? 1'b1 : 1'b0;
                    rf_wr_data = (pc_reg as u32 + 4) as u32;
                }
                rv32i_pkg::Opcode::JALR: {
                    rf_we      = if (state == CpuState::EXECUTE) ? 1'b1 : 1'b0;
                    rf_wr_data = (pc_reg as u32 + 4) as u32;
                }
                rv32i_pkg::Opcode::SYSTEM: {
                    if rv_funct3 != rv32i_pkg::FUNCT3_PRIV {
                        rf_we      = if (state == CpuState::EXECUTE) ? 1'b1 : 1'b0;
                        rf_wr_data = csr_rdata;
                    } else {
                        rf_we      = 1'b0;
                        rf_wr_data = 32'd0;
                    }
                }
                default: {
                    rf_we      = 1'b0;
                    rf_wr_data = 32'd0;
                }
            }

            r_mem_write = if (rv_op == rv32i_pkg::Opcode::STORE && state == CpuState::EXECUTE) ? 1'b1 : 1'b0;

        } else {
            // Hack Mode
            rf_rs1_addr = h_rs1;
            rf_rs2_addr = h_rs2;
            rf_rd_addr  = 5'd1;
            rf_we       = if h_use_mem ? (if (state == CpuState::MEM_WAIT) ? h_we_reg_a : 1'b0) : (if (state == CpuState::EXECUTE) ? h_we_reg_a : 1'b0);
            rf_wr_data  = alu_result;
            rf_rd2_addr = 5'd2;
            rf_we2      = if h_use_mem ? (if (state == CpuState::MEM_WAIT) ? h_we_reg_d : 1'b0) : (if (state == CpuState::EXECUTE) ? h_we_reg_d : 1'b0);
            rf_wr2_data = alu_result;

            alu_operand_a = rf_rs1_data;
            if h_use_imm {
                alu_operand_b = h_imm;
            } else if h_use_mem {
                alu_operand_b = data_in;
            } else {
                alu_operand_b = rf_rs2_data;
            }

            alu_ctrl      = h_alu_op;
            r_data_out    = alu_result;
            r_mem_byte_we = 4'b1111;
            r_mem_write   = if (state == CpuState::EXECUTE) ? h_we_mem : 1'b0;
        }
    }

    // Next PC Calculation
    always_comb {
        if is_riscv_mode {
            if trap_entry {
                next_pc = mtvec_out;
            } else if is_mret {
                next_pc = mepc_out;
            } else if rv_op == rv32i_pkg::Opcode::JAL {
                next_pc = (pc_reg as u32 + rv_imm as u32) as u32;
            } else if rv_op == rv32i_pkg::Opcode::JALR {
                next_pc = ((rf_rs1_data as u32 + rv_imm as u32) & 32'hffff_fffe) as u32;
            } else if rv_op == rv32i_pkg::Opcode::BRANCH && rv_branch_take {
                next_pc = (pc_reg as u32 + rv_imm as u32) as u32;
            } else {
                next_pc = (pc_reg as u32 + 4) as u32;
            }
        } else {
            if hack_jump_take {
                next_pc = (((rf_rs2_data as u32) << 1) as u32);
            } else {
                next_pc = (pc_reg as u32 + 2) as u32;
            }
        }
    }

    // Multi-Cycle CPU State Machine & PC Update
    always_ff (clk, rst) {
        if_reset {
            state   = CpuState::FETCH;
            pc_reg  = 32'd0;
            ir_reg  = 32'h0000_0013; // NOP
        } else {
            case state {
                CpuState::FETCH: {
                    // Latch fetched instruction from synchronous BRAM
                    ir_reg = instr_in;
                    state  = CpuState::EXECUTE;
                }
                CpuState::EXECUTE: {
                    if is_riscv_mode && rv_op == rv32i_pkg::Opcode::LOAD {
                        // 1 cycle wait for synchronous D-RAM read
                        state = CpuState::MEM_WAIT;
                    } else if !is_riscv_mode && h_use_mem {
                        state = CpuState::MEM_WAIT;
                    } else {
                        pc_reg = next_pc;
                        state  = CpuState::FETCH;
                    }
                }
                CpuState::MEM_WAIT: {
                    pc_reg = next_pc;
                    state  = CpuState::FETCH;
                }
                default: {
                    state = CpuState::FETCH;
                }
            }
        }
    }
}
