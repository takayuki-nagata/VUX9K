# Python
.venv/
__pycache__/
*.pyc

# Unified build output (all generated/build artifacts live here)
build/

# The firmware.hex symlink at the repo root, required because soc_rom.veryl's $readmemh()
# resolves it relative to each tool's process cwd (and the D-RAM preloads' links of older trees)
firmware*.hex

# Veryl toolchain internal cache & fetched dependency sources (not build output)
.build/
dependencies/
Veryl.lock

# Cargo build output (Rust crates keep their own target/ dirs, not consolidated into build/)
target/

# Zephyr out-of-tree app's own nested build outputs (west/CMake convention, not consolidated into build/)
zephyr_workspace/**/build/
zephyr_workspace/**/*.bin

# riscv-tests (+ its env submodule), fetched at a pinned commit on demand by scripts/run_riscv_tests.py
vendor/riscv-tests/

# MicroPython's release tarball and bc_clone_py, unpacked on demand by `make micropython-src`
vendor/micropython-*/
vendor/bc_clone_py/
vendor/bc_clone_py.part/

# Simulation stray artifacts (non-standard names cocotb/Icarus occasionally leave behind)
sim/soc_top
sim/e~*
sim_soc_real
tb_runner

# Stray logs from manual yosys/nextpnr invocations outside the Makefile flow
*.log
*.pretty

# System & temporary files
/tmp/
