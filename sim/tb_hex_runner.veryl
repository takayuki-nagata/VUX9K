// riscv-tests harness: unified_cpu on a flat 256 KB RAM (make test-isa).
//
// Clock, reset, the cycle limit and the PASS/FAIL verdict live in the cocotb test
// scripts/riscv_tests/hex_runner.py, driven by scripts/run_riscv_tests.py; this
// module only holds the parts that are hardware: the memory, the CPU and the
// `tohost` latch.
//
// The program comes from `program.hex` in the simulator's cwd (a bare name, like
// soc_ram's firmware.hex): run_riscv_tests.py links each test's image there, in
// the test's own run directory.
module tb_hex_runner (
    clk: input clock, // active-high edge
    rst: input reset, // active-low, like soc_top's

    halted   : output logic    , // `tohost` has been written; stays set
    halt_code: output logic<32>, // riscv-tests: 1 = PASS, (TESTNUM << 1) | 1 = FAIL
    pc_out   : output logic<32>, // for tracing
    instr_in : output logic<32>, // for tracing
) {
    // riscv-tests `tohost` location (scripts/riscv_tests/link.ld). Kept outside the
    // RAM window so it can never collide with test code/data.
    const TOHOST_ADDR: logic<32> = 32'hF000_0000;
    const RAM_WORDS  : u32       = 65536; // 256 KB

    var data_in    : logic<32>;
    var data_addr  : logic<32>;
    var data_waddr : logic<32>;
    var data_out   : logic<32>;
    var mem_write  : logic    ;
    var mem_byte_we: logic<4> ;

    #[allow(initial_assign)]
    var ram: logic<32> [RAM_WORDS];

    // Only the program image is loaded; the rest of the RAM stays X, so a test that
    // strays outside its image fails loudly. Don't fill it (a loop here, or padding
    // program.hex): it would also hide reads of memory the test never wrote.
    initial {
        $readmemh("program.hex", ram);
    }

    inst uut: unified_cpu (
        clk                   ,
        rst                   ,
        soft_rst       : 1'b0 ,
        boot_mode_valid: 1'b0 ,
        boot_mode      : 1'b0 ,
        instr_in              ,
        data_in               ,
        timer_irq_in   : 1'b0 ,
        ext_irq_in     : 1'b0 ,
        sw_irq_in      : 1'b0 ,
        mtime_in       : 64'd0,
        pc_out                ,
        data_addr             ,
        data_waddr            ,
        data_out              ,
        mem_write             ,
        mem_read_req   : _    ,
        mem_byte_we           ,
        active_mode    : _    ,
    );

    // The bus timing of soc_ram (the real SoC): both ports read synchronously, one
    // cycle after the CPU presents the address, and a read sees the RAM before a write
    // on the same edge. pc_out is next_pc outside FETCH, so this checks that the CPU
    // asks for the right instruction a cycle early, which a combinational read would
    // not. Stores use data_waddr, as soc_top does. Word-aligned; addresses wrap at 256 KB.
    var instr_q: logic<32>;
    var data_q : logic<32>;
    assign instr_in = instr_q;
    assign data_in  = data_q;

    always_ff (clk) {
        instr_q = ram[pc_out[17:2]];
        data_q  = ram[data_addr[17:2]];
        // Data memory write (RAM window only; MMIO addresses must not alias into RAM)
        if rst && mem_write && data_waddr[31:18] == 14'd0 {
            for b in 0..4 {
                if mem_byte_we[b] {
                    ram[data_waddr[17:2]][b * 8+:8] = data_out[b * 8+:8];
                }
            }
        }
    }

    // A tohost write ends the test (the cocotb side reads the verdict)
    always_ff (clk, rst) {
        if_reset {
            halted    = 1'b0;
            halt_code = 32'h0;
        } else if mem_write && !halted && data_waddr == TOHOST_ADDR {
            halted    = 1'b1;
            halt_code = data_out;
        }
    }
}
