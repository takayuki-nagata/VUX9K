// High-Speed Hex Runner Testbench for RISC-V Architectural Compliance in Veryl
//
// The body stays embedded SystemVerilog on purpose: it is a behavioral testbench
// (`#` delays, `string`, $value$plusargs, event-controlled loops) run by Icarus
// only, never synthesized, and those constructs have no Veryl equivalent. The RTL
// itself has no embedded SV left.
pub module tb_hex_runner () {
    embed (inline) sv{{{
        logic clk = 0;
        logic rst = 1;
        logic [31:0] instr_in;
        logic [31:0] data_in;
        logic [31:0] pc_out;
        logic [31:0] data_addr;
        logic [31:0] data_out;
        logic mem_write;
        logic [3:0] mem_byte_we;
        logic active_mode;

        // 256KB RAM (65536 x 32-bit words)
        logic [31:0] ram [0:65535];

        // Instantiate Unified Dual-ISA CPU Core (Veryl compiled)
        unified_cpu uut (
            .clk(clk),
            .rst(rst),
            .soft_rst(1'b0),
            .instr_in(instr_in),
            .data_in(data_in),
            .timer_irq_in(1'b0),
            .ext_irq_in(1'b0),
            .sw_irq_in(1'b0),
            .pc_out(pc_out),
            .data_addr(data_addr),
            .data_out(data_out),
            .mem_write(mem_write),
            .mem_byte_we(mem_byte_we),
            .active_mode(active_mode)
        );

        // Clock generator (50MHz)
        always #10 clk = ~clk;

        // riscv-tests `tohost` location (scripts/riscv_tests/link.ld). Kept
        // outside the RAM window so it can never collide with test code/data.
        // The test writes 1 on PASS, or (failing TESTNUM << 1) | 1 on FAIL.
        localparam logic [31:0] TOHOST_ADDR = 32'hF000_0000;

        string hex_file;
        integer cycle_count = 0;
        integer max_cycles = 2000000;
        logic trace = 0;
        logic halted = 0;
        logic [31:0] halt_code = 0;
        wire is_ram_addr = (data_addr[31:18] == 14'd0);

        initial begin
            for (int i = 0; i < 65536; i++) begin
                ram[i] = 32'h00000013; // NOP (addi x0, x0, 0)
            end

            if ($value$plusargs("HEX_FILE=%s", hex_file)) begin
                $readmemh(hex_file, ram);
            end
            void'($value$plusargs("MAX_CYCLES=%d", max_cycles));
            trace = $test$plusargs("TRACE");

            // Reset sequence (Active-low reset: 1 -> 0 -> 1)
            rst = 1;
            #5;
            rst = 0;
            #30;
            @(negedge clk);
            rst = 1;

            // Run simulation
            while (cycle_count < max_cycles) begin
                @(negedge clk);
                cycle_count++;
                if (trace) $display("[TRACE] %0d PC=%08h INSTR=%08h", cycle_count, pc_out, instr_in);

                if (halted) begin
                    if (halt_code == 32'd1) begin
                        $display("[PASS] tohost=1 at cycle %0d", cycle_count);
                        $finish(0);
                    end
                    $display("[FAIL] tohost=0x%08h (TESTNUM=%0d) at cycle %0d", halt_code, halt_code >> 1, cycle_count);
                    $finish(1);
                end
            end

            $display("[FAIL] Simulation timeout after %0d cycles at PC=%08h", max_cycles, pc_out);
            $finish(1);
        end

        // Instruction memory read (word-aligned from PC)
        assign instr_in = (pc_out[17:2] < 65536) ? ram[pc_out[17:2]] : 32'h00000013;

        // Data memory read (word-aligned)
        assign data_in  = (data_addr[17:2] < 65536) ? ram[data_addr[17:2]] : 32'h00000000;

        // tohost write ends the test
        always_ff @(posedge clk) begin
            if (rst && mem_write && !halted && data_addr == TOHOST_ADDR) begin
                halted    <= 1'b1;
                halt_code <= data_out;
            end
        end

        // Data memory write (RAM window only; MMIO addresses must not alias into RAM)
        always_ff @(posedge clk) begin
            if (rst && mem_write && is_ram_addr) begin
                if (mem_byte_we[0]) ram[data_addr[17:2]][7:0]   <= data_out[7:0];
                if (mem_byte_we[1]) ram[data_addr[17:2]][15:8]  <= data_out[15:8];
                if (mem_byte_we[2]) ram[data_addr[17:2]][23:16] <= data_out[23:16];
                if (mem_byte_we[3]) ram[data_addr[17:2]][31:24] <= data_out[31:24];
            end
        end
    }}}
}
