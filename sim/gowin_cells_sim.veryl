// Simulation models of the Gowin GW1N primitives that synth_gowin's netlists
// instantiate, for gate-level simulation (sim/runners/sim_runner.py): LUTs,
// wide-LUT muxes, ALU, flip-flops, buffers, distributed RAM (RAM16SDP4) and block
// RAMs (DPB, SPX9, SP, SDPB). Module, port and parameter names must match the cells
// synth_gowin emits, which is why they break Veryl's usual naming. Flip-flops power
// up to their GSR value (initial blocks). Simulation only: nothing here is synthesized.
//
// Why not Yosys' own models: in share/yosys/gowin/, cells_sim.v has the LUT/FF/ALU/
// RAM16SDP4/SP/SPX9 cells, but cells_xtra_gw1n.v declares DPB and SDPB as port-only
// stubs, so a GLS netlist using block RAM wouldn't simulate. These models add
// behavior (INIT_RAM_* preload, per-width addressing, READ_MODE/WRITE_MODE,
// BLK_SEL) that runs standalone on Icarus and Verilator.
//
// Sources (2026-08): port and parameter names, and the models above, follow
// Yosys' cells_sim.v and cells_xtra_gw1n.v, checked against the instances in
// synth_gowin's soc_syn.v; BSRAM behavior follows Project Apicula's docs
// (doc/bsram-fix.md, doc/architecture.md). Converted from the original
// sim/gowin_cells_sim.v to Veryl in 2026-09; every cell was proven equivalent to
// that model with Yosys (equiv_* for the small cells, an everted-register miter
// for the block RAMs) before it was removed.

// LUTs: F = INIT[{I(n-1), ..., I0}]

module LUT1 #(
    param INIT: bit<2> = 2'h0,
) (
    F : output logic,
    I0: input  logic,
) {
    assign F = if I0 ? INIT[1] : INIT[0];
}

module LUT2 #(
    param INIT: bit<4> = 4'h0,
) (
    F : output logic,
    I0: input  logic,
    I1: input  logic,
) {
    let s1: logic<2> = if I1 ? INIT[3:2] : INIT[1:0];
    assign F = if I0 ? s1[1] : s1[0];
}

module LUT3 #(
    param INIT: bit<8> = 8'h0,
) (
    F : output logic,
    I0: input  logic,
    I1: input  logic,
    I2: input  logic,
) {
    let s2: logic<4> = if I2 ? INIT[7:4] : INIT[3:0];
    let s1: logic<2> = if I1 ? s2[3:2] : s2[1:0];
    assign F = if I0 ? s1[1] : s1[0];
}

module LUT4 #(
    param INIT: bit<16> = 16'h0,
) (
    F : output logic,
    I0: input  logic,
    I1: input  logic,
    I2: input  logic,
    I3: input  logic,
) {
    let s3: logic<8> = if I3 ? INIT[15:8] : INIT[7:0];
    let s2: logic<4> = if I2 ? s3[7:4] : s3[3:0];
    let s1: logic<2> = if I1 ? s2[3:2] : s2[1:0];
    assign F = if I0 ? s1[1] : s1[0];
}

module LUT5 #(
    param INIT: bit<32> = 32'h0,
) (
    I0: input  logic,
    I1: input  logic,
    I2: input  logic,
    I3: input  logic,
    I4: input  logic,
    F : output logic,
) {
    let s4: logic<16> = if I4 ? INIT[31:16] : INIT[15:0];
    let s3: logic<8>  = if I3 ? s4[15:8] : s4[7:0];
    let s2: logic<4>  = if I2 ? s3[7:4] : s3[3:0];
    let s1: logic<2>  = if I1 ? s2[3:2] : s2[1:0];
    assign F = if I0 ? s1[1] : s1[0];
}

module LUT6 #(
    param INIT: bit<64> = 64'h0,
) (
    I0: input  logic,
    I1: input  logic,
    I2: input  logic,
    I3: input  logic,
    I4: input  logic,
    I5: input  logic,
    F : output logic,
) {
    let s5: logic<32> = if I5 ? INIT[63:32] : INIT[31:0];
    let s4: logic<16> = if I4 ? s5[31:16] : s5[15:0];
    let s3: logic<8>  = if I3 ? s4[15:8] : s4[7:0];
    let s2: logic<4>  = if I2 ? s3[7:4] : s3[3:0];
    let s1: logic<2>  = if I1 ? s2[3:2] : s2[1:0];
    assign F = if I0 ? s1[1] : s1[0];
}

module LUT7 #(
    param INIT: bit<128> = 128'h0,
) (
    I0: input  logic,
    I1: input  logic,
    I2: input  logic,
    I3: input  logic,
    I4: input  logic,
    I5: input  logic,
    I6: input  logic,
    F : output logic,
) {
    let s6: logic<64> = if I6 ? INIT[127:64] : INIT[63:0];
    let s5: logic<32> = if I5 ? s6[63:32] : s6[31:0];
    let s4: logic<16> = if I4 ? s5[31:16] : s5[15:0];
    let s3: logic<8>  = if I3 ? s4[15:8] : s4[7:0];
    let s2: logic<4>  = if I2 ? s3[7:4] : s3[3:0];
    let s1: logic<2>  = if I1 ? s2[3:2] : s2[1:0];
    assign F = if I0 ? s1[1] : s1[0];
}

module LUT8 #(
    param INIT: bit<256> = 256'h0,
) (
    I0: input  logic,
    I1: input  logic,
    I2: input  logic,
    I3: input  logic,
    I4: input  logic,
    I5: input  logic,
    I6: input  logic,
    I7: input  logic,
    F : output logic,
) {
    let s7: logic<128> = if I7 ? INIT[255:128] : INIT[127:0];
    let s6: logic<64>  = if I6 ? s7[127:64] : s7[63:0];
    let s5: logic<32>  = if I5 ? s6[63:32] : s6[31:0];
    let s4: logic<16>  = if I4 ? s5[31:16] : s5[15:0];
    let s3: logic<8>   = if I3 ? s4[15:8] : s4[7:0];
    let s2: logic<4>   = if I2 ? s3[7:4] : s3[3:0];
    let s1: logic<2>   = if I1 ? s2[3:2] : s2[1:0];
    assign F = if I0 ? s1[1] : s1[0];
}

// Wide-LUT muxes and plain 2:1 mux

module MUX2 (
    O : output logic,
    I0: input  logic,
    I1: input  logic,
    S0: input  logic,
) {
    assign O = if S0 ? I1 : I0;
}

module MUX2_LUT5 (
    O : output logic,
    I0: input  logic,
    I1: input  logic,
    S0: input  logic,
) {
    assign O = if S0 ? I1 : I0;
}

module MUX2_LUT6 (
    O : output logic,
    I0: input  logic,
    I1: input  logic,
    S0: input  logic,
) {
    assign O = if S0 ? I1 : I0;
}

module MUX2_LUT7 (
    O : output logic,
    I0: input  logic,
    I1: input  logic,
    S0: input  logic,
) {
    assign O = if S0 ? I1 : I0;
}

module MUX2_LUT8 (
    O : output logic,
    I0: input  logic,
    I1: input  logic,
    S0: input  logic,
) {
    assign O = if S0 ? I1 : I0;
}

module INV (
    I: input  logic,
    O: output logic,
) {
    assign O = ~I;
}

// Gowin arithmetic slice: SUM/COUT of one carry-chain bit, function set by ALU_MODE
module ALU #(
    param ALU_MODE: i32 = 0,
) (
    SUM : output logic,
    COUT: output logic,
    I0  : input  logic,
    I1  : input  logic,
    I3  : input  logic,
    CIN : input  logic,
) {
    const ADD   : i32 = 0;
    const SUB   : i32 = 1;
    const ADDSUB: i32 = 2;
    const NE    : i32 = 3;
    const GE    : i32 = 4;
    const LE    : i32 = 5;
    const CUP   : i32 = 6;
    const CDN   : i32 = 7;
    const CUPCDN: i32 = 8;
    const MULT  : i32 = 9;

    var s: logic;
    var c: logic;
    always_comb {
        switch {
            ALU_MODE == ADD   : s = I0 ^ I1;
            ALU_MODE == SUB   : s = I0 ^ ~I1;
            ALU_MODE == ADDSUB: s = if I3 ? (I0 ^ I1) : (I0 ^ ~I1);
            ALU_MODE == NE    : s = I0 ^ ~I1;
            ALU_MODE == GE    : s = I0 ^ ~I1;
            ALU_MODE == LE    : s = ~I0 ^ I1;
            ALU_MODE == CUP   : s = I0;
            ALU_MODE == CDN   : s = ~I0;
            ALU_MODE == CUPCDN: s = if I3 ? I0 : ~I0;
            ALU_MODE == MULT  : s = (I0 & I1) ^ I3;
            default           : s = I0 ^ I1;
        }
        switch {
            ALU_MODE == ADD   : c = I0;
            ALU_MODE == SUB   : c = I0;
            ALU_MODE == ADDSUB: c = I0;
            ALU_MODE == NE    : c = 1'b1;
            ALU_MODE == GE    : c = I0;
            ALU_MODE == LE    : c = I1;
            ALU_MODE == CUP   : c = 1'b0;
            ALU_MODE == CDN   : c = 1'b1;
            ALU_MODE == CUPCDN: c = I0;
            ALU_MODE == MULT  : c = I0 & I1;
            default           : c = I0;
        }
    }
    assign SUM  = s ^ CIN;
    assign COUT = if s ? CIN : c;
}

module DFF (
    Q  : output logic,
    CLK: input  clock,
    D  : input  logic,
) {
    #[allow(initial_assign)]
    var q: logic;
    initial {
        q = 1'b0;
    }
    always_ff (CLK) {
        q = D;
    }
    assign Q = q;
}

module DFFE (
    Q  : output logic,
    D  : input  logic,
    CLK: input  clock,
    CE : input  logic,
) {
    #[allow(initial_assign)]
    var q: logic;
    initial {
        q = 1'b0;
    }
    always_ff (CLK) {
        if CE {
            q = D;
        }
    }
    assign Q = q;
}

module DFFS (
    Q  : output logic,
    D  : input  logic,
    CLK: input  clock,
    SET: input  logic,
) {
    #[allow(initial_assign)]
    var q: logic;
    initial {
        q = 1'b0;
    }
    always_ff (CLK) {
        if SET {
            q = 1'b1;
        } else {
            q = D;
        }
    }
    assign Q = q;
}

module DFFSE (
    Q  : output logic,
    D  : input  logic,
    CLK: input  clock,
    CE : input  logic,
    SET: input  logic,
) {
    #[allow(initial_assign)]
    var q: logic;
    initial {
        q = 1'b0;
    }
    always_ff (CLK) {
        if SET {
            q = 1'b1;
        } else {
            if CE {
                q = D;
            }
        }
    }
    assign Q = q;
}

module DFFR (
    Q    : output logic,
    D    : input  logic,
    CLK  : input  clock,
    RESET: input  logic,
) {
    #[allow(initial_assign)]
    var q: logic;
    initial {
        q = 1'b0;
    }
    always_ff (CLK) {
        if RESET {
            q = 1'b0;
        } else {
            q = D;
        }
    }
    assign Q = q;
}

module DFFRE (
    Q    : output logic,
    D    : input  logic,
    CLK  : input  clock,
    CE   : input  logic,
    RESET: input  logic,
) {
    #[allow(initial_assign)]
    var q: logic;
    initial {
        q = 1'b0;
    }
    always_ff (CLK) {
        if RESET {
            q = 1'b0;
        } else {
            if CE {
                q = D;
            }
        }
    }
    assign Q = q;
}

module DFFP (
    Q     : output logic           ,
    D     : input  logic           ,
    CLK   : input  clock           ,
    PRESET: input  reset_async_high,
) {
    #[allow(initial_assign)]
    var q: logic;
    initial {
        q = 1'b1;
    }
    always_ff (CLK, PRESET) {
        if_reset {
            q = 1'b1;
        } else {
            q = D;
        }
    }
    assign Q = q;
}

module DFFPE (
    Q     : output logic           ,
    D     : input  logic           ,
    CLK   : input  clock           ,
    CE    : input  logic           ,
    PRESET: input  reset_async_high,
) {
    #[allow(initial_assign)]
    var q: logic;
    initial {
        q = 1'b1;
    }
    always_ff (CLK, PRESET) {
        if_reset {
            q = 1'b1;
        } else {
            if CE {
                q = D;
            }
        }
    }
    assign Q = q;
}

module DFFC (
    Q    : output logic           ,
    D    : input  logic           ,
    CLK  : input  clock           ,
    CLEAR: input  reset_async_high,
) {
    #[allow(initial_assign)]
    var q: logic;
    initial {
        q = 1'b0;
    }
    always_ff (CLK, CLEAR) {
        if_reset {
            q = 1'b0;
        } else {
            q = D;
        }
    }
    assign Q = q;
}

module DFFCE (
    Q    : output logic           ,
    D    : input  logic           ,
    CLK  : input  clock           ,
    CE   : input  logic           ,
    CLEAR: input  reset_async_high,
) {
    #[allow(initial_assign)]
    var q: logic;
    initial {
        q = 1'b0;
    }
    always_ff (CLK, CLEAR) {
        if_reset {
            q = 1'b0;
        } else {
            if CE {
                q = D;
            }
        }
    }
    assign Q = q;
}

module VCC (
    V: output logic,
) {
    assign V = 1'b1;
}

module GND (
    G: output logic,
) {
    assign G = 1'b0;
}

module IBUF (
    O: output logic,
    I: input  logic,
) {
    assign O = I;
}

module OBUF (
    O: output logic,
    I: input  logic,
) {
    assign O = I;
}

module TBUF (
    O  : output logic,
    I  : input  logic,
    OEN: input  logic,
) {
    assign O = if OEN ? 1'bz : I;
}

module IOBUF (
    O  : output logic    ,
    IO : inout  tri logic,
    I  : input  logic    ,
    OEN: input  logic    ,
) {
    assign O  = IO;
    assign IO = if OEN ? 1'bz : I;
}

module GSR (
    GSRI: input logic,
) {}

// Distributed RAM: 16 x 4 bits, asynchronous read, synchronous write
module RAM16SDP4 #(
    param INIT_0: bit<16> = 16'h0000,
    param INIT_1: bit<16> = 16'h0000,
    param INIT_2: bit<16> = 16'h0000,
    param INIT_3: bit<16> = 16'h0000,
) (
    DO : output logic<4>,
    DI : input  logic<4>,
    WAD: input  logic<4>,
    RAD: input  logic<4>,
    WRE: input  logic   ,
    CLK: input  clock   ,
) {
    #[allow(initial_assign)]
    var mem0: logic<16>;
    #[allow(initial_assign)]
    var mem1: logic<16>;
    #[allow(initial_assign)]
    var mem2: logic<16>;
    #[allow(initial_assign)]
    var mem3: logic<16>;

    initial {
        mem0 = INIT_0;
        mem1 = INIT_1;
        mem2 = INIT_2;
        mem3 = INIT_3;
    }

    assign DO[0] = mem0[RAD];
    assign DO[1] = mem1[RAD];
    assign DO[2] = mem2[RAD];
    assign DO[3] = mem3[RAD];

    always_ff (CLK) {
        if WRE {
            mem0[WAD] = DI[0];
            mem1[WAD] = DI[1];
            mem2[WAD] = DI[2];
            mem3[WAD] = DI[3];
        }
    }
}

// Dual-port block RAM, 16 Kbit, per-port width BIT_WIDTH_0/1
module DPB #(
    param READ_MODE0 : bit      = 1'b0            ,
    param READ_MODE1 : bit      = 1'b0            ,
    param WRITE_MODE0: bit<2>   = 2'b00           ,
    param WRITE_MODE1: bit<2>   = 2'b00           ,
    param BIT_WIDTH_0: i32      = 16              ,
    param BIT_WIDTH_1: i32      = 16              ,
    param BLK_SEL_0  : bit<3>   = 3'b000          ,
    param BLK_SEL_1  : bit<3>   = 3'b000          ,
    param RESET_MODE : bit<40>  = 40'h00_5359_4E43, // "SYNC" (or "ASYNC") as ASCII; unused. Not a string: Yosys cannot read string params
    param INIT_RAM_00: bit<256> = 256'h0          ,
    param INIT_RAM_01: bit<256> = 256'h0          ,
    param INIT_RAM_02: bit<256> = 256'h0          ,
    param INIT_RAM_03: bit<256> = 256'h0          ,
    param INIT_RAM_04: bit<256> = 256'h0          ,
    param INIT_RAM_05: bit<256> = 256'h0          ,
    param INIT_RAM_06: bit<256> = 256'h0          ,
    param INIT_RAM_07: bit<256> = 256'h0          ,
    param INIT_RAM_08: bit<256> = 256'h0          ,
    param INIT_RAM_09: bit<256> = 256'h0          ,
    param INIT_RAM_0A: bit<256> = 256'h0          ,
    param INIT_RAM_0B: bit<256> = 256'h0          ,
    param INIT_RAM_0C: bit<256> = 256'h0          ,
    param INIT_RAM_0D: bit<256> = 256'h0          ,
    param INIT_RAM_0E: bit<256> = 256'h0          ,
    param INIT_RAM_0F: bit<256> = 256'h0          ,
    param INIT_RAM_10: bit<256> = 256'h0          ,
    param INIT_RAM_11: bit<256> = 256'h0          ,
    param INIT_RAM_12: bit<256> = 256'h0          ,
    param INIT_RAM_13: bit<256> = 256'h0          ,
    param INIT_RAM_14: bit<256> = 256'h0          ,
    param INIT_RAM_15: bit<256> = 256'h0          ,
    param INIT_RAM_16: bit<256> = 256'h0          ,
    param INIT_RAM_17: bit<256> = 256'h0          ,
    param INIT_RAM_18: bit<256> = 256'h0          ,
    param INIT_RAM_19: bit<256> = 256'h0          ,
    param INIT_RAM_1A: bit<256> = 256'h0          ,
    param INIT_RAM_1B: bit<256> = 256'h0          ,
    param INIT_RAM_1C: bit<256> = 256'h0          ,
    param INIT_RAM_1D: bit<256> = 256'h0          ,
    param INIT_RAM_1E: bit<256> = 256'h0          ,
    param INIT_RAM_1F: bit<256> = 256'h0          ,
    param INIT_RAM_20: bit<256> = 256'h0          ,
    param INIT_RAM_21: bit<256> = 256'h0          ,
    param INIT_RAM_22: bit<256> = 256'h0          ,
    param INIT_RAM_23: bit<256> = 256'h0          ,
    param INIT_RAM_24: bit<256> = 256'h0          ,
    param INIT_RAM_25: bit<256> = 256'h0          ,
    param INIT_RAM_26: bit<256> = 256'h0          ,
    param INIT_RAM_27: bit<256> = 256'h0          ,
    param INIT_RAM_28: bit<256> = 256'h0          ,
    param INIT_RAM_29: bit<256> = 256'h0          ,
    param INIT_RAM_2A: bit<256> = 256'h0          ,
    param INIT_RAM_2B: bit<256> = 256'h0          ,
    param INIT_RAM_2C: bit<256> = 256'h0          ,
    param INIT_RAM_2D: bit<256> = 256'h0          ,
    param INIT_RAM_2E: bit<256> = 256'h0          ,
    param INIT_RAM_2F: bit<256> = 256'h0          ,
    param INIT_RAM_30: bit<256> = 256'h0          ,
    param INIT_RAM_31: bit<256> = 256'h0          ,
    param INIT_RAM_32: bit<256> = 256'h0          ,
    param INIT_RAM_33: bit<256> = 256'h0          ,
    param INIT_RAM_34: bit<256> = 256'h0          ,
    param INIT_RAM_35: bit<256> = 256'h0          ,
    param INIT_RAM_36: bit<256> = 256'h0          ,
    param INIT_RAM_37: bit<256> = 256'h0          ,
    param INIT_RAM_38: bit<256> = 256'h0          ,
    param INIT_RAM_39: bit<256> = 256'h0          ,
    param INIT_RAM_3A: bit<256> = 256'h0          ,
    param INIT_RAM_3B: bit<256> = 256'h0          ,
    param INIT_RAM_3C: bit<256> = 256'h0          ,
    param INIT_RAM_3D: bit<256> = 256'h0          ,
    param INIT_RAM_3E: bit<256> = 256'h0          ,
    param INIT_RAM_3F: bit<256> = 256'h0          ,
) (
    CLKA   : input  'a clock    ,
    CEA    : input  'a logic    ,
    CLKB   : input  'b clock    ,
    CEB    : input  'b logic    ,
    OCEA   : input  'a logic    ,
    OCEB   : input  'b logic    ,
    RESETA : input  'a logic    ,
    RESETB : input  'b logic    ,
    WREA   : input  'a logic    ,
    WREB   : input  'b logic    ,
    ADA    : input  'a logic<14>,
    ADB    : input  'b logic<14>,
    BLKSELA: input  'a logic<3> ,
    BLKSELB: input  'b logic<3> ,
    DIA    : input  'a logic<16>,
    DIB    : input  'b logic<16>,
    DOA    : output 'a logic<16>,
    DOB    : output 'b logic<16>,
) {
    // Written by both ports (each from its own clock), like the hardware's two write ports
    #[allow(initial_assign)]
    #[allow(multiple_assign)]
    var mem_bits: logic<16384>;
    #[allow(initial_assign)]
    var raw_doa: logic<16>;
    #[allow(initial_assign)]
    var raw_dob: logic<16>;
    #[allow(initial_assign)]
    var pipe_doa: logic<16>;
    #[allow(initial_assign)]
    var pipe_dob: logic<16>;

    // The outputs read 0 until the first access (the SV model set DOA/DOB = 0)
    initial {
        mem_bits[0 * 256+:256]  = INIT_RAM_00;
        mem_bits[1 * 256+:256]  = INIT_RAM_01;
        mem_bits[2 * 256+:256]  = INIT_RAM_02;
        mem_bits[3 * 256+:256]  = INIT_RAM_03;
        mem_bits[4 * 256+:256]  = INIT_RAM_04;
        mem_bits[5 * 256+:256]  = INIT_RAM_05;
        mem_bits[6 * 256+:256]  = INIT_RAM_06;
        mem_bits[7 * 256+:256]  = INIT_RAM_07;
        mem_bits[8 * 256+:256]  = INIT_RAM_08;
        mem_bits[9 * 256+:256]  = INIT_RAM_09;
        mem_bits[10 * 256+:256] = INIT_RAM_0A;
        mem_bits[11 * 256+:256] = INIT_RAM_0B;
        mem_bits[12 * 256+:256] = INIT_RAM_0C;
        mem_bits[13 * 256+:256] = INIT_RAM_0D;
        mem_bits[14 * 256+:256] = INIT_RAM_0E;
        mem_bits[15 * 256+:256] = INIT_RAM_0F;
        mem_bits[16 * 256+:256] = INIT_RAM_10;
        mem_bits[17 * 256+:256] = INIT_RAM_11;
        mem_bits[18 * 256+:256] = INIT_RAM_12;
        mem_bits[19 * 256+:256] = INIT_RAM_13;
        mem_bits[20 * 256+:256] = INIT_RAM_14;
        mem_bits[21 * 256+:256] = INIT_RAM_15;
        mem_bits[22 * 256+:256] = INIT_RAM_16;
        mem_bits[23 * 256+:256] = INIT_RAM_17;
        mem_bits[24 * 256+:256] = INIT_RAM_18;
        mem_bits[25 * 256+:256] = INIT_RAM_19;
        mem_bits[26 * 256+:256] = INIT_RAM_1A;
        mem_bits[27 * 256+:256] = INIT_RAM_1B;
        mem_bits[28 * 256+:256] = INIT_RAM_1C;
        mem_bits[29 * 256+:256] = INIT_RAM_1D;
        mem_bits[30 * 256+:256] = INIT_RAM_1E;
        mem_bits[31 * 256+:256] = INIT_RAM_1F;
        mem_bits[32 * 256+:256] = INIT_RAM_20;
        mem_bits[33 * 256+:256] = INIT_RAM_21;
        mem_bits[34 * 256+:256] = INIT_RAM_22;
        mem_bits[35 * 256+:256] = INIT_RAM_23;
        mem_bits[36 * 256+:256] = INIT_RAM_24;
        mem_bits[37 * 256+:256] = INIT_RAM_25;
        mem_bits[38 * 256+:256] = INIT_RAM_26;
        mem_bits[39 * 256+:256] = INIT_RAM_27;
        mem_bits[40 * 256+:256] = INIT_RAM_28;
        mem_bits[41 * 256+:256] = INIT_RAM_29;
        mem_bits[42 * 256+:256] = INIT_RAM_2A;
        mem_bits[43 * 256+:256] = INIT_RAM_2B;
        mem_bits[44 * 256+:256] = INIT_RAM_2C;
        mem_bits[45 * 256+:256] = INIT_RAM_2D;
        mem_bits[46 * 256+:256] = INIT_RAM_2E;
        mem_bits[47 * 256+:256] = INIT_RAM_2F;
        mem_bits[48 * 256+:256] = INIT_RAM_30;
        mem_bits[49 * 256+:256] = INIT_RAM_31;
        mem_bits[50 * 256+:256] = INIT_RAM_32;
        mem_bits[51 * 256+:256] = INIT_RAM_33;
        mem_bits[52 * 256+:256] = INIT_RAM_34;
        mem_bits[53 * 256+:256] = INIT_RAM_35;
        mem_bits[54 * 256+:256] = INIT_RAM_36;
        mem_bits[55 * 256+:256] = INIT_RAM_37;
        mem_bits[56 * 256+:256] = INIT_RAM_38;
        mem_bits[57 * 256+:256] = INIT_RAM_39;
        mem_bits[58 * 256+:256] = INIT_RAM_3A;
        mem_bits[59 * 256+:256] = INIT_RAM_3B;
        mem_bits[60 * 256+:256] = INIT_RAM_3C;
        mem_bits[61 * 256+:256] = INIT_RAM_3D;
        mem_bits[62 * 256+:256] = INIT_RAM_3E;
        mem_bits[63 * 256+:256] = INIT_RAM_3F;
        raw_doa                 = 16'h0;
        raw_dob                 = 16'h0;
        pipe_doa                = 16'h0;
        pipe_dob                = 16'h0;
    }

    // Both ports read and write the same storage from their own clocks: a true
    // dual-port RAM crosses clock domains by construction.
    unsafe (cdc) {
        // BLK_SEL_x == 0 matches any BLKSELx: a simplification (Gowin selects on an exact
        // match), invisible to synth_gowin's netlists, which tie both to 0
        let blksel_a_match: logic = BLKSELA == BLK_SEL_0 || BLK_SEL_0 == 3'b000;
        let blksel_b_match: logic = BLKSELB == BLK_SEL_1 || BLK_SEL_1 == 3'b000;

        // Bit offset of the addressed word for the configured port width
        var off_a: logic<32>;
        var off_b: logic<32>;
        always_comb {
            case BIT_WIDTH_0 {
                1      : off_a = ADA[13:0] * 1;
                2      : off_a = ADA[13:1] * 2;
                4      : off_a = ADA[13:2] * 4;
                8      : off_a = ADA[13:3] * 8;
                9      : off_a = ADA[13:3] * 9;
                16     : off_a = ADA[13:4] * 16;
                18     : off_a = ADA[13:4] * 18;
                32     : off_a = ADA[13:5] * 32;
                36     : off_a = ADA[13:5] * 36;
                default: off_a = ADA[13:4] * 16;
            }
            case BIT_WIDTH_1 {
                1      : off_b = ADB[13:0] * 1;
                2      : off_b = ADB[13:1] * 2;
                4      : off_b = ADB[13:2] * 4;
                8      : off_b = ADB[13:3] * 8;
                9      : off_b = ADB[13:3] * 9;
                16     : off_b = ADB[13:4] * 16;
                18     : off_b = ADB[13:4] * 18;
                32     : off_b = ADB[13:5] * 32;
                36     : off_b = ADB[13:5] * 36;
                default: off_b = ADB[13:4] * 16;
            }
        }

        // Port A
        always_ff (CLKA) {
            if CEA && blksel_a_match {
                if WREA {
                    for i in 0..BIT_WIDTH_0 {
                        mem_bits[off_a + i] = DIA[i];
                    }
                    if WRITE_MODE0 == 2'b01 {
                        raw_doa = DIA;
                    } else if WRITE_MODE0 == 2'b10 {
                        raw_doa = mem_bits[off_a+:16];
                    }
                } else {
                    raw_doa = mem_bits[off_a+:16];
                }
            }
        }

        // Port B
        always_ff (CLKB) {
            if CEB && blksel_b_match {
                if WREB {
                    for i in 0..BIT_WIDTH_1 {
                        mem_bits[off_b + i] = DIB[i];
                    }
                    if WRITE_MODE1 == 2'b01 {
                        raw_dob = DIB;
                    } else if WRITE_MODE1 == 2'b10 {
                        raw_dob = mem_bits[off_b+:16];
                    }
                } else {
                    raw_dob = mem_bits[off_b+:16];
                }
            }
        }

        // Optional output pipeline registers
        always_ff (CLKA) {
            if RESETA {
                pipe_doa = 16'h0;
            } else if OCEA {
                pipe_doa = raw_doa;
            }
        }
        always_ff (CLKB) {
            if RESETB {
                pipe_dob = 16'h0;
            } else if OCEB {
                pipe_dob = raw_dob;
            }
        }

        assign DOA = if READ_MODE0 == 1'b1 ? pipe_doa : raw_doa;
        assign DOB = if READ_MODE1 == 1'b1 ? pipe_dob : raw_dob;
    }
}

// Single-port block RAM, 18 Kbit (x9/x18/x36)
module SPX9 #(
    param READ_MODE  : bit      = 1'b0            ,
    param WRITE_MODE : bit<2>   = 2'b00           ,
    param BIT_WIDTH  : i32      = 36              ,
    param BLK_SEL    : bit<3>   = 3'b000          ,
    param RESET_MODE : bit<40>  = 40'h00_5359_4E43, // "SYNC" (or "ASYNC") as ASCII; unused. Not a string: Yosys cannot read string params
    param INIT_RAM_00: bit<288> = 288'h0          ,
    param INIT_RAM_01: bit<288> = 288'h0          ,
    param INIT_RAM_02: bit<288> = 288'h0          ,
    param INIT_RAM_03: bit<288> = 288'h0          ,
    param INIT_RAM_04: bit<288> = 288'h0          ,
    param INIT_RAM_05: bit<288> = 288'h0          ,
    param INIT_RAM_06: bit<288> = 288'h0          ,
    param INIT_RAM_07: bit<288> = 288'h0          ,
    param INIT_RAM_08: bit<288> = 288'h0          ,
    param INIT_RAM_09: bit<288> = 288'h0          ,
    param INIT_RAM_0A: bit<288> = 288'h0          ,
    param INIT_RAM_0B: bit<288> = 288'h0          ,
    param INIT_RAM_0C: bit<288> = 288'h0          ,
    param INIT_RAM_0D: bit<288> = 288'h0          ,
    param INIT_RAM_0E: bit<288> = 288'h0          ,
    param INIT_RAM_0F: bit<288> = 288'h0          ,
    param INIT_RAM_10: bit<288> = 288'h0          ,
    param INIT_RAM_11: bit<288> = 288'h0          ,
    param INIT_RAM_12: bit<288> = 288'h0          ,
    param INIT_RAM_13: bit<288> = 288'h0          ,
    param INIT_RAM_14: bit<288> = 288'h0          ,
    param INIT_RAM_15: bit<288> = 288'h0          ,
    param INIT_RAM_16: bit<288> = 288'h0          ,
    param INIT_RAM_17: bit<288> = 288'h0          ,
    param INIT_RAM_18: bit<288> = 288'h0          ,
    param INIT_RAM_19: bit<288> = 288'h0          ,
    param INIT_RAM_1A: bit<288> = 288'h0          ,
    param INIT_RAM_1B: bit<288> = 288'h0          ,
    param INIT_RAM_1C: bit<288> = 288'h0          ,
    param INIT_RAM_1D: bit<288> = 288'h0          ,
    param INIT_RAM_1E: bit<288> = 288'h0          ,
    param INIT_RAM_1F: bit<288> = 288'h0          ,
    param INIT_RAM_20: bit<288> = 288'h0          ,
    param INIT_RAM_21: bit<288> = 288'h0          ,
    param INIT_RAM_22: bit<288> = 288'h0          ,
    param INIT_RAM_23: bit<288> = 288'h0          ,
    param INIT_RAM_24: bit<288> = 288'h0          ,
    param INIT_RAM_25: bit<288> = 288'h0          ,
    param INIT_RAM_26: bit<288> = 288'h0          ,
    param INIT_RAM_27: bit<288> = 288'h0          ,
    param INIT_RAM_28: bit<288> = 288'h0          ,
    param INIT_RAM_29: bit<288> = 288'h0          ,
    param INIT_RAM_2A: bit<288> = 288'h0          ,
    param INIT_RAM_2B: bit<288> = 288'h0          ,
    param INIT_RAM_2C: bit<288> = 288'h0          ,
    param INIT_RAM_2D: bit<288> = 288'h0          ,
    param INIT_RAM_2E: bit<288> = 288'h0          ,
    param INIT_RAM_2F: bit<288> = 288'h0          ,
    param INIT_RAM_30: bit<288> = 288'h0          ,
    param INIT_RAM_31: bit<288> = 288'h0          ,
    param INIT_RAM_32: bit<288> = 288'h0          ,
    param INIT_RAM_33: bit<288> = 288'h0          ,
    param INIT_RAM_34: bit<288> = 288'h0          ,
    param INIT_RAM_35: bit<288> = 288'h0          ,
    param INIT_RAM_36: bit<288> = 288'h0          ,
    param INIT_RAM_37: bit<288> = 288'h0          ,
    param INIT_RAM_38: bit<288> = 288'h0          ,
    param INIT_RAM_39: bit<288> = 288'h0          ,
    param INIT_RAM_3A: bit<288> = 288'h0          ,
    param INIT_RAM_3B: bit<288> = 288'h0          ,
    param INIT_RAM_3C: bit<288> = 288'h0          ,
    param INIT_RAM_3D: bit<288> = 288'h0          ,
    param INIT_RAM_3E: bit<288> = 288'h0          ,
    param INIT_RAM_3F: bit<288> = 288'h0          ,
) (
    DO    : output logic<36>,
    DI    : input  logic<36>,
    BLKSEL: input  logic<3> ,
    AD    : input  logic<14>,
    WRE   : input  logic    ,
    CLK   : input  clock    ,
    CE    : input  logic    ,
    OCE   : input  logic    ,
    RESET : input  logic    ,
) {
    #[allow(initial_assign)]
    var mem_bits: logic<18432>;
    #[allow(initial_assign)]
    var raw_do: logic<36>;
    #[allow(initial_assign)]
    var pipe_do: logic<36>;

    // The output reads 0 until the first access (the SV model set DO = 0)
    initial {
        mem_bits[0 * 288+:288]  = INIT_RAM_00;
        mem_bits[1 * 288+:288]  = INIT_RAM_01;
        mem_bits[2 * 288+:288]  = INIT_RAM_02;
        mem_bits[3 * 288+:288]  = INIT_RAM_03;
        mem_bits[4 * 288+:288]  = INIT_RAM_04;
        mem_bits[5 * 288+:288]  = INIT_RAM_05;
        mem_bits[6 * 288+:288]  = INIT_RAM_06;
        mem_bits[7 * 288+:288]  = INIT_RAM_07;
        mem_bits[8 * 288+:288]  = INIT_RAM_08;
        mem_bits[9 * 288+:288]  = INIT_RAM_09;
        mem_bits[10 * 288+:288] = INIT_RAM_0A;
        mem_bits[11 * 288+:288] = INIT_RAM_0B;
        mem_bits[12 * 288+:288] = INIT_RAM_0C;
        mem_bits[13 * 288+:288] = INIT_RAM_0D;
        mem_bits[14 * 288+:288] = INIT_RAM_0E;
        mem_bits[15 * 288+:288] = INIT_RAM_0F;
        mem_bits[16 * 288+:288] = INIT_RAM_10;
        mem_bits[17 * 288+:288] = INIT_RAM_11;
        mem_bits[18 * 288+:288] = INIT_RAM_12;
        mem_bits[19 * 288+:288] = INIT_RAM_13;
        mem_bits[20 * 288+:288] = INIT_RAM_14;
        mem_bits[21 * 288+:288] = INIT_RAM_15;
        mem_bits[22 * 288+:288] = INIT_RAM_16;
        mem_bits[23 * 288+:288] = INIT_RAM_17;
        mem_bits[24 * 288+:288] = INIT_RAM_18;
        mem_bits[25 * 288+:288] = INIT_RAM_19;
        mem_bits[26 * 288+:288] = INIT_RAM_1A;
        mem_bits[27 * 288+:288] = INIT_RAM_1B;
        mem_bits[28 * 288+:288] = INIT_RAM_1C;
        mem_bits[29 * 288+:288] = INIT_RAM_1D;
        mem_bits[30 * 288+:288] = INIT_RAM_1E;
        mem_bits[31 * 288+:288] = INIT_RAM_1F;
        mem_bits[32 * 288+:288] = INIT_RAM_20;
        mem_bits[33 * 288+:288] = INIT_RAM_21;
        mem_bits[34 * 288+:288] = INIT_RAM_22;
        mem_bits[35 * 288+:288] = INIT_RAM_23;
        mem_bits[36 * 288+:288] = INIT_RAM_24;
        mem_bits[37 * 288+:288] = INIT_RAM_25;
        mem_bits[38 * 288+:288] = INIT_RAM_26;
        mem_bits[39 * 288+:288] = INIT_RAM_27;
        mem_bits[40 * 288+:288] = INIT_RAM_28;
        mem_bits[41 * 288+:288] = INIT_RAM_29;
        mem_bits[42 * 288+:288] = INIT_RAM_2A;
        mem_bits[43 * 288+:288] = INIT_RAM_2B;
        mem_bits[44 * 288+:288] = INIT_RAM_2C;
        mem_bits[45 * 288+:288] = INIT_RAM_2D;
        mem_bits[46 * 288+:288] = INIT_RAM_2E;
        mem_bits[47 * 288+:288] = INIT_RAM_2F;
        mem_bits[48 * 288+:288] = INIT_RAM_30;
        mem_bits[49 * 288+:288] = INIT_RAM_31;
        mem_bits[50 * 288+:288] = INIT_RAM_32;
        mem_bits[51 * 288+:288] = INIT_RAM_33;
        mem_bits[52 * 288+:288] = INIT_RAM_34;
        mem_bits[53 * 288+:288] = INIT_RAM_35;
        mem_bits[54 * 288+:288] = INIT_RAM_36;
        mem_bits[55 * 288+:288] = INIT_RAM_37;
        mem_bits[56 * 288+:288] = INIT_RAM_38;
        mem_bits[57 * 288+:288] = INIT_RAM_39;
        mem_bits[58 * 288+:288] = INIT_RAM_3A;
        mem_bits[59 * 288+:288] = INIT_RAM_3B;
        mem_bits[60 * 288+:288] = INIT_RAM_3C;
        mem_bits[61 * 288+:288] = INIT_RAM_3D;
        mem_bits[62 * 288+:288] = INIT_RAM_3E;
        mem_bits[63 * 288+:288] = INIT_RAM_3F;
        raw_do                  = 36'h0;
        pipe_do                 = 36'h0;
    }

    // BLK_SEL == 0 matches any BLKSEL: a simplification (Gowin selects on an exact match),
    // invisible to synth_gowin's netlists, which tie both to 0
    let blksel_match: logic = BLKSEL == BLK_SEL || BLK_SEL == 3'b000;

    // Bit offset of the addressed word for the configured width
    var off: logic<32>;
    always_comb {
        case BIT_WIDTH {
            9      : off = AD[13:3] * 9;
            18     : off = AD[13:4] * 18;
            36     : off = AD[13:5] * 36;
            default: off = AD[13:5] * 36;
        }
    }

    always_ff (CLK) {
        if CE && blksel_match {
            if WRE {
                for i in 0..BIT_WIDTH {
                    mem_bits[off + i] = DI[i];
                }
                if WRITE_MODE == 2'b01 {
                    raw_do = DI;
                } else if WRITE_MODE == 2'b10 {
                    raw_do = mem_bits[off+:36];
                }
            } else {
                raw_do = mem_bits[off+:36];
            }
        }
    }

    always_ff (CLK) {
        if RESET {
            pipe_do = 36'h0;
        } else if OCE {
            pipe_do = raw_do;
        }
    }

    assign DO = if READ_MODE == 1'b1 ? pipe_do : raw_do;
}

// Single-port block RAM, 16 Kbit
module SP #(
    param READ_MODE  : bit      = 1'b0            ,
    param WRITE_MODE : bit<2>   = 2'b00           ,
    param BIT_WIDTH  : i32      = 32              ,
    param BLK_SEL    : bit<3>   = 3'b000          ,
    param RESET_MODE : bit<40>  = 40'h00_5359_4E43, // "SYNC" (or "ASYNC") as ASCII; unused. Not a string: Yosys cannot read string params
    param INIT_RAM_00: bit<256> = 256'h0          ,
    param INIT_RAM_01: bit<256> = 256'h0          ,
    param INIT_RAM_02: bit<256> = 256'h0          ,
    param INIT_RAM_03: bit<256> = 256'h0          ,
    param INIT_RAM_04: bit<256> = 256'h0          ,
    param INIT_RAM_05: bit<256> = 256'h0          ,
    param INIT_RAM_06: bit<256> = 256'h0          ,
    param INIT_RAM_07: bit<256> = 256'h0          ,
    param INIT_RAM_08: bit<256> = 256'h0          ,
    param INIT_RAM_09: bit<256> = 256'h0          ,
    param INIT_RAM_0A: bit<256> = 256'h0          ,
    param INIT_RAM_0B: bit<256> = 256'h0          ,
    param INIT_RAM_0C: bit<256> = 256'h0          ,
    param INIT_RAM_0D: bit<256> = 256'h0          ,
    param INIT_RAM_0E: bit<256> = 256'h0          ,
    param INIT_RAM_0F: bit<256> = 256'h0          ,
    param INIT_RAM_10: bit<256> = 256'h0          ,
    param INIT_RAM_11: bit<256> = 256'h0          ,
    param INIT_RAM_12: bit<256> = 256'h0          ,
    param INIT_RAM_13: bit<256> = 256'h0          ,
    param INIT_RAM_14: bit<256> = 256'h0          ,
    param INIT_RAM_15: bit<256> = 256'h0          ,
    param INIT_RAM_16: bit<256> = 256'h0          ,
    param INIT_RAM_17: bit<256> = 256'h0          ,
    param INIT_RAM_18: bit<256> = 256'h0          ,
    param INIT_RAM_19: bit<256> = 256'h0          ,
    param INIT_RAM_1A: bit<256> = 256'h0          ,
    param INIT_RAM_1B: bit<256> = 256'h0          ,
    param INIT_RAM_1C: bit<256> = 256'h0          ,
    param INIT_RAM_1D: bit<256> = 256'h0          ,
    param INIT_RAM_1E: bit<256> = 256'h0          ,
    param INIT_RAM_1F: bit<256> = 256'h0          ,
    param INIT_RAM_20: bit<256> = 256'h0          ,
    param INIT_RAM_21: bit<256> = 256'h0          ,
    param INIT_RAM_22: bit<256> = 256'h0          ,
    param INIT_RAM_23: bit<256> = 256'h0          ,
    param INIT_RAM_24: bit<256> = 256'h0          ,
    param INIT_RAM_25: bit<256> = 256'h0          ,
    param INIT_RAM_26: bit<256> = 256'h0          ,
    param INIT_RAM_27: bit<256> = 256'h0          ,
    param INIT_RAM_28: bit<256> = 256'h0          ,
    param INIT_RAM_29: bit<256> = 256'h0          ,
    param INIT_RAM_2A: bit<256> = 256'h0          ,
    param INIT_RAM_2B: bit<256> = 256'h0          ,
    param INIT_RAM_2C: bit<256> = 256'h0          ,
    param INIT_RAM_2D: bit<256> = 256'h0          ,
    param INIT_RAM_2E: bit<256> = 256'h0          ,
    param INIT_RAM_2F: bit<256> = 256'h0          ,
    param INIT_RAM_30: bit<256> = 256'h0          ,
    param INIT_RAM_31: bit<256> = 256'h0          ,
    param INIT_RAM_32: bit<256> = 256'h0          ,
    param INIT_RAM_33: bit<256> = 256'h0          ,
    param INIT_RAM_34: bit<256> = 256'h0          ,
    param INIT_RAM_35: bit<256> = 256'h0          ,
    param INIT_RAM_36: bit<256> = 256'h0          ,
    param INIT_RAM_37: bit<256> = 256'h0          ,
    param INIT_RAM_38: bit<256> = 256'h0          ,
    param INIT_RAM_39: bit<256> = 256'h0          ,
    param INIT_RAM_3A: bit<256> = 256'h0          ,
    param INIT_RAM_3B: bit<256> = 256'h0          ,
    param INIT_RAM_3C: bit<256> = 256'h0          ,
    param INIT_RAM_3D: bit<256> = 256'h0          ,
    param INIT_RAM_3E: bit<256> = 256'h0          ,
    param INIT_RAM_3F: bit<256> = 256'h0          ,
) (
    DO    : output logic<32>,
    DI    : input  logic<32>,
    BLKSEL: input  logic<3> ,
    AD    : input  logic<14>,
    WRE   : input  logic    ,
    CLK   : input  clock    ,
    CE    : input  logic    ,
    OCE   : input  logic    ,
    RESET : input  logic    ,
) {
    #[allow(initial_assign)]
    var mem_bits: logic<16384>;
    #[allow(initial_assign)]
    var raw_do: logic<32>;
    #[allow(initial_assign)]
    var pipe_do: logic<32>;

    // The output reads 0 until the first access (the SV model set DO = 0)
    initial {
        mem_bits[0 * 256+:256]  = INIT_RAM_00;
        mem_bits[1 * 256+:256]  = INIT_RAM_01;
        mem_bits[2 * 256+:256]  = INIT_RAM_02;
        mem_bits[3 * 256+:256]  = INIT_RAM_03;
        mem_bits[4 * 256+:256]  = INIT_RAM_04;
        mem_bits[5 * 256+:256]  = INIT_RAM_05;
        mem_bits[6 * 256+:256]  = INIT_RAM_06;
        mem_bits[7 * 256+:256]  = INIT_RAM_07;
        mem_bits[8 * 256+:256]  = INIT_RAM_08;
        mem_bits[9 * 256+:256]  = INIT_RAM_09;
        mem_bits[10 * 256+:256] = INIT_RAM_0A;
        mem_bits[11 * 256+:256] = INIT_RAM_0B;
        mem_bits[12 * 256+:256] = INIT_RAM_0C;
        mem_bits[13 * 256+:256] = INIT_RAM_0D;
        mem_bits[14 * 256+:256] = INIT_RAM_0E;
        mem_bits[15 * 256+:256] = INIT_RAM_0F;
        mem_bits[16 * 256+:256] = INIT_RAM_10;
        mem_bits[17 * 256+:256] = INIT_RAM_11;
        mem_bits[18 * 256+:256] = INIT_RAM_12;
        mem_bits[19 * 256+:256] = INIT_RAM_13;
        mem_bits[20 * 256+:256] = INIT_RAM_14;
        mem_bits[21 * 256+:256] = INIT_RAM_15;
        mem_bits[22 * 256+:256] = INIT_RAM_16;
        mem_bits[23 * 256+:256] = INIT_RAM_17;
        mem_bits[24 * 256+:256] = INIT_RAM_18;
        mem_bits[25 * 256+:256] = INIT_RAM_19;
        mem_bits[26 * 256+:256] = INIT_RAM_1A;
        mem_bits[27 * 256+:256] = INIT_RAM_1B;
        mem_bits[28 * 256+:256] = INIT_RAM_1C;
        mem_bits[29 * 256+:256] = INIT_RAM_1D;
        mem_bits[30 * 256+:256] = INIT_RAM_1E;
        mem_bits[31 * 256+:256] = INIT_RAM_1F;
        mem_bits[32 * 256+:256] = INIT_RAM_20;
        mem_bits[33 * 256+:256] = INIT_RAM_21;
        mem_bits[34 * 256+:256] = INIT_RAM_22;
        mem_bits[35 * 256+:256] = INIT_RAM_23;
        mem_bits[36 * 256+:256] = INIT_RAM_24;
        mem_bits[37 * 256+:256] = INIT_RAM_25;
        mem_bits[38 * 256+:256] = INIT_RAM_26;
        mem_bits[39 * 256+:256] = INIT_RAM_27;
        mem_bits[40 * 256+:256] = INIT_RAM_28;
        mem_bits[41 * 256+:256] = INIT_RAM_29;
        mem_bits[42 * 256+:256] = INIT_RAM_2A;
        mem_bits[43 * 256+:256] = INIT_RAM_2B;
        mem_bits[44 * 256+:256] = INIT_RAM_2C;
        mem_bits[45 * 256+:256] = INIT_RAM_2D;
        mem_bits[46 * 256+:256] = INIT_RAM_2E;
        mem_bits[47 * 256+:256] = INIT_RAM_2F;
        mem_bits[48 * 256+:256] = INIT_RAM_30;
        mem_bits[49 * 256+:256] = INIT_RAM_31;
        mem_bits[50 * 256+:256] = INIT_RAM_32;
        mem_bits[51 * 256+:256] = INIT_RAM_33;
        mem_bits[52 * 256+:256] = INIT_RAM_34;
        mem_bits[53 * 256+:256] = INIT_RAM_35;
        mem_bits[54 * 256+:256] = INIT_RAM_36;
        mem_bits[55 * 256+:256] = INIT_RAM_37;
        mem_bits[56 * 256+:256] = INIT_RAM_38;
        mem_bits[57 * 256+:256] = INIT_RAM_39;
        mem_bits[58 * 256+:256] = INIT_RAM_3A;
        mem_bits[59 * 256+:256] = INIT_RAM_3B;
        mem_bits[60 * 256+:256] = INIT_RAM_3C;
        mem_bits[61 * 256+:256] = INIT_RAM_3D;
        mem_bits[62 * 256+:256] = INIT_RAM_3E;
        mem_bits[63 * 256+:256] = INIT_RAM_3F;
        raw_do                  = 32'h0;
        pipe_do                 = 32'h0;
    }

    // BLK_SEL == 0 matches any BLKSEL: a simplification (Gowin selects on an exact match),
    // invisible to synth_gowin's netlists, which tie both to 0
    let blksel_match: logic = BLKSEL == BLK_SEL || BLK_SEL == 3'b000;

    // Bit offset of the addressed word for the configured width
    var off: logic<32>;
    always_comb {
        case BIT_WIDTH {
            1      : off = AD[13:0] * 1;
            2      : off = AD[13:1] * 2;
            4      : off = AD[13:2] * 4;
            8      : off = AD[13:3] * 8;
            16     : off = AD[13:4] * 16;
            32     : off = AD[13:5] * 32;
            default: off = AD[13:5] * 32;
        }
    }

    always_ff (CLK) {
        if CE && blksel_match {
            if WRE {
                for i in 0..BIT_WIDTH {
                    mem_bits[off + i] = DI[i];
                }
                if WRITE_MODE == 2'b01 {
                    raw_do = DI;
                } else if WRITE_MODE == 2'b10 {
                    raw_do = mem_bits[off+:32];
                }
            } else {
                raw_do = mem_bits[off+:32];
            }
        }
    }

    always_ff (CLK) {
        if RESET {
            pipe_do = 32'h0;
        } else if OCE {
            pipe_do = raw_do;
        }
    }

    assign DO = if READ_MODE == 1'b1 ? pipe_do : raw_do;
}

// Semi-dual-port block RAM, 16 Kbit: port A writes (BIT_WIDTH_0), port B reads
// (BIT_WIDTH_1). Ports and parameters follow Yosys' cells_xtra_gw1n.v (32-bit DI/DO).
// BLKSELA/B must equal BLK_SEL_0/1 exactly.
module SDPB #(
    param READ_MODE  : bit      = 1'b0            ,
    param BIT_WIDTH_0: i32      = 32              ,
    param BIT_WIDTH_1: i32      = 32              ,
    param BLK_SEL_0  : bit<3>   = 3'b000          ,
    param BLK_SEL_1  : bit<3>   = 3'b000          ,
    param RESET_MODE : bit<40>  = 40'h00_5359_4E43, // "SYNC" (or "ASYNC") as ASCII; unused. Not a string: Yosys cannot read string params
    param INIT_RAM_00: bit<256> = 256'h0          ,
    param INIT_RAM_01: bit<256> = 256'h0          ,
    param INIT_RAM_02: bit<256> = 256'h0          ,
    param INIT_RAM_03: bit<256> = 256'h0          ,
    param INIT_RAM_04: bit<256> = 256'h0          ,
    param INIT_RAM_05: bit<256> = 256'h0          ,
    param INIT_RAM_06: bit<256> = 256'h0          ,
    param INIT_RAM_07: bit<256> = 256'h0          ,
    param INIT_RAM_08: bit<256> = 256'h0          ,
    param INIT_RAM_09: bit<256> = 256'h0          ,
    param INIT_RAM_0A: bit<256> = 256'h0          ,
    param INIT_RAM_0B: bit<256> = 256'h0          ,
    param INIT_RAM_0C: bit<256> = 256'h0          ,
    param INIT_RAM_0D: bit<256> = 256'h0          ,
    param INIT_RAM_0E: bit<256> = 256'h0          ,
    param INIT_RAM_0F: bit<256> = 256'h0          ,
    param INIT_RAM_10: bit<256> = 256'h0          ,
    param INIT_RAM_11: bit<256> = 256'h0          ,
    param INIT_RAM_12: bit<256> = 256'h0          ,
    param INIT_RAM_13: bit<256> = 256'h0          ,
    param INIT_RAM_14: bit<256> = 256'h0          ,
    param INIT_RAM_15: bit<256> = 256'h0          ,
    param INIT_RAM_16: bit<256> = 256'h0          ,
    param INIT_RAM_17: bit<256> = 256'h0          ,
    param INIT_RAM_18: bit<256> = 256'h0          ,
    param INIT_RAM_19: bit<256> = 256'h0          ,
    param INIT_RAM_1A: bit<256> = 256'h0          ,
    param INIT_RAM_1B: bit<256> = 256'h0          ,
    param INIT_RAM_1C: bit<256> = 256'h0          ,
    param INIT_RAM_1D: bit<256> = 256'h0          ,
    param INIT_RAM_1E: bit<256> = 256'h0          ,
    param INIT_RAM_1F: bit<256> = 256'h0          ,
    param INIT_RAM_20: bit<256> = 256'h0          ,
    param INIT_RAM_21: bit<256> = 256'h0          ,
    param INIT_RAM_22: bit<256> = 256'h0          ,
    param INIT_RAM_23: bit<256> = 256'h0          ,
    param INIT_RAM_24: bit<256> = 256'h0          ,
    param INIT_RAM_25: bit<256> = 256'h0          ,
    param INIT_RAM_26: bit<256> = 256'h0          ,
    param INIT_RAM_27: bit<256> = 256'h0          ,
    param INIT_RAM_28: bit<256> = 256'h0          ,
    param INIT_RAM_29: bit<256> = 256'h0          ,
    param INIT_RAM_2A: bit<256> = 256'h0          ,
    param INIT_RAM_2B: bit<256> = 256'h0          ,
    param INIT_RAM_2C: bit<256> = 256'h0          ,
    param INIT_RAM_2D: bit<256> = 256'h0          ,
    param INIT_RAM_2E: bit<256> = 256'h0          ,
    param INIT_RAM_2F: bit<256> = 256'h0          ,
    param INIT_RAM_30: bit<256> = 256'h0          ,
    param INIT_RAM_31: bit<256> = 256'h0          ,
    param INIT_RAM_32: bit<256> = 256'h0          ,
    param INIT_RAM_33: bit<256> = 256'h0          ,
    param INIT_RAM_34: bit<256> = 256'h0          ,
    param INIT_RAM_35: bit<256> = 256'h0          ,
    param INIT_RAM_36: bit<256> = 256'h0          ,
    param INIT_RAM_37: bit<256> = 256'h0          ,
    param INIT_RAM_38: bit<256> = 256'h0          ,
    param INIT_RAM_39: bit<256> = 256'h0          ,
    param INIT_RAM_3A: bit<256> = 256'h0          ,
    param INIT_RAM_3B: bit<256> = 256'h0          ,
    param INIT_RAM_3C: bit<256> = 256'h0          ,
    param INIT_RAM_3D: bit<256> = 256'h0          ,
    param INIT_RAM_3E: bit<256> = 256'h0          ,
    param INIT_RAM_3F: bit<256> = 256'h0          ,
) (
    CLKA   : input  'a clock    ,
    CEA    : input  'a logic    ,
    CLKB   : input  'b clock    ,
    CEB    : input  'b logic    ,
    OCE    : input  'b logic    ,
    RESETA : input  'a logic    ,
    RESETB : input  'b logic    ,
    ADA    : input  'a logic<14>,
    ADB    : input  'b logic<14>,
    DI     : input  'a logic<32>,
    BLKSELA: input  'a logic<3> ,
    BLKSELB: input  'b logic<3> ,
    DO     : output 'b logic<32>,
) {
    #[allow(initial_assign)]
    var mem_bits: logic<16384>;
    #[allow(initial_assign)]
    var raw_do: logic<32>;
    #[allow(initial_assign)]
    var pipe_do: logic<32>;

    // The output reads 0 until the first access
    initial {
        mem_bits[0 * 256+:256]  = INIT_RAM_00;
        mem_bits[1 * 256+:256]  = INIT_RAM_01;
        mem_bits[2 * 256+:256]  = INIT_RAM_02;
        mem_bits[3 * 256+:256]  = INIT_RAM_03;
        mem_bits[4 * 256+:256]  = INIT_RAM_04;
        mem_bits[5 * 256+:256]  = INIT_RAM_05;
        mem_bits[6 * 256+:256]  = INIT_RAM_06;
        mem_bits[7 * 256+:256]  = INIT_RAM_07;
        mem_bits[8 * 256+:256]  = INIT_RAM_08;
        mem_bits[9 * 256+:256]  = INIT_RAM_09;
        mem_bits[10 * 256+:256] = INIT_RAM_0A;
        mem_bits[11 * 256+:256] = INIT_RAM_0B;
        mem_bits[12 * 256+:256] = INIT_RAM_0C;
        mem_bits[13 * 256+:256] = INIT_RAM_0D;
        mem_bits[14 * 256+:256] = INIT_RAM_0E;
        mem_bits[15 * 256+:256] = INIT_RAM_0F;
        mem_bits[16 * 256+:256] = INIT_RAM_10;
        mem_bits[17 * 256+:256] = INIT_RAM_11;
        mem_bits[18 * 256+:256] = INIT_RAM_12;
        mem_bits[19 * 256+:256] = INIT_RAM_13;
        mem_bits[20 * 256+:256] = INIT_RAM_14;
        mem_bits[21 * 256+:256] = INIT_RAM_15;
        mem_bits[22 * 256+:256] = INIT_RAM_16;
        mem_bits[23 * 256+:256] = INIT_RAM_17;
        mem_bits[24 * 256+:256] = INIT_RAM_18;
        mem_bits[25 * 256+:256] = INIT_RAM_19;
        mem_bits[26 * 256+:256] = INIT_RAM_1A;
        mem_bits[27 * 256+:256] = INIT_RAM_1B;
        mem_bits[28 * 256+:256] = INIT_RAM_1C;
        mem_bits[29 * 256+:256] = INIT_RAM_1D;
        mem_bits[30 * 256+:256] = INIT_RAM_1E;
        mem_bits[31 * 256+:256] = INIT_RAM_1F;
        mem_bits[32 * 256+:256] = INIT_RAM_20;
        mem_bits[33 * 256+:256] = INIT_RAM_21;
        mem_bits[34 * 256+:256] = INIT_RAM_22;
        mem_bits[35 * 256+:256] = INIT_RAM_23;
        mem_bits[36 * 256+:256] = INIT_RAM_24;
        mem_bits[37 * 256+:256] = INIT_RAM_25;
        mem_bits[38 * 256+:256] = INIT_RAM_26;
        mem_bits[39 * 256+:256] = INIT_RAM_27;
        mem_bits[40 * 256+:256] = INIT_RAM_28;
        mem_bits[41 * 256+:256] = INIT_RAM_29;
        mem_bits[42 * 256+:256] = INIT_RAM_2A;
        mem_bits[43 * 256+:256] = INIT_RAM_2B;
        mem_bits[44 * 256+:256] = INIT_RAM_2C;
        mem_bits[45 * 256+:256] = INIT_RAM_2D;
        mem_bits[46 * 256+:256] = INIT_RAM_2E;
        mem_bits[47 * 256+:256] = INIT_RAM_2F;
        mem_bits[48 * 256+:256] = INIT_RAM_30;
        mem_bits[49 * 256+:256] = INIT_RAM_31;
        mem_bits[50 * 256+:256] = INIT_RAM_32;
        mem_bits[51 * 256+:256] = INIT_RAM_33;
        mem_bits[52 * 256+:256] = INIT_RAM_34;
        mem_bits[53 * 256+:256] = INIT_RAM_35;
        mem_bits[54 * 256+:256] = INIT_RAM_36;
        mem_bits[55 * 256+:256] = INIT_RAM_37;
        mem_bits[56 * 256+:256] = INIT_RAM_38;
        mem_bits[57 * 256+:256] = INIT_RAM_39;
        mem_bits[58 * 256+:256] = INIT_RAM_3A;
        mem_bits[59 * 256+:256] = INIT_RAM_3B;
        mem_bits[60 * 256+:256] = INIT_RAM_3C;
        mem_bits[61 * 256+:256] = INIT_RAM_3D;
        mem_bits[62 * 256+:256] = INIT_RAM_3E;
        mem_bits[63 * 256+:256] = INIT_RAM_3F;
        raw_do                  = 32'h0;
        pipe_do                 = 32'h0;
    }

    // Written from port A's clock, read from port B's: crosses clock domains by construction
    unsafe (cdc) {
        // Bit offset of the addressed word for each port's width
        var off_a: logic<32>;
        var off_b: logic<32>;
        always_comb {
            case BIT_WIDTH_0 {
                1      : off_a = ADA[13:0] * 1;
                2      : off_a = ADA[13:1] * 2;
                4      : off_a = ADA[13:2] * 4;
                8      : off_a = ADA[13:3] * 8;
                9      : off_a = ADA[13:3] * 9;
                16     : off_a = ADA[13:4] * 16;
                18     : off_a = ADA[13:4] * 18;
                32     : off_a = ADA[13:5] * 32;
                36     : off_a = ADA[13:5] * 36;
                default: off_a = ADA[13:5] * 32;
            }
            case BIT_WIDTH_1 {
                1      : off_b = ADB[13:0] * 1;
                2      : off_b = ADB[13:1] * 2;
                4      : off_b = ADB[13:2] * 4;
                8      : off_b = ADB[13:3] * 8;
                9      : off_b = ADB[13:3] * 9;
                16     : off_b = ADB[13:4] * 16;
                18     : off_b = ADB[13:4] * 18;
                32     : off_b = ADB[13:5] * 32;
                36     : off_b = ADB[13:5] * 36;
                default: off_b = ADB[13:5] * 32;
            }
        }

        always_ff (CLKA) {
            if CEA && BLKSELA == BLK_SEL_0 {
                for i in 0..BIT_WIDTH_0 {
                    mem_bits[off_a + i] = DI[i];
                }
            }
        }

        always_ff (CLKB) {
            if CEB && BLKSELB == BLK_SEL_1 {
                raw_do = mem_bits[off_b+:32];
            }
        }

        // Optional output pipeline register
        always_ff (CLKB) {
            if RESETB {
                pipe_do = 32'h0;
            } else if OCE {
                pipe_do = raw_do;
            }
        }

        assign DO = if READ_MODE == 1'b1 ? pipe_do : raw_do;
    }
}
