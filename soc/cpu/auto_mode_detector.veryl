// First-Instruction Auto Mode Detector in Veryl
pub module auto_mode_detector (
    clk          : input  clock    ,
    rst          : input  reset    ,
    soft_rst     : input  logic    ,
    first_instr  : input  logic<32>,
    is_riscv_mode: output logic    ,
) {
    var mode_latched: logic   ;
    var opcode      : logic<7>;

    assign opcode = first_instr[6:0];

    var op             : rv32i_pkg::Opcode;
    var is_rv32i_opcode: logic            ;
    always_comb {
        op = opcode as rv32i_pkg::Opcode;
        case op {
            rv32i_pkg::Opcode::R_TYPE, rv32i_pkg::Opcode::I_TYPE, rv32i_pkg::Opcode::LOAD, rv32i_pkg::Opcode::STORE,
            rv32i_pkg::Opcode::BRANCH, rv32i_pkg::Opcode::JAL, rv32i_pkg::Opcode::JALR, rv32i_pkg::Opcode::LUI,
            rv32i_pkg::Opcode::AUIPC, rv32i_pkg::Opcode::SYSTEM: is_rv32i_opcode = 1'b1;
            default: is_rv32i_opcode = 1'b0;
        }
    }

    always_ff (clk, rst) {
        if_reset {
            mode_latched  = 1'b0;
            is_riscv_mode = 1'b1;
        } else if soft_rst {
            mode_latched  = 1'b0;
            is_riscv_mode = 1'b1;
        } else {
            if !mode_latched {
                if first_instr != 32'd0 {
                    if first_instr[1:0] == 2'b11 && is_rv32i_opcode {
                        is_riscv_mode = 1'b1;
                        mode_latched  = 1'b1;
                    } else if (first_instr[15:13] == 3'b111)
                        || (first_instr[15] == 1'b0 && first_instr[14:0] != 15'd0) {
                        is_riscv_mode = 1'b0;
                        mode_latched  = 1'b1;
                    }
                }
            }
        }
    }
}
