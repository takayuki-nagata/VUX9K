// Unified Dual-ISA CPU Core (RISC-V 32-bit + Hack 16-bit) in Veryl
// Robust 2-Stage Multi-Cycle FSM Architecture (Fetch -> Execute) for 100% Gowin FPGA Synchronous Block RAM Compatibility
pub module unified_cpu #(
    param RESET_VECTOR: u32 = 32'h0000_0000,
) (
    clk         : input  clock    ,
    rst         : input  reset    ,
    soft_rst    : input  logic    ,
    instr_in    : input  logic<32>,
    data_in     : input  logic<32>,
    timer_irq_in: input  logic    ,
    ext_irq_in  : input  logic    ,
    sw_irq_in   : input  logic    ,
    pc_out      : output logic<32>,
    data_addr   : output logic<32>,
    data_waddr  : output logic<32>,
    data_out    : output logic<32>,
    mem_write   : output logic    ,
    mem_read_req: output logic    ,
    mem_byte_we : output logic<4> ,
    active_mode : output logic    , // 0: Hack 16-bit, 1: RISC-V 32-bit
) {
    enum CpuState {
        FETCH,
        EXECUTE,
        MEM_WAIT,
        HACK_WB,
        HACK_WR_D, // second write-back cycle of a Hack AD=/AMD= instruction (writes D)
    }

    var state        : CpuState    ;
    var r_load_we    : logic       ;
    var r_hack_data  : logic   <32>;
    var r_hack_d     : logic   <32>; // D value waiting for HACK_WR_D
    var is_riscv_mode: logic       ;
    // A data read completes in MEM_WAIT: an RV32 load, or a Hack comp reading M
    // (Hack mode enters MEM_WAIT only for that). Peripherals with read side effects
    // (UART RX pop) act on this, not on the address alone.
    assign mem_read_req = state == CpuState::MEM_WAIT && (if is_riscv_mode ? r_load_we : 1'b1);
    var pc_reg       : logic<32>;
    var pc_plus_4_reg: logic<32>;
    var next_pc      : logic<32>;
    var ir_reg       : logic<32>; // Instruction Register

    // Hack Translator signals
    var h_rs1       : logic           <5> ;
    var h_rs2       : logic           <5> ;
    var h_rd        : logic           <5> ;
    var h_imm       : logic           <32>;
    var h_alu_op    : rv32i_pkg::AluOp    ;
    var h_use_imm   : logic               ;
    var h_use_mem   : logic               ;
    var h_we_reg_a  : logic               ;
    var h_we_reg_d  : logic               ;
    var h_we_mem    : logic               ;
    var h_jump_cond : logic           <3> ;
    var h_is_c_instr: logic               ;
    var h_op_a_sel  : logic           <2> ;
    var h_op_b_sel  : logic           <2> ;

    // RV32I Decoder signals
    var rv_opcode  : logic<7> ;
    var rv_rd      : logic<5> ;
    var rv_funct3  : logic<3> ;
    var rv_rs1     : logic<5> ;
    var rv_rs2     : logic<5> ;
    var rv_funct7  : logic<7> ;
    var rv_imm     : logic<32>;
    var rv_csr_addr: logic<12>;
    var rv_uimm    : logic<32>;

    var rf_rs1_addr: logic<5>;
    var rf_rs2_addr: logic<5>;
    // Hack mode always reads D (x2) and A (x1) unconditionally: keeping these
    // addresses constant (not instruction-dependent) keeps hack_translator's
    // decode logic off the register-file-read -> ALU critical path. Operand
    // selection among {D, A/M, ZERO, IMM} happens downstream via op_a_sel/op_b_sel.
    assign rf_rs1_addr = if is_riscv_mode ? rv_rs1 : 5'd2;
    assign rf_rs2_addr = if is_riscv_mode ? rv_rs2 : 5'd1;
    var rf_rd_addr : logic<5> ;
    var rf_we      : logic    ;
    var rf_wr_data : logic<32>;
    var rf_rd2_addr: logic<5> ;
    var rf_we2     : logic    ;
    var rf_wr2_data: logic<32>;
    var rf_rs1_data: logic<32>;
    var rf_rs2_data: logic<32>;

    // ALU Signals
    var alu_operand_a: logic           <32>;
    var alu_operand_b: logic           <32>;
    var alu_ctrl     : rv32i_pkg::AluOp    ;
    var alu_result   : logic           <32>;
    var alu_zero     : logic               ;

    // CSR Module Signals
    var csr_we     : logic    ;
    var csr_rdata  : logic<32>;
    var trap_entry : logic    ;
    var trap_cause : logic<32>;
    var trap_val   : logic<32>;
    var trap_return: logic    ;
    var irq_pending: logic    ;
    var irq_cause  : logic<32>;
    var mtvec_out  : logic<32>;
    var mepc_out   : logic<32>;
    var is_ecall   : logic    ;
    var is_ebreak  : logic    ;
    var is_mret    : logic    ;
    var is_illegal : logic    ;
    var r_irq      : logic    ; // interrupt sampled in FETCH, taken in EXECUTE
    var r_irq_cause: logic<32>;
    var csr_access : logic    ;

    // Trap / next-PC helpers
    var fetch_misalign : logic    ;
    var mem_misalign   : logic    ;
    var is_branch_taken: logic    ;
    var jalr_target    : logic<32>;

    // Internal Helper Signals
    var load_val       : logic            <32>;
    var r_load_byte_sel: logic            <2> ;
    var r_load_f3      : rv32i_pkg::Funct3    ;
    var r_load_rd      : logic            <5> ;
    var r_store_addr   : logic            <32>;
    var r_store_data   : logic            <32>;
    var r_store_byte_we: logic            <4> ;
    var r_store_we     : logic                ;
    var r_hack_mem_we  : logic                ;
    var r_mem_write    : logic                ;
    var r_mem_byte_we  : logic            <4> ;
    var r_data_out     : logic            <32>;
    var rv_branch_take : logic                ;
    var hack_jump_take : logic                ;
    var rv_op          : rv32i_pkg::Opcode    ;
    var rv_f3          : rv32i_pkg::Funct3    ;

    assign active_mode = is_riscv_mode;
    // pc_reg is already final in HACK_WR_D (updated in the cycle before it)
    assign pc_out = if state == CpuState::FETCH || state == CpuState::HACK_WR_D ? pc_reg : next_pc;
    let rv_mem_addr: logic<32> = rf_rs1_data + rv_imm;
    assign data_addr   = if is_riscv_mode ? rv_mem_addr : rf_rs2_data;
    assign data_waddr  = if is_riscv_mode ? r_store_addr : rf_rs2_data;
    assign data_out    = if is_riscv_mode ? r_store_data : r_data_out;
    assign mem_byte_we = if is_riscv_mode ? r_store_byte_we : r_mem_byte_we;
    assign mem_write   = if is_riscv_mode ?
        r_store_we
    :
        (if (state == CpuState::HACK_WB) ?
            r_hack_mem_we
        :
            (if (state == CpuState::EXECUTE) ? (h_we_mem && !h_use_mem) : 1'b0)
        )
    ;

    inst mode_detect: auto_mode_detector (
        clk          : clk          ,
        rst          : rst          ,
        soft_rst     : soft_rst     ,
        first_instr  : instr_in     ,
        is_riscv_mode: is_riscv_mode,
    );

    // Hack Translator (16-bit Front-End)
    var h_instr_16: logic<16>;
    assign h_instr_16 = if pc_reg[1] ? ir_reg[31:16] : ir_reg[15:0];

    inst hack_trans: hack_translator (
        instr_16  : h_instr_16  ,
        rs1       : h_rs1       ,
        rs2       : h_rs2       ,
        rd        : h_rd        ,
        imm       : h_imm       ,
        alu_op    : h_alu_op    ,
        use_imm   : h_use_imm   ,
        use_mem   : h_use_mem   ,
        we_reg_a  : h_we_reg_a  ,
        we_reg_d  : h_we_reg_d  ,
        we_mem    : h_we_mem    ,
        jump_cond : h_jump_cond ,
        is_c_instr: h_is_c_instr,
        op_a_sel  : h_op_a_sel  ,
        op_b_sel  : h_op_b_sel  ,
    );

    // RV32I Instruction Decoder
    inst rv_decode: rv32i_decode (
        instruction: ir_reg     ,
        opcode     : rv_opcode  ,
        rd         : rv_rd      ,
        funct3     : rv_funct3  ,
        rs1        : rv_rs1     ,
        rs2        : rv_rs2     ,
        funct7     : rv_funct7  ,
        imm        : rv_imm     ,
        csr_addr   : rv_csr_addr,
        uimm       : rv_uimm    ,
    );

    // Dual-Port Register File
    inst reg_file: rv32i_regfile (
        clk     : clk                 ,
        rst     : rst                 ,
        we      : rf_we && !trap_entry,
        rd_addr : rf_rd_addr          ,
        wr_data : rf_wr_data          ,
        we2     : rf_we2              ,
        rd2_addr: rf_rd2_addr         ,
        wr2_data: rf_wr2_data         ,
        rs1_addr: rf_rs1_addr         ,
        rs2_addr: rf_rs2_addr         ,
        rs1_data: rf_rs1_data         ,
        rs2_data: rf_rs2_data         ,
    );

    // Main 32-bit ALU
    inst main_alu: rv32i_alu (
        a     : alu_operand_a,
        b     : alu_operand_b,
        alu_op: alu_ctrl     ,
        result: alu_result   ,
        zero  : alu_zero     ,
    );

    // Control and Status Registers (CSR)
    inst csrs_inst: rv32i_csrs (
        clk         : clk                                    ,
        rst         : rst                                    ,
        soft_rst    : soft_rst                               ,
        csr_addr    : rv_csr_addr                            ,
        csr_wdata   : if rv_funct3[2] ? rv_uimm : rf_rs1_data,
        csr_op      : if csr_access ? rv_funct3 : 3'b000,
        csr_rdata   : csr_rdata                              ,
        trap_entry  : trap_entry                             ,
        trap_cause  : trap_cause                             ,
        trap_pc     : pc_reg                                 ,
        trap_val    : trap_val                               ,
        trap_return : trap_return                            ,
        timer_irq_in: timer_irq_in                           ,
        ext_irq_in  : ext_irq_in                             ,
        sw_irq_in   : sw_irq_in                              ,
        irq_pending : irq_pending                            ,
        irq_cause   : irq_cause                              ,
        mtvec_out   : mtvec_out                              ,
        mepc_out    : mepc_out                               ,
    );

    // The cycle a Hack instruction writes its results: EXECUTE, or HACK_WB when the comp reads M
    let hack_writeback: logic = if h_use_mem ? state == CpuState::HACK_WB : state == CpuState::EXECUTE;
    let hack_dual_dest: logic = !is_riscv_mode && h_we_reg_a && h_we_reg_d;

    // Combinational Execution Datapath
    always_comb {
        rv_op  = rv_opcode as rv32i_pkg::Opcode;
        rv_f3  = rv_funct3 as rv32i_pkg::Funct3;
        csr_we = 1'b0;

        // Branch & Jump Condition Evaluation (Direct Comparators for Minimum Critical Path Delay)
        let rs_eq : logic = rf_rs1_data == rf_rs2_data;
        let rs_lt : logic = (rf_rs1_data as i32) <: (rf_rs2_data as i32);
        let rs_ltu: logic = (rf_rs1_data as u32) <: (rf_rs2_data as u32);
        case rv_f3 {
            rv32i_pkg::Funct3::ADD_SUB: rv_branch_take = rs_eq; // BEQ
            rv32i_pkg::Funct3::SLL    : rv_branch_take = !rs_eq; // BNE
            rv32i_pkg::Funct3::XOR    : rv_branch_take = rs_lt; // BLT
            rv32i_pkg::Funct3::SRL_SRA: rv_branch_take = !rs_lt; // BGE
            rv32i_pkg::Funct3::OR     : rv_branch_take = rs_ltu; // BLTU
            rv32i_pkg::Funct3::AND    : rv_branch_take = !rs_ltu; // BGEU
            default                   : rv_branch_take = 1'b0;
        }

        // Hack Jump Conditions
        let h_zero: logic = alu_result[15:0] == 16'd0;
        let h_neg : logic = alu_result[15];
        case h_jump_cond {
            3'b001 : hack_jump_take = (!h_zero) && (!h_neg); // JGT
            3'b010 : hack_jump_take = h_zero; // JEQ
            3'b011 : hack_jump_take = (!h_neg); // JGE
            3'b100 : hack_jump_take = h_neg; // JLT
            3'b101 : hack_jump_take = !h_zero; // JNE
            3'b110 : hack_jump_take = h_neg || h_zero; // JLE
            3'b111 : hack_jump_take = 1'b1; // JMP
            default: hack_jump_take = 1'b0;
        }

        // Sub-word Load Steering
        case r_load_f3 {
            rv32i_pkg::Funct3::ADD_SUB: { // LB
                case r_load_byte_sel {
                    2'd0   : load_val = {data_in[7] repeat 24, data_in[7:0]};
                    2'd1   : load_val = {data_in[15] repeat 24, data_in[15:8]};
                    2'd2   : load_val = {data_in[23] repeat 24, data_in[23:16]};
                    default: load_val = {data_in[31] repeat 24, data_in[31:24]};
                }
            }
            rv32i_pkg::Funct3::XOR: { // LBU
                case r_load_byte_sel {
                    2'd0   : load_val = {24'd0, data_in[7:0]};
                    2'd1   : load_val = {24'd0, data_in[15:8]};
                    2'd2   : load_val = {24'd0, data_in[23:16]};
                    default: load_val = {24'd0, data_in[31:24]};
                }
            }
            rv32i_pkg::Funct3::SLL: { // LH
                if r_load_byte_sel[1] == 1'b0 {
                    load_val = {data_in[15] repeat 16, data_in[15:0]};
                } else {
                    load_val = {data_in[31] repeat 16, data_in[31:16]};
                }
            }
            rv32i_pkg::Funct3::SRL_SRA: { // LHU
                if r_load_byte_sel[1] == 1'b0 {
                    load_val = {16'd0, data_in[15:0]};
                } else {
                    load_val = {16'd0, data_in[31:16]};
                }
            }
            default: { // LW
                load_val = data_in;
            }
        }

        if is_riscv_mode {
            // RISC-V Mode
            rf_we2      = 1'b0;
            rf_rd2_addr = 5'd0;
            rf_wr2_data = 32'd0;

            case rv_op {
                rv32i_pkg::Opcode::AUIPC: {
                    alu_operand_a = pc_reg;
                    alu_operand_b = rv_imm;
                    alu_ctrl      = rv32i_pkg::AluOp::ADD;
                }
                rv32i_pkg::Opcode::LUI: {
                    alu_operand_a = 32'd0;
                    alu_operand_b = rv_imm;
                    alu_ctrl      = rv32i_pkg::AluOp::COPY_B;
                }
                rv32i_pkg::Opcode::I_TYPE: {
                    alu_operand_a = rf_rs1_data;
                    alu_operand_b = rv_imm;
                    case rv_f3 {
                        rv32i_pkg::Funct3::ADD_SUB: alu_ctrl = rv32i_pkg::AluOp::ADD;
                        rv32i_pkg::Funct3::SLL    : alu_ctrl = rv32i_pkg::AluOp::SLL;
                        rv32i_pkg::Funct3::SLT    : alu_ctrl = rv32i_pkg::AluOp::SLT;
                        rv32i_pkg::Funct3::SLTU   : alu_ctrl = rv32i_pkg::AluOp::SLTU;
                        rv32i_pkg::Funct3::XOR    : alu_ctrl = rv32i_pkg::AluOp::XOR;
                        rv32i_pkg::Funct3::SRL_SRA: if rv_funct7[5] {
                            alu_ctrl = rv32i_pkg::AluOp::SRA;
                        } else {
                            alu_ctrl = rv32i_pkg::AluOp::SRL;
                        }
                        rv32i_pkg::Funct3::OR     : alu_ctrl = rv32i_pkg::AluOp::OR;
                        rv32i_pkg::Funct3::AND    : alu_ctrl = rv32i_pkg::AluOp::AND;
                        default                   : alu_ctrl = rv32i_pkg::AluOp::ADD;
                    }
                }
                rv32i_pkg::Opcode::LOAD: {
                    alu_operand_a = 32'd0;
                    alu_operand_b = 32'd0;
                    alu_ctrl      = rv32i_pkg::AluOp::ADD;
                }
                rv32i_pkg::Opcode::STORE: {
                    alu_operand_a = 32'd0;
                    alu_operand_b = 32'd0;
                    alu_ctrl      = rv32i_pkg::AluOp::ADD;
                }
                rv32i_pkg::Opcode::JALR: {
                    alu_operand_a = 32'd0;
                    alu_operand_b = 32'd0;
                    alu_ctrl      = rv32i_pkg::AluOp::ADD;
                }
                rv32i_pkg::Opcode::R_TYPE: {
                    alu_operand_a = rf_rs1_data;
                    alu_operand_b = rf_rs2_data;
                    case rv_f3 {
                        rv32i_pkg::Funct3::ADD_SUB: if rv_funct7[5] {
                            alu_ctrl = rv32i_pkg::AluOp::SUB;
                        } else {
                            alu_ctrl = rv32i_pkg::AluOp::ADD;
                        }
                        rv32i_pkg::Funct3::SLL    : alu_ctrl = rv32i_pkg::AluOp::SLL;
                        rv32i_pkg::Funct3::SLT    : alu_ctrl = rv32i_pkg::AluOp::SLT;
                        rv32i_pkg::Funct3::SLTU   : alu_ctrl = rv32i_pkg::AluOp::SLTU;
                        rv32i_pkg::Funct3::XOR    : alu_ctrl = rv32i_pkg::AluOp::XOR;
                        rv32i_pkg::Funct3::SRL_SRA: if rv_funct7[5] {
                            alu_ctrl = rv32i_pkg::AluOp::SRA;
                        } else {
                            alu_ctrl = rv32i_pkg::AluOp::SRL;
                        }
                        rv32i_pkg::Funct3::OR     : alu_ctrl = rv32i_pkg::AluOp::OR;
                        rv32i_pkg::Funct3::AND    : alu_ctrl = rv32i_pkg::AluOp::AND;
                        default                   : alu_ctrl = rv32i_pkg::AluOp::ADD;
                    }
                }
                rv32i_pkg::Opcode::BRANCH: {
                    alu_operand_a = rf_rs1_data;
                    alu_operand_b = rf_rs2_data;
                    alu_ctrl      = rv32i_pkg::AluOp::SUB;
                }
                default: {
                    alu_operand_a = 32'd0;
                    alu_operand_b = 32'd0;
                    alu_ctrl      = rv32i_pkg::AluOp::ADD;
                }
            }

            // Sub-word Store Steering (Fast 2-bit addition for byte steering)
            let rv_mem_addr_low: logic<2> = rf_rs1_data[1:0] + rv_imm[1:0];
            if rv_op == rv32i_pkg::Opcode::STORE {
                case rv_f3 {
                    rv32i_pkg::Funct3::ADD_SUB: { // SB
                        r_data_out = {rf_rs2_data[7:0] repeat 4};
                        case rv_mem_addr_low {
                            2'b00  : r_mem_byte_we = 4'b0001;
                            2'b01  : r_mem_byte_we = 4'b0010;
                            2'b10  : r_mem_byte_we = 4'b0100;
                            default: r_mem_byte_we = 4'b1000;
                        }
                    }
                    rv32i_pkg::Funct3::SLL: { // SH
                        r_data_out = {rf_rs2_data[15:0] repeat 2};
                        if rv_mem_addr_low[1] == 1'b0 {
                            r_mem_byte_we = 4'b0011;
                        } else {
                            r_mem_byte_we = 4'b1100;
                        }
                    }
                    default: { // SW
                        r_data_out    = rf_rs2_data;
                        r_mem_byte_we = 4'b1111;
                    }
                }
            } else {
                r_data_out    = rf_rs2_data;
                r_mem_byte_we = 4'b1111;
            }

            // Writeback
            if state == CpuState::MEM_WAIT {
                if r_load_we {
                    rf_rd_addr = r_load_rd;
                    rf_we      = 1'b1;
                    rf_wr_data = load_val;
                } else {
                    rf_rd_addr = 5'd0;
                    rf_we      = 1'b0;
                    rf_wr_data = 32'd0;
                }
            } else {
                rf_rd_addr = rv_rd;
                case rv_op {
                    rv32i_pkg::Opcode::R_TYPE: {
                        rf_we      = if (state == CpuState::EXECUTE) ? 1'b1 : 1'b0;
                        rf_wr_data = alu_result;
                    }
                    rv32i_pkg::Opcode::I_TYPE: {
                        rf_we      = if (state == CpuState::EXECUTE) ? 1'b1 : 1'b0;
                        rf_wr_data = alu_result;
                    }
                    rv32i_pkg::Opcode::LUI: {
                        rf_we      = if (state == CpuState::EXECUTE) ? 1'b1 : 1'b0;
                        rf_wr_data = alu_result;
                    }
                    rv32i_pkg::Opcode::AUIPC: {
                        rf_we      = if (state == CpuState::EXECUTE) ? 1'b1 : 1'b0;
                        rf_wr_data = alu_result;
                    }
                    rv32i_pkg::Opcode::JAL: {
                        rf_we      = if (state == CpuState::EXECUTE) ? 1'b1 : 1'b0;
                        rf_wr_data = pc_plus_4_reg;
                    }
                    rv32i_pkg::Opcode::JALR: {
                        rf_we      = if (state == CpuState::EXECUTE) ? 1'b1 : 1'b0;
                        rf_wr_data = pc_plus_4_reg;
                    }
                    rv32i_pkg::Opcode::SYSTEM: {
                        if rv_funct3 != rv32i_pkg::FUNCT3_PRIV {
                            rf_we      = if (state == CpuState::EXECUTE) ? 1'b1 : 1'b0;
                            rf_wr_data = csr_rdata;
                        } else {
                            rf_we      = 1'b0;
                            rf_wr_data = 32'd0;
                        }
                    }
                    default: {
                        rf_we      = 1'b0;
                        rf_wr_data = 32'd0;
                    }
                }
            }

            r_mem_write = if (rv_op == rv32i_pkg::Opcode::STORE && state == CpuState::EXECUTE) ? 1'b1 : 1'b0;

        } else {
            // Hack Mode: A is x1 (write port 1), D is x2 (write port 2). The register
            // file writes one port per cycle, so an instruction writing both A and D
            // writes A now and D from r_hack_d in the extra HACK_WR_D cycle.
            rf_rd_addr  = 5'd1;
            rf_we       = hack_writeback && h_we_reg_a;
            rf_wr_data  = alu_result;
            rf_rd2_addr = 5'd2;
            rf_we2      = (hack_writeback && h_we_reg_d && !h_we_reg_a) || state == CpuState::HACK_WR_D;
            rf_wr2_data = if state == CpuState::HACK_WR_D ? r_hack_d : alu_result;

            let y_val: logic<32> = if h_use_mem ? r_hack_data : rf_rs2_data;
            case h_op_a_sel {
                2'd0   : alu_operand_a = rf_rs1_data; // D
                2'd1   : alu_operand_a = y_val; // A or M
                default: alu_operand_a = 32'd0; // ZERO
            }
            case h_op_b_sel {
                2'd0   : alu_operand_b = y_val; // A or M
                2'd1   : alu_operand_b = rf_rs1_data; // D
                default: alu_operand_b = h_imm; // IMM
            }

            alu_ctrl      = h_alu_op;
            r_data_out    = alu_result;
            r_mem_byte_we = 4'b1111;
            r_mem_write   = if (state == CpuState::EXECUTE) ?
                (h_we_mem && !h_use_mem)
            :
                (if (state == CpuState::HACK_WB) ? r_hack_mem_we : 1'b0)
            ;
        }
    }

    // RV32I legality & SYSTEM decode (from ir_reg). Unimplemented CSR addresses stay
    // legal (read 0, writes ignored); a write to a read-only CSR (addr[11:10] == 3,
    // e.g. `unimp` = csrrw x0, cycle, x0) is illegal.
    let ir_f7     : logic<7> = ir_reg[31:25];
    let csr_writes: logic    = rv_funct3[1:0] == 2'b01 || rv_rs1 != 5'd0; // CSRRW[I], or non-zero rs1/uimm
    let csr_ro_wr : logic    = rv_csr_addr[11:10] == 2'b11 && csr_writes;
    always_comb {
        is_ecall  = ir_reg == 32'h0000_0073;
        is_ebreak = ir_reg == 32'h0010_0073;
        is_mret   = ir_reg == 32'h3020_0073;
        case rv_op {
            rv32i_pkg::Opcode::LUI, rv32i_pkg::Opcode::AUIPC, rv32i_pkg::Opcode::JAL: is_illegal = 1'b0;
            rv32i_pkg::Opcode::JALR                                                 : is_illegal = rv_funct3 != 3'b000;
            rv32i_pkg::Opcode::BRANCH                                               : is_illegal = rv_funct3[2:1]
                == 2'b01;
            rv32i_pkg::Opcode::LOAD                                                 : is_illegal = rv_funct3 == 3'b011
                || rv_funct3[2:1] == 2'b11;
            rv32i_pkg::Opcode::STORE                                                : is_illegal = rv_funct3[2]
                || rv_funct3[1:0] == 2'b11;
            rv32i_pkg::Opcode::I_TYPE                                               : {
                case rv_funct3 {
                    3'b001 : is_illegal = ir_f7 != 7'b000_0000; // SLLI (shamt[5] must be 0)
                    3'b101 : is_illegal = ir_f7 != 7'b000_0000 && ir_f7 != 7'b010_0000; // SRLI/SRAI
                    default: is_illegal = 1'b0;
                }
            }
            rv32i_pkg::Opcode::R_TYPE: is_illegal = !(ir_f7 == 7'b000_0000
                || (ir_f7 == 7'b010_0000 && (rv_funct3 == 3'b000 || rv_funct3 == 3'b101)));
            rv32i_pkg::Opcode::FENCE : is_illegal = rv_funct3[2:1] != 2'b00; // FENCE / FENCE.I (no-ops)
            rv32i_pkg::Opcode::SYSTEM: {
                if rv_funct3 == 3'b000 {
                    // ECALL / EBREAK / MRET / WFI (WFI is a no-op)
                    is_illegal = !(is_ecall || is_ebreak || is_mret || ir_reg == 32'h1050_0073);
                } else {
                    is_illegal = rv_funct3 == 3'b100 || csr_ro_wr;
                }
            }
            default: is_illegal = 1'b1; // includes 0x0000_0000
        }
    }

    // Trap evaluation (RISC-V mode, EXECUTE only, so each trap is a one-cycle pulse).
    // Priority: interrupt > illegal > misaligned fetch > ECALL/EBREAK > misaligned load/store.
    // A trapping instruction has no side effects: no register/CSR write, no memory access.
    let exec_rv     : logic    = is_riscv_mode && state == CpuState::EXECUTE;
    let mem_addr_low: logic<2> = rf_rs1_data[1:0] + rv_imm[1:0];
    always_comb {
        case rv_op {
            rv32i_pkg::Opcode::JAL   : fetch_misalign = rv_imm[1];
            rv32i_pkg::Opcode::BRANCH: fetch_misalign = rv_imm[1] && rv_branch_take;
            rv32i_pkg::Opcode::JALR  : fetch_misalign = mem_addr_low[1];
            default                  : fetch_misalign = 1'b0;
        }
        if rv_op == rv32i_pkg::Opcode::LOAD || rv_op == rv32i_pkg::Opcode::STORE {
            case rv_funct3[1:0] {
                2'b01  : mem_misalign = mem_addr_low[0]; // LH/LHU/SH
                2'b10  : mem_misalign = mem_addr_low != 2'b00; // LW/SW
                default: mem_misalign = 1'b0;
            }
        } else {
            mem_misalign = 1'b0;
        }

        trap_entry  = 1'b0;
        trap_cause  = 32'd0;
        trap_val    = 32'd0;
        trap_return = 1'b0;
        if exec_rv {
            if r_irq {
                trap_entry = 1'b1;
                trap_cause = r_irq_cause;
            } else if is_illegal {
                trap_entry = 1'b1;
                trap_cause = 32'd2;
                trap_val   = ir_reg;
            } else if fetch_misalign {
                trap_entry = 1'b1;
                trap_cause = 32'd0;
                trap_val   = if rv_op == rv32i_pkg::Opcode::JALR ? jalr_target : (pc_reg as u32 + rv_imm as u32) as u32;
            } else if is_ecall {
                trap_entry = 1'b1;
                trap_cause = 32'd11;
            } else if is_ebreak {
                trap_entry = 1'b1;
                trap_cause = 32'd3;
                trap_val   = pc_reg;
            } else if mem_misalign {
                trap_entry = 1'b1;
                trap_cause = if rv_op == rv32i_pkg::Opcode::LOAD ? 32'd4 : 32'd6;
                trap_val   = rv_mem_addr;
            } else {
                trap_return = is_mret;
            }
        }
        csr_access = exec_rv && rv_op == rv32i_pkg::Opcode::SYSTEM && !trap_entry;
    }

    // Next PC Calculation (Shared PC-Relative Adder)

    always_comb {
        is_branch_taken = (rv_op == rv32i_pkg::Opcode::BRANCH) && rv_branch_take;
        let pc_plus_imm    : logic<32> = (pc_reg as u32 + rv_imm as u32) as u32;
        jalr_target     = ((rv_mem_addr as u32) & 32'hffff_fffe) as u32;

        if is_riscv_mode {
            if state == CpuState::MEM_WAIT {
                next_pc = pc_plus_4_reg;
            } else if trap_entry {
                next_pc = mtvec_out;
            } else if trap_return {
                next_pc = mepc_out;
            } else {
                case rv_op {
                    rv32i_pkg::Opcode::BRANCH: next_pc = if rv_branch_take ? pc_plus_imm : pc_plus_4_reg;
                    rv32i_pkg::Opcode::JAL   : next_pc = pc_plus_imm;
                    rv32i_pkg::Opcode::JALR  : next_pc = jalr_target;
                    default                  : next_pc = pc_plus_4_reg;
                }
            }
        } else {
            if state == CpuState::MEM_WAIT {
                next_pc = (pc_reg as u32 + 2) as u32;
            } else if hack_jump_take {
                next_pc = (((rf_rs2_data as u32) << 1) as u32);
            } else {
                next_pc = (pc_reg as u32 + 2) as u32;
            }
        }
    }

    // Multi-Cycle CPU State Machine & PC Update
    always_ff (clk, rst) {
        if_reset {
            state           = CpuState::FETCH;
            r_irq           = 1'b0;
            r_irq_cause     = 32'd0;
            pc_reg          = RESET_VECTOR;
            pc_plus_4_reg   = (RESET_VECTOR as u32 + 4) as u32;
            ir_reg          = 32'h0000_0013; // NOP
            r_load_byte_sel = 2'd0;
            r_load_f3       = rv32i_pkg::Funct3::ADD_SUB;
            r_load_rd       = 5'd0;
            r_store_addr    = 32'd0;
            r_store_data    = 32'd0;
            r_store_byte_we = 4'd0;
            r_store_we      = 1'b0;
            r_load_we       = 1'b0;
            r_hack_mem_we   = 1'b0;
            r_hack_data     = 32'd0;
            r_hack_d        = 32'd0;
        } else if soft_rst {
            state           = CpuState::FETCH;
            r_irq           = 1'b0;
            r_irq_cause     = 32'd0;
            pc_reg          = RESET_VECTOR;
            pc_plus_4_reg   = (RESET_VECTOR as u32 + 4) as u32;
            ir_reg          = 32'h0000_0013; // NOP
            r_load_byte_sel = 2'd0;
            r_load_f3       = rv32i_pkg::Funct3::ADD_SUB;
            r_load_rd       = 5'd0;
            r_store_addr    = 32'd0;
            r_store_data    = 32'd0;
            r_store_byte_we = 4'd0;
            r_store_we      = 1'b0;
            r_load_we       = 1'b0;
            r_hack_mem_we   = 1'b0;
            r_hack_data     = 32'd0;
            r_hack_d        = 32'd0;
        } else {
            case state {
                CpuState::FETCH: {
                    // Latch fetched instruction from synchronous BRAM
                    ir_reg        = instr_in;
                    r_store_we    = 1'b0;
                    r_load_we     = 1'b0;
                    r_hack_mem_we = 1'b0;
                    pc_plus_4_reg = (pc_reg as u32 + 4) as u32;
                    r_irq         = irq_pending && is_riscv_mode;
                    r_irq_cause   = irq_cause;
                    state         = CpuState::EXECUTE;
                }
                CpuState::EXECUTE: {
                    if trap_entry || trap_return {
                        r_store_we    = 1'b0;
                        r_load_we     = 1'b0;
                        r_hack_mem_we = 1'b0;
                        pc_reg        = next_pc;
                        state         = CpuState::FETCH;
                    } else if is_riscv_mode && rv_op == rv32i_pkg::Opcode::LOAD {
                        // 1 cycle wait for synchronous D-RAM read
                        r_store_addr    = rv_mem_addr;
                        r_load_byte_sel = rf_rs1_data[1:0] + rv_imm[1:0];
                        r_load_f3       = rv_f3;
                        r_load_rd       = rv_rd;
                        r_load_we       = 1'b1;
                        r_store_we      = 1'b0;
                        r_hack_mem_we   = 1'b0;
                        state           = CpuState::MEM_WAIT;
                    } else if is_riscv_mode && rv_op == rv32i_pkg::Opcode::STORE {
                        // 1 cycle wait for store data/address stabilization
                        r_store_addr    = rv_mem_addr;
                        r_store_data    = r_data_out;
                        r_store_byte_we = r_mem_byte_we;
                        r_store_we      = 1'b1;
                        r_load_we       = 1'b0;
                        r_hack_mem_we   = 1'b0;
                        state           = CpuState::MEM_WAIT;
                    } else if !is_riscv_mode && h_use_mem {
                        r_store_we    = 1'b0;
                        r_load_we     = 1'b0;
                        r_hack_mem_we = h_we_mem;
                        state         = CpuState::MEM_WAIT;
                    } else {
                        r_store_we    = 1'b0;
                        r_load_we     = 1'b0;
                        r_hack_mem_we = 1'b0;
                        pc_reg        = next_pc;
                        r_hack_d      = alu_result;
                        if hack_dual_dest {
                            state = CpuState::HACK_WR_D;
                        } else {
                            state = CpuState::FETCH;
                        }
                    }
                }
                CpuState::MEM_WAIT: {
                    r_store_we = 1'b0;
                    r_load_we  = 1'b0;
                    if is_riscv_mode {
                        r_hack_mem_we = 1'b0;
                        pc_reg        = pc_plus_4_reg;
                        state         = CpuState::FETCH;
                    } else {
                        // Latch memory read data for Hack ALU pipeline stage
                        r_hack_data = data_in;
                        state       = CpuState::HACK_WB;
                    }
                }
                CpuState::HACK_WB: {
                    r_store_we    = 1'b0;
                    r_load_we     = 1'b0;
                    r_hack_mem_we = 1'b0;
                    pc_reg        = next_pc;
                    r_hack_d      = alu_result;
                    if hack_dual_dest {
                        state = CpuState::HACK_WR_D;
                    } else {
                        state = CpuState::FETCH;
                    }
                }
                CpuState::HACK_WR_D: {
                    state = CpuState::FETCH;
                }
                default: {
                    state = CpuState::FETCH;
                }
            }
        }
    }
}
