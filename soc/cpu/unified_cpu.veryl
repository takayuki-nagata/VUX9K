// Unified Dual-ISA CPU Core (RISC-V 32-bit + Hack 16-bit) in Veryl
// Robust 2-Stage Multi-Cycle FSM Architecture (Fetch -> Execute) for 100% Gowin FPGA Synchronous Block RAM Compatibility
pub module unified_cpu #(
    param RESET_VECTOR: u32 = 32'h0000_0000,
) (
    clk         : input  clock    ,
    rst         : input  reset    ,
    soft_rst    : input  logic    ,
    instr_in    : input  logic<32>,
    data_in     : input  logic<32>,
    timer_irq_in: input  logic    ,
    ext_irq_in  : input  logic    ,
    sw_irq_in   : input  logic    ,
    pc_out      : output logic<32>,
    data_addr   : output logic<32>,
    data_waddr  : output logic<32>,
    data_out    : output logic<32>,
    mem_write   : output logic    ,
    mem_read_req: output logic    ,
    mem_byte_we : output logic<4> ,
    active_mode : output logic    , // 0: Hack 16-bit, 1: RISC-V 32-bit
) {
    enum CpuState {
        FETCH,
        EXECUTE,
        MEM_WAIT,
        HACK_WB,
        HACK_WR_D, // second write-back cycle of a Hack AD=/AMD= instruction (writes D)
    }

    var state        : CpuState    ;
    var r_load_we    : logic       ;
    var r_hack_data  : logic   <32>;
    var r_hack_d     : logic   <32>; // D value waiting for HACK_WR_D
    var is_riscv_mode: logic       ;
    // A data read completes in MEM_WAIT: an RV32 load, or a Hack comp reading M
    // (Hack mode enters MEM_WAIT only for that). Peripherals with read side effects
    // (UART RX pop) act on this, not on the address alone.
    assign mem_read_req = state == CpuState::MEM_WAIT && (if is_riscv_mode ? r_load_we : 1'b1);
    var pc_reg       : logic<32>;
    var pc_plus_4_reg: logic<32>;
    var next_pc      : logic<32>;
    var ir_reg       : logic<32>; // Instruction Register

    // Hack Translator signals
    var h_imm      : logic           <32>;
    var h_alu_op   : rv32i_pkg::AluOp    ;
    var h_use_mem  : logic               ;
    var h_we_reg_a : logic               ;
    var h_we_reg_d : logic               ;
    var h_we_mem   : logic               ;
    var h_jump_cond: logic           <3> ;
    var h_op_a_sel : logic           <2> ;
    var h_op_b_sel : logic           <2> ;

    // RV32I Decoder signals
    var rv_opcode  : logic<7> ;
    var rv_rd      : logic<5> ;
    var rv_funct3  : logic<3> ;
    var rv_rs1     : logic<5> ;
    var rv_rs2     : logic<5> ;
    var rv_funct7  : logic<7> ;
    var rv_imm     : logic<32>;
    var rv_csr_addr: logic<12>;
    var rv_uimm    : logic<32>;

    var rf_rs1_addr: logic<5>;
    var rf_rs2_addr: logic<5>;
    // Hack mode always reads D (x2) and A (x1) unconditionally: keeping these
    // addresses constant (not instruction-dependent) keeps hack_translator's
    // decode logic off the register-file-read -> ALU critical path. Operand
    // selection among {D, A/M, ZERO, IMM} happens downstream via op_a_sel/op_b_sel.
    assign rf_rs1_addr = if is_riscv_mode ? rv_rs1 : 5'd2;
    assign rf_rs2_addr = if is_riscv_mode ? rv_rs2 : 5'd1;
    var rf_rd_addr : logic<5> ;
    var rf_we      : logic    ;
    var rf_wr_data : logic<32>;
    var rf_rd2_addr: logic<5> ;
    var rf_we2     : logic    ;
    var rf_wr2_data: logic<32>;
    var rf_rs1_data: logic<32>;
    var rf_rs2_data: logic<32>;

    // ALU Signals
    var alu_operand_a: logic           <32>;
    var alu_operand_b: logic           <32>;
    var alu_ctrl     : rv32i_pkg::AluOp    ;
    var alu_result   : logic           <32>;

    // CSR Module Signals
    var csr_rdata  : logic<32>;
    var trap_entry : logic    ;
    var trap_cause : logic<32>;
    var trap_val   : logic<32>;
    var trap_return: logic    ;
    var irq_pending: logic    ;
    var irq_cause  : logic<32>;
    var mtvec_out  : logic<32>;
    var mepc_out   : logic<32>;
    var r_irq      : logic    ; // interrupt sampled in FETCH, taken in EXECUTE
    var r_irq_cause: logic<32>;
    var csr_access : logic    ;

    // Trap / next-PC helpers
    var jalr_target: logic<32>;

    // Internal Helper Signals
    var load_val       : logic            <32>;
    var r_load_byte_sel: logic            <2> ;
    var r_load_f3      : rv32i_pkg::Funct3    ;
    var r_load_rd      : logic            <5> ;
    var r_store_addr   : logic            <32>;
    var r_store_data   : logic            <32>;
    var r_store_byte_we: logic            <4> ;
    var r_store_we     : logic                ;
    var r_hack_mem_we  : logic                ;
    var r_mem_byte_we  : logic            <4> ;
    var r_data_out     : logic            <32>;
    var rv_branch_take : logic                ;
    var rv_op          : rv32i_pkg::Opcode    ;
    var rv_f3          : rv32i_pkg::Funct3    ;
    var rv_alu_op      : rv32i_pkg::AluOp     ; // ALU operation of OP / OP-IMM

    assign active_mode = is_riscv_mode;
    // pc_reg is already final in HACK_WR_D (updated in the cycle before it)
    assign pc_out = if state == CpuState::FETCH || state == CpuState::HACK_WR_D ? pc_reg : next_pc;
    let rv_mem_addr: logic<32> = rf_rs1_data + rv_imm;
    // Low bits of the effective address from a 2-bit add, so byte-lane steering and
    // misalignment checks don't wait for the full 32-bit adder
    let mem_addr_low: logic<2> = rf_rs1_data[1:0] + rv_imm[1:0];
    assign data_addr   = if is_riscv_mode ? rv_mem_addr : rf_rs2_data;
    assign data_waddr  = if is_riscv_mode ? r_store_addr : rf_rs2_data;
    assign data_out    = if is_riscv_mode ? r_store_data : r_data_out;
    assign mem_byte_we = if is_riscv_mode ? r_store_byte_we : r_mem_byte_we;
    assign mem_write   = if is_riscv_mode ?
        r_store_we
    :
        (if (state == CpuState::HACK_WB) ?
            r_hack_mem_we
        :
            (if (state == CpuState::EXECUTE) ? (h_we_mem && !h_use_mem) : 1'b0)
        )
    ;

    inst mode_detect: auto_mode_detector (
        clk          : clk          ,
        rst          : rst          ,
        soft_rst     : soft_rst     ,
        first_instr  : instr_in     ,
        is_riscv_mode: is_riscv_mode,
    );

    // Hack Translator (16-bit Front-End)
    var h_instr_16: logic<16>;
    assign h_instr_16 = if pc_reg[1] ? ir_reg[31:16] : ir_reg[15:0];

    inst hack_trans: hack_translator (
        instr_16 : h_instr_16 ,
        imm      : h_imm      ,
        alu_op   : h_alu_op   ,
        use_mem  : h_use_mem  ,
        we_reg_a : h_we_reg_a ,
        we_reg_d : h_we_reg_d ,
        we_mem   : h_we_mem   ,
        jump_cond: h_jump_cond,
        op_a_sel : h_op_a_sel ,
        op_b_sel : h_op_b_sel ,
    );

    // RV32I Instruction Decoder
    inst rv_decode: rv32i_decode (
        instruction: ir_reg     ,
        opcode     : rv_opcode  ,
        rd         : rv_rd      ,
        funct3     : rv_funct3  ,
        rs1        : rv_rs1     ,
        rs2        : rv_rs2     ,
        funct7     : rv_funct7  ,
        imm        : rv_imm     ,
        csr_addr   : rv_csr_addr,
        uimm       : rv_uimm    ,
    );

    // Dual-Port Register File
    inst reg_file: rv32i_regfile (
        clk     : clk                 ,
        rst     : rst                 ,
        we      : rf_we && !trap_entry,
        rd_addr : rf_rd_addr          ,
        wr_data : rf_wr_data          ,
        we2     : rf_we2              ,
        rd2_addr: rf_rd2_addr         ,
        wr2_data: rf_wr2_data         ,
        rs1_addr: rf_rs1_addr         ,
        rs2_addr: rf_rs2_addr         ,
        rs1_data: rf_rs1_data         ,
        rs2_data: rf_rs2_data         ,
    );

    // Main 32-bit ALU
    inst main_alu: rv32i_alu (
        a     : alu_operand_a,
        b     : alu_operand_b,
        alu_op: alu_ctrl     ,
        result: alu_result   ,
    );

    // Load/store data alignment
    var lsu_store_data: logic<32>;
    var lsu_store_we  : logic<4> ;
    inst lsu: rv32i_lsu (
        store_f3  : rv_f3          ,
        store_src : rf_rs2_data    ,
        addr_low  : mem_addr_low   ,
        store_data: lsu_store_data ,
        store_we  : lsu_store_we   ,
        load_f3   : r_load_f3      ,
        load_sel  : r_load_byte_sel,
        load_word : data_in        ,
        load_val  : load_val       ,
    );

    // Control and Status Registers (CSR)
    inst csrs_inst: rv32i_csrs (
        clk         : clk                                    ,
        rst         : rst                                    ,
        soft_rst    : soft_rst                               ,
        csr_addr    : rv_csr_addr                            ,
        csr_wdata   : if rv_funct3[2] ? rv_uimm : rf_rs1_data,
        csr_op      : if csr_access ? rv_funct3 : 3'b000,
        csr_rdata   : csr_rdata                              ,
        trap_entry  : trap_entry                             ,
        trap_cause  : trap_cause                             ,
        trap_pc     : pc_reg                                 ,
        trap_val    : trap_val                               ,
        trap_return : trap_return                            ,
        timer_irq_in: timer_irq_in                           ,
        ext_irq_in  : ext_irq_in                             ,
        sw_irq_in   : sw_irq_in                              ,
        irq_pending : irq_pending                            ,
        irq_cause   : irq_cause                              ,
        mtvec_out   : mtvec_out                              ,
        mepc_out    : mepc_out                               ,
    );

    // The cycle a Hack instruction writes its results: EXECUTE, or HACK_WB when the comp reads M
    let hack_writeback: logic = if h_use_mem ? state == CpuState::HACK_WB : state == CpuState::EXECUTE;
    let hack_dual_dest: logic = !is_riscv_mode && h_we_reg_a && h_we_reg_d;

    // Combinational Execution Datapath
    always_comb {
        rv_op = rv_opcode as rv32i_pkg::Opcode;
        rv_f3 = rv_funct3 as rv32i_pkg::Funct3;

        // OP and OP-IMM share one funct3 decode. funct7[5] selects SRA over SRL, and SUB
        // over ADD for OP only (in ADDI it is an immediate bit).
        case rv_f3 {
            rv32i_pkg::Funct3::ADD_SUB: if rv_op == rv32i_pkg::Opcode::R_TYPE && rv_funct7[5] {
                rv_alu_op = rv32i_pkg::AluOp::SUB;
            } else {
                rv_alu_op = rv32i_pkg::AluOp::ADD;
            }
            rv32i_pkg::Funct3::SLL    : rv_alu_op = rv32i_pkg::AluOp::SLL;
            rv32i_pkg::Funct3::SLT    : rv_alu_op = rv32i_pkg::AluOp::SLT;
            rv32i_pkg::Funct3::SLTU   : rv_alu_op = rv32i_pkg::AluOp::SLTU;
            rv32i_pkg::Funct3::XOR    : rv_alu_op = rv32i_pkg::AluOp::XOR;
            rv32i_pkg::Funct3::SRL_SRA: if rv_funct7[5] {
                rv_alu_op = rv32i_pkg::AluOp::SRA;
            } else {
                rv_alu_op = rv32i_pkg::AluOp::SRL;
            }
            rv32i_pkg::Funct3::OR     : rv_alu_op = rv32i_pkg::AluOp::OR;
            rv32i_pkg::Funct3::AND    : rv_alu_op = rv32i_pkg::AluOp::AND;
            default                   : rv_alu_op = rv32i_pkg::AluOp::ADD;
        }

        if is_riscv_mode {
            // RISC-V Mode
            rf_we2      = 1'b0;
            rf_rd2_addr = 5'd0;
            rf_wr2_data = 32'd0;

            case rv_op {
                rv32i_pkg::Opcode::AUIPC: {
                    alu_operand_a = pc_reg;
                    alu_operand_b = rv_imm;
                    alu_ctrl      = rv32i_pkg::AluOp::ADD;
                }
                rv32i_pkg::Opcode::LUI: {
                    alu_operand_a = 32'd0;
                    alu_operand_b = rv_imm;
                    alu_ctrl      = rv32i_pkg::AluOp::COPY_B;
                }
                rv32i_pkg::Opcode::I_TYPE: {
                    alu_operand_a = rf_rs1_data;
                    alu_operand_b = rv_imm;
                    alu_ctrl      = rv_alu_op;
                }
                rv32i_pkg::Opcode::LOAD: {
                    alu_operand_a = 32'd0;
                    alu_operand_b = 32'd0;
                    alu_ctrl      = rv32i_pkg::AluOp::ADD;
                }
                rv32i_pkg::Opcode::STORE: {
                    alu_operand_a = 32'd0;
                    alu_operand_b = 32'd0;
                    alu_ctrl      = rv32i_pkg::AluOp::ADD;
                }
                rv32i_pkg::Opcode::JALR: {
                    alu_operand_a = 32'd0;
                    alu_operand_b = 32'd0;
                    alu_ctrl      = rv32i_pkg::AluOp::ADD;
                }
                rv32i_pkg::Opcode::R_TYPE: {
                    alu_operand_a = rf_rs1_data;
                    alu_operand_b = rf_rs2_data;
                    alu_ctrl      = rv_alu_op;
                }
                rv32i_pkg::Opcode::BRANCH: {
                    alu_operand_a = rf_rs1_data;
                    alu_operand_b = rf_rs2_data;
                    alu_ctrl      = rv32i_pkg::AluOp::SUB;
                }
                default: {
                    alu_operand_a = 32'd0;
                    alu_operand_b = 32'd0;
                    alu_ctrl      = rv32i_pkg::AluOp::ADD;
                }
            }

            // Store data and byte enables (rv32i_lsu); a non-store drives rs2 on all lanes
            if rv_op == rv32i_pkg::Opcode::STORE {
                r_data_out    = lsu_store_data;
                r_mem_byte_we = lsu_store_we;
            } else {
                r_data_out    = rf_rs2_data;
                r_mem_byte_we = 4'b1111;
            }

            // Writeback
            if state == CpuState::MEM_WAIT {
                if r_load_we {
                    rf_rd_addr = r_load_rd;
                    rf_we      = 1'b1;
                    rf_wr_data = load_val;
                } else {
                    rf_rd_addr = 5'd0;
                    rf_we      = 1'b0;
                    rf_wr_data = 32'd0;
                }
            } else {
                rf_rd_addr = rv_rd;
                case rv_op {
                    rv32i_pkg::Opcode::R_TYPE, rv32i_pkg::Opcode::I_TYPE, rv32i_pkg::Opcode::LUI,
                    rv32i_pkg::Opcode::AUIPC: {
                        rf_we      = if (state == CpuState::EXECUTE) ? 1'b1 : 1'b0;
                        rf_wr_data = alu_result;
                    }
                    rv32i_pkg::Opcode::JAL, rv32i_pkg::Opcode::JALR: {
                        rf_we      = if (state == CpuState::EXECUTE) ? 1'b1 : 1'b0;
                        rf_wr_data = pc_plus_4_reg;
                    }
                    rv32i_pkg::Opcode::SYSTEM: {
                        if rv_funct3 != rv32i_pkg::FUNCT3_PRIV {
                            rf_we      = if (state == CpuState::EXECUTE) ? 1'b1 : 1'b0;
                            rf_wr_data = csr_rdata;
                        } else {
                            rf_we      = 1'b0;
                            rf_wr_data = 32'd0;
                        }
                    }
                    default: {
                        rf_we      = 1'b0;
                        rf_wr_data = 32'd0;
                    }
                }
            }

        } else {
            // Hack Mode: A is x1 (write port 1), D is x2 (write port 2). The register
            // file writes one port per cycle, so an instruction writing both A and D
            // writes A now and D from r_hack_d in the extra HACK_WR_D cycle.
            rf_rd_addr  = 5'd1;
            rf_we       = hack_writeback && h_we_reg_a;
            rf_wr_data  = alu_result;
            rf_rd2_addr = 5'd2;
            rf_we2      = (hack_writeback && h_we_reg_d && !h_we_reg_a) || state == CpuState::HACK_WR_D;
            rf_wr2_data = if state == CpuState::HACK_WR_D ? r_hack_d : alu_result;

            let y_val: logic<32> = if h_use_mem ? r_hack_data : rf_rs2_data;
            case h_op_a_sel {
                2'd0   : alu_operand_a = rf_rs1_data; // D
                2'd1   : alu_operand_a = y_val; // A or M
                default: alu_operand_a = 32'd0; // ZERO
            }
            case h_op_b_sel {
                2'd0   : alu_operand_b = y_val; // A or M
                2'd1   : alu_operand_b = rf_rs1_data; // D
                default: alu_operand_b = h_imm; // IMM
            }

            alu_ctrl      = h_alu_op;
            r_data_out    = alu_result;
            r_mem_byte_we = 4'b1111;
        }
    }

    // Exceptions and interrupts of the instruction in EXECUTE (RV32 mode only)
    let exec_rv: logic = is_riscv_mode && state == CpuState::EXECUTE;
    inst trap: rv32i_trap_unit (
        exec       : exec_rv       ,
        irq        : r_irq         ,
        irq_cause  : r_irq_cause   ,
        instr      : ir_reg        ,
        imm        : rv_imm        ,
        pc         : pc_reg        ,
        branch_take: rv_branch_take,
        addr_low   : mem_addr_low  ,
        jalr_target: jalr_target   ,
        mem_addr   : rv_mem_addr   ,
        trap_entry : trap_entry    ,
        trap_cause : trap_cause    ,
        trap_val   : trap_val      ,
        trap_return: trap_return   ,
    );
    assign csr_access = exec_rv && rv_op == rv32i_pkg::Opcode::SYSTEM && !trap_entry;

    // Next PC (both ISAs), with the branch/jump conditions it depends on
    inst pc_select: next_pc_unit (
        riscv_mode : is_riscv_mode              ,
        mem_wait   : state == CpuState::MEM_WAIT,
        pc         : pc_reg                     ,
        pc_plus_4  : pc_plus_4_reg              ,
        op         : rv_op                      ,
        funct3     : rv_f3                      ,
        imm        : rv_imm                     ,
        rs1        : rf_rs1_data                ,
        rs2        : rf_rs2_data                ,
        mem_addr   : rv_mem_addr                ,
        trap_entry : trap_entry                 ,
        trap_return: trap_return                ,
        mtvec      : mtvec_out                  ,
        mepc       : mepc_out                   ,
        branch_take: rv_branch_take             ,
        jalr_target: jalr_target                ,
        hack_jump  : h_jump_cond                ,
        hack_comp  : alu_result                 ,
        hack_a     : rf_rs2_data                ,
        next_pc    : next_pc                    ,
    );

    // Multi-Cycle CPU State Machine & PC Update
    always_ff (clk, rst) {
        if_reset {
            state           = CpuState::FETCH;
            r_irq           = 1'b0;
            r_irq_cause     = 32'd0;
            pc_reg          = RESET_VECTOR;
            pc_plus_4_reg   = (RESET_VECTOR as u32 + 4) as u32;
            ir_reg          = 32'h0000_0013; // NOP
            r_load_byte_sel = 2'd0;
            r_load_f3       = rv32i_pkg::Funct3::ADD_SUB;
            r_load_rd       = 5'd0;
            r_store_addr    = 32'd0;
            r_store_data    = 32'd0;
            r_store_byte_we = 4'd0;
            r_store_we      = 1'b0;
            r_load_we       = 1'b0;
            r_hack_mem_we   = 1'b0;
            r_hack_data     = 32'd0;
            r_hack_d        = 32'd0;
        } else if soft_rst {
            state           = CpuState::FETCH;
            r_irq           = 1'b0;
            r_irq_cause     = 32'd0;
            pc_reg          = RESET_VECTOR;
            pc_plus_4_reg   = (RESET_VECTOR as u32 + 4) as u32;
            ir_reg          = 32'h0000_0013; // NOP
            r_load_byte_sel = 2'd0;
            r_load_f3       = rv32i_pkg::Funct3::ADD_SUB;
            r_load_rd       = 5'd0;
            r_store_addr    = 32'd0;
            r_store_data    = 32'd0;
            r_store_byte_we = 4'd0;
            r_store_we      = 1'b0;
            r_load_we       = 1'b0;
            r_hack_mem_we   = 1'b0;
            r_hack_data     = 32'd0;
            r_hack_d        = 32'd0;
        } else {
            case state {
                CpuState::FETCH: {
                    // Latch fetched instruction from synchronous BRAM
                    ir_reg        = instr_in;
                    r_store_we    = 1'b0;
                    r_load_we     = 1'b0;
                    r_hack_mem_we = 1'b0;
                    pc_plus_4_reg = (pc_reg as u32 + 4) as u32;
                    r_irq         = irq_pending && is_riscv_mode;
                    r_irq_cause   = irq_cause;
                    state         = CpuState::EXECUTE;
                }
                CpuState::EXECUTE: {
                    if trap_entry || trap_return {
                        r_store_we    = 1'b0;
                        r_load_we     = 1'b0;
                        r_hack_mem_we = 1'b0;
                        pc_reg        = next_pc;
                        state         = CpuState::FETCH;
                    } else if is_riscv_mode && rv_op == rv32i_pkg::Opcode::LOAD {
                        // 1 cycle wait for synchronous D-RAM read
                        r_store_addr    = rv_mem_addr;
                        r_load_byte_sel = mem_addr_low;
                        r_load_f3       = rv_f3;
                        r_load_rd       = rv_rd;
                        r_load_we       = 1'b1;
                        r_store_we      = 1'b0;
                        r_hack_mem_we   = 1'b0;
                        state           = CpuState::MEM_WAIT;
                    } else if is_riscv_mode && rv_op == rv32i_pkg::Opcode::STORE {
                        // 1 cycle wait for store data/address stabilization
                        r_store_addr    = rv_mem_addr;
                        r_store_data    = r_data_out;
                        r_store_byte_we = r_mem_byte_we;
                        r_store_we      = 1'b1;
                        r_load_we       = 1'b0;
                        r_hack_mem_we   = 1'b0;
                        state           = CpuState::MEM_WAIT;
                    } else if !is_riscv_mode && h_use_mem {
                        r_store_we    = 1'b0;
                        r_load_we     = 1'b0;
                        r_hack_mem_we = h_we_mem;
                        state         = CpuState::MEM_WAIT;
                    } else {
                        r_store_we    = 1'b0;
                        r_load_we     = 1'b0;
                        r_hack_mem_we = 1'b0;
                        pc_reg        = next_pc;
                        r_hack_d      = alu_result;
                        if hack_dual_dest {
                            state = CpuState::HACK_WR_D;
                        } else {
                            state = CpuState::FETCH;
                        }
                    }
                }
                CpuState::MEM_WAIT: {
                    r_store_we = 1'b0;
                    r_load_we  = 1'b0;
                    if is_riscv_mode {
                        r_hack_mem_we = 1'b0;
                        pc_reg        = pc_plus_4_reg;
                        state         = CpuState::FETCH;
                    } else {
                        // Latch memory read data for Hack ALU pipeline stage
                        r_hack_data = data_in;
                        state       = CpuState::HACK_WB;
                    }
                }
                CpuState::HACK_WB: {
                    r_store_we    = 1'b0;
                    r_load_we     = 1'b0;
                    r_hack_mem_we = 1'b0;
                    pc_reg        = next_pc;
                    r_hack_d      = alu_result;
                    if hack_dual_dest {
                        state = CpuState::HACK_WR_D;
                    } else {
                        state = CpuState::FETCH;
                    }
                }
                CpuState::HACK_WR_D: {
                    state = CpuState::FETCH;
                }
                default: {
                    state = CpuState::FETCH;
                }
            }
        }
    }
}
