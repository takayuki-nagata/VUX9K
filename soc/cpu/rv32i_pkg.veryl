// RISC-V RV32I Package Definitions in Veryl
pub package rv32i_pkg {
    // 7-bit Opcodes Enum
    enum Opcode {
        R_TYPE = 7'b011_0011,
        I_TYPE = 7'b001_0011,
        LOAD = 7'b000_0011,
        STORE = 7'b010_0011,
        BRANCH = 7'b110_0011,
        JAL = 7'b110_1111,
        JALR = 7'b110_0111,
        LUI = 7'b011_0111,
        AUIPC = 7'b001_0111,
        SYSTEM = 7'b111_0011,
        FENCE = 7'b000_1111,
    }

    // 3-bit Funct3 Enum
    enum Funct3 {
        ADD_SUB = 3'b000,
        SLL = 3'b001,
        SLT = 3'b010,
        SLTU = 3'b011,
        XOR = 3'b100,
        SRL_SRA = 3'b101,
        OR = 3'b110,
        AND = 3'b111,
    }

    const FUNCT3_PRIV  : logic<3> = 3'b000;
    const FUNCT3_CSRRW : logic<3> = 3'b001;
    const FUNCT3_CSRRS : logic<3> = 3'b010;
    const FUNCT3_CSRRC : logic<3> = 3'b011;
    const FUNCT3_CSRRWI: logic<3> = 3'b101;
    const FUNCT3_CSRRSI: logic<3> = 3'b110;
    const FUNCT3_CSRRCI: logic<3> = 3'b111;

    // ALU Operations Enum
    enum AluOp {
        ADD,
        SUB,
        SLL,
        SLT,
        SLTU,
        XOR,
        SRL,
        SRA,
        OR,
        AND,
        COPY_B,
        COPY_A,
    }
}
