// Waivers for `make lint-rtl` (verilator --lint-only -Wall on the Veryl-generated .sv).
// Veryl can't emit Verilator comments, so they live here, one per finding, each with
// its reason. Keep -file/-match narrow: a waiver must not cover a new finding.
`verilator_config

// ----- By design ---------------------------------------------------------------------

// Address aliasing (README "Memory map"): regions decode only the bits they need
lint_off -rule UNUSEDSIGNAL -file "*/soc_ram.sv" -match "*'i_addr'*"
lint_off -rule UNUSEDSIGNAL -file "*/soc_ram.sv" -match "*'d_addr'*"
lint_off -rule UNUSEDSIGNAL -file "*/soc_addr_decoder.sv" -match "*'addr'*"
lint_off -rule UNUSEDSIGNAL -file "*/tb_hex_runner.sv" -match "*'data_addr'*"
// Hack's ALU result is 16 bits; the port is the CPU's 32-bit datapath
lint_off -rule UNUSEDSIGNAL -file "*/next_pc_unit.sv" -match "*'hack_comp'*"
// mip only has MSIP/MTIP/MEIP
lint_off -rule UNUSEDSIGNAL -file "*/rv32i_csrs.sv" -match "*'pending'*"
// The SD data register is 8 bits wide on a 32-bit bus; its TX shift register sends
// bits 7..0 and so never reads its top bit after the load
lint_off -rule UNUSEDSIGNAL -file "*/sdcard_spi.sv" -match "*'shift_tx'*"
// The decoder hands over the whole funct7; RV32I only needs bit 5 (SUB/SRA)
lint_off -rule UNUSEDSIGNAL -file "*/unified_cpu.sv" -match "*'rv_funct7'*"
lint_off -rule UNUSEDSIGNAL -file "*/sdcard_spi.sv" -match "*'data_in'*"
// Outputs nothing reads: the shift registers' unused side, the PLL's other clocks, and
// the CPU outputs the riscv-tests harness doesn't need
lint_off -rule PINCONNECTEMPTY -file "*/uart_tx.sv" -match "*'pout'*"
lint_off -rule PINCONNECTEMPTY -file "*/uart_rx.sv" -match "*'sout'*"
lint_off -rule PINCONNECTEMPTY -file "*/board_top.sv" -match "*'CLKOUT*'*"
lint_off -rule PINCONNECTEMPTY -file "*/tb_hex_runner.sv"
// Testbench: the RAM's write enable is gated with reset as well
lint_off -rule SYNCASYNCNET -file "*/tb_hex_runner.sv" -match "*'rst'*"
// Simulation models of Gowin cells (sim/gowin_cells_sim.veryl): they declare every
// parameter and pin of the vendor cell, used or not, and share one file
lint_off -rule UNUSEDPARAM -file "*/gowin_cells_sim.sv"
lint_off -rule UNUSEDSIGNAL -file "*/gowin_cells_sim.sv"
lint_off -rule DECLFILENAME -file "*/gowin_cells_sim.sv"

// ----- To fix (each one is removed by the refactor that fixes it) ---------------------

// False loop: one always_comb in unified_cpu both drives the ALU operands and reads its result
lint_off -rule UNOPTFLAT -file "*/rv32i_alu.sv" -match "*.res_int'*"
