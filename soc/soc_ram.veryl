// Dual-Port Harvard Memory Module (8 KB I-RAM + 4 KB D-RAM)
// Perfectly Inferred into Gowin GW1NR-9 Hardware Block RAMs (BSRAMs)
pub module soc_ram #(
    param I_MEM_WORDS: u32 = 2048, // 8 KB I-RAM (2048 x 32-bit words)
    param D_MEM_WORDS: u32 = 1024, // 4 KB D-RAM (1024 x 32-bit words)
) (
    clk        : input  clock    ,
    rst        : input  reset    ,
    active_mode: input  logic    , // 0: Hack 16-bit, 1: RISC-V 32-bit
    i_addr     : input  logic<32>,
    i_data_out : output logic<32>,
    i_we       : input  logic    ,
    i_waddr    : input  logic<11>,
    i_wdata    : input  logic<32>,
    d_addr     : input  logic<32>,
    d_data_in  : input  logic<32>,
    d_data_out : output logic<32>,
    d_we       : input  logic    ,
    d_we_byte  : input  logic<4> ,
) {
    var i_mem : logic<32> [I_MEM_WORDS];
    var d_mem0: logic<8>  [D_MEM_WORDS];
    var d_mem1: logic<8>  [D_MEM_WORDS];
    var d_mem2: logic<8>  [D_MEM_WORDS];
    var d_mem3: logic<8>  [D_MEM_WORDS];

    var i_idx: logic<11>;
    var d_idx: logic<10>;

    assign i_idx = i_addr[12:2];
    assign d_idx = if active_mode == 1'b0 ? d_addr[9:0] : d_addr[11:2];

    embed (inline) sv{{{
        initial begin
            $readmemh("firmware/firmware.hex", i_mem);
        end
    }}}

    always_ff (clk) {
        if i_we {
            i_mem[i_waddr] = i_wdata;
        }
        i_data_out = i_mem[i_idx];
    }

    always_ff (clk) {
        if d_we {
            if active_mode == 1'b0 {
                d_mem0[d_idx] = d_data_in[7:0];
                d_mem1[d_idx] = d_data_in[15:8];
            } else {
                if d_we_byte[0] {
                    d_mem0[d_idx] = d_data_in[7:0];
                }
                if d_we_byte[1] {
                    d_mem1[d_idx] = d_data_in[15:8];
                }
                if d_we_byte[2] {
                    d_mem2[d_idx] = d_data_in[23:16];
                }
                if d_we_byte[3] {
                    d_mem3[d_idx] = d_data_in[31:24];
                }
            }
        }
        d_data_out = if active_mode == 1'b0 ?
            {16'h0000, d_mem1[d_idx], d_mem0[d_idx]}
        :
            {d_mem3[d_idx], d_mem2[d_idx], d_mem1[d_idx], d_mem0[d_idx]}
        ;
    }
}
