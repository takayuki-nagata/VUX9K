// Synchronous FIFO Buffer with Parameterized Width and Depth
pub module fifo_sync #(
    param WIDTH      : u32 = 8,
    param LOG_DEPTH  : u32 = 8,
    param COUNT_WIDTH: u32 = 9,
) (
    clk  : input  clock       ,
    rst  : input  reset       ,
    wdata: input  logic<WIDTH>,
    we   : input  logic       ,
    rdata: output logic<WIDTH>,
    re   : input  logic       ,
    full : output logic       ,
    empty: output logic       ,
) {
    const DEPTH      : u32                = 1 << LOG_DEPTH;
    const DEPTH_COUNT: logic<COUNT_WIDTH> = DEPTH;

    var mem  : logic<WIDTH>       [DEPTH];
    var waddr: logic<LOG_DEPTH>          ;
    var raddr: logic<LOG_DEPTH>          ;
    var count: logic<COUNT_WIDTH>        ;

    assign rdata = mem[raddr];

    // A read takes the head if there is one. A write is accepted unless the FIFO is
    // full and nothing is read in the same cycle (when full, the slot being read is
    // the one written; rdata still shows the old head until the edge).
    let do_read : logic = re && count != '0;
    let do_write: logic = we && (count != DEPTH_COUNT || do_read);

    always_ff (clk, rst) {
        if_reset {
            waddr = '0;
            raddr = '0;
            count = '0;
        } else {
            if do_write {
                mem[waddr] = wdata;
                waddr      = waddr + 1;
            }
            if do_read {
                raddr = raddr + 1;
            }
            if do_write && !do_read {
                count = count + 1;
            } else if do_read && !do_write {
                count = count - 1;
            }
        }
    }

    assign full  = count == DEPTH_COUNT;
    assign empty = count == '0;
}
