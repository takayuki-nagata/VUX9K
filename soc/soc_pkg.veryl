// SoC-wide constants: clock-derived dividers and the data-address map (README,
// "Memory & MMIO Register Map").
pub package soc_pkg {
    // SoC clock: board_top's PLL output from the 27 MHz crystal (README, "Clock")
    const CLK_HZ: u32 = 18000000;

    // UART bit time in clocks: 18 MHz / 115200 = 156 (+0.16 % baud error)
    const UART_BAUD: u32 = 115200;
    const UART_CNT : u32 = CLK_HZ / UART_BAUD;

    // SD SPI clock during card init must not exceed 400 kHz: half-period in clocks,
    // rounded up (23 -> 391 kHz). It is the reset value of sdcard_spi's divider
    // register; firmware lowers it once the card is ready, down to SD_CLK_DIV_MIN
    // (3 -> 3 MHz): MISO reaches the shift register through two synchronizer flops,
    // so a bit is sampled as the pin was 2 clocks before the rising edge, and the card
    // needs the clock after the falling edge to drive it.
    const SD_INIT_HZ     : u32 = 400000;
    const SD_CLK_DIV_HALF: u32 = (CLK_HZ + 2 * SD_INIT_HZ - 1) / (2 * SD_INIT_HZ);
    const SD_CLK_DIV_MIN : u32 = 3;

    // RV32 data address map: region = addr[31:28], MMIO page = addr[15:12]
    const RV_REGION_IRAM : logic<4> = 4'h0;
    const RV_REGION_DRAM : logic<4> = 4'h2;
    const RV_REGION_MMIO : logic<4> = 4'h4;
    const MMIO_PAGE_UART : logic<4> = 4'h0;
    const MMIO_PAGE_TIMER: logic<4> = 4'h1;
    const MMIO_PAGE_SD   : logic<4> = 4'h2;
    const MMIO_PAGE_GPIO : logic<4> = 4'h3;

    // Hack data address map (16-bit word addresses): RAM below HACK_MMIO_BASE,
    // MMIO in the 16 words from HACK_MMIO_BASE (UART in the first 4, GPIO after)
    const HACK_MMIO_BASE: logic<16> = 16'h6000;
}
