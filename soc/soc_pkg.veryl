// SoC-wide constants: clock-derived dividers and the data-address map (README,
// "Memory & MMIO Register Map").
pub package soc_pkg {
    // SoC clock: board_top's PLL output from the 27 MHz crystal (README, "Clock")
    const CLK_HZ: u32 = 18000000;

    // UART bit time in clocks: 18 MHz / 115200 = 156 (+0.16 % baud error)
    const UART_BAUD: u32 = 115200;
    const UART_CNT : u32 = CLK_HZ / UART_BAUD;

    // SD SPI clock during card init must not exceed 400 kHz: half-period in clocks,
    // rounded up (23 -> 391 kHz). It is the reset value of sdcard_spi's divider
    // register; firmware lowers it once the card is ready, down to SD_CLK_DIV_MIN
    // (3 -> 3 MHz): MISO reaches the shift register through two synchronizer flops,
    // so a bit is sampled as the pin was 2 clocks before the rising edge, and the card
    // needs the clock after the falling edge to drive it.
    const SD_INIT_HZ     : u32 = 400000;
    const SD_CLK_DIV_HALF: u32 = (CLK_HZ + 2 * SD_INIT_HZ - 1) / (2 * SD_INIT_HZ);
    const SD_CLK_DIV_MIN : u32 = 3;

    // RV32 data address map: region = addr[31:28], MMIO page = addr[15:12]
    const RV_REGION_IRAM : logic<4> = 4'h0;
    const RV_REGION_DRAM : logic<4> = 4'h2;
    const RV_REGION_MMIO : logic<4> = 4'h4;
    const MMIO_PAGE_UART : logic<4> = 4'h0;
    const MMIO_PAGE_TIMER: logic<4> = 4'h1;
    const MMIO_PAGE_SD   : logic<4> = 4'h2;
    const MMIO_PAGE_GPIO : logic<4> = 4'h3;

    // RV32 region 8: the wait-state window (soc_xmem_bridge in front of
    // psram::psram_controller, the on-package 8 MB PSRAM). Its XMEM_WORDS words repeat
    // every 8 MB across the region (soc_top hides the controller's register space). A
    // request accepted in cycle 0 gets its response (rsp_valid) in cycle
    // XMEM_READ_LATENCY or XMEM_WRITE_LATENCY: the controller's latencies at CLK_HZ =
    // 18 MHz, which sim/unit/test_psram_contract.py pins (through the word model); the
    // emulator copies both (emu/crates/vux9k_emu/src/soc.rs).
    const RV_REGION_XMEM    : logic<4> = 4'h8;
    const XMEM_ADDR_BITS    : u32      = 21; // word address bits
    const XMEM_WORDS        : u32      = 1 << XMEM_ADDR_BITS;
    const XMEM_READ_LATENCY : u32      = 35;
    const XMEM_WRITE_LATENCY: u32      = 34;

    // PSRAM power-up (psram::psram_controller): cycles from reset release until req_ready
    // and init_done first rise. psram_core holds RESET# low for tRP (psram_pkg::T_RP_NS,
    // 400 ns) and waits tVCS (T_VCS_NS, 200 us), each converted to CLK_HZ cycles rounded
    // up, and spends one more cycle in each of the two states: 8 + 3600 + 2 = 3610 at
    // 18 MHz. Copied here (soc_pkg must not need the IP's package); the contract test
    // sim/unit/test_psram_contract.py pins it to the controller.
    const PSRAM_RESET_PULSE_CYCLES: u64 = (400 * (CLK_HZ as u64) + 999_999_999) / 1_000_000_000;
    const PSRAM_INIT_WAIT_CYCLES  : u64 = (200_000 * (CLK_HZ as u64) + 999_999_999) / 1_000_000_000;
    const PSRAM_INIT_CYCLES       : u32 = (PSRAM_RESET_PULSE_CYCLES + PSRAM_INIT_WAIT_CYCLES + 2) as u32;

    // Hack data address map (16-bit word addresses): RAM below HACK_MMIO_BASE,
    // MMIO in the 16 words from HACK_MMIO_BASE (UART in the first 4, GPIO after)
    const HACK_MMIO_BASE: logic<16> = 16'h6000;

    // Hack's memory is in the window, in two segments soc_top forms by joining bits (README,
    // "Hack memory"): instructions at {HACK_I_BASE[31:16], pc[15:0]} (64 KB, the byte
    // address pc, two instructions a word), data word A (A < HACK_MMIO_BASE) at
    // {HACK_D_BASE[31:17], A[14:0], 2'b00} (one Hack word a 32-bit word, 96 KB of the
    // 128 KB segment). Copied by the emulator, fw_common::map, tools/vux_tool.py and
    // sim/integration/lockstep_programs.py (docs/agents/sync-points.md).
    const HACK_I_BASE: logic<32> = 32'h8000_0000;
    const HACK_D_BASE: logic<32> = 32'h8002_0000;
}
