// Tang Nano 9K Top-Level SoC Wrapper in Veryl
// Integrates CPU, boot ROM, UART, Machine Timer, SD Card SPI, GPIO, and Address Decoder,
// and the wait-state window (soc_icache/soc_dcache + soc_xmem_bridge + the PSRAM controller)
// at RV32 region 8, which also holds Hack's instruction and data segments

pub module soc_top (
    clk  : input clock,
    rst_n: input reset, // Active-Low Hardware Reset (Button S1)
    btn  : input logic, // Active-Low User Button (Button S2)

    // UART Interface
    uart_rx: input  logic,
    uart_tx: output logic,

    // On-Board 6x LEDs (Active-Low)
    led: output logic<6>,

    // SD Card SPI Interface
    sd_sclk: output logic,
    sd_mosi: output logic,
    sd_miso: input  logic,
    sd_cs_n: output logic,

    // On-package PSRAM (W955D8MBYA, two 4 MB dies; psram::psram_controller's pins)
    O_psram_ck     : output logic    <2> ,
    O_psram_ck_n   : output logic    <2> ,
    O_psram_cs_n   : output logic    <2> ,
    O_psram_reset_n: output logic    <2> ,
    IO_psram_dq    : inout  tri logic<16>,
    IO_psram_rwds  : inout  tri logic<2> ,
) {
    // Mode Status (1 = RISC-V 32-bit, 0 = Hack 16-bit)
    var active_mode: logic;

    // Power-on Reset & Synchronizer (Active-Low: 0 = Reset, 1 = Running)
    // 16-bit counter: 2^15 = 32,768 cycles (~1.82 ms at 18 MHz), fully debouncing external rst_n button
    var por_counter: logic<16>;
    var rst_sync   : logic<2> ;
    var raw_rst    : logic    ;

    always_ff (clk, rst_n) {
        if_reset {
            rst_sync    = 2'b00;
            por_counter = 16'd0;
            raw_rst     = 1'b0;
        } else {
            rst_sync = {rst_sync[0], 1'b1};
            if rst_sync[1] == 1'b0 {
                por_counter = 16'd0;
                raw_rst     = 1'b0;
            } else if por_counter[15] == 1'b0 {
                por_counter = por_counter + 1'b1;
                raw_rst     = 1'b0;
            } else {
                raw_rst = 1'b1; // Permanently 1 (Running) after Power-on Reset delay
            }
        }
    }
    var cpu_soft_rst   : logic;
    var boot_mode_valid: logic;
    var boot_mode      : logic;
    let rst            : reset = raw_rst as reset;

    // Bus Interconnect Signals
    var instr_addr  : logic<32>;
    var instr_data  : logic<32>;
    var cpu_instr_in: logic<32>; // instr_data, or the window's word for a window fetch

    var data_addr   : logic<32>;
    var data_waddr  : logic<32>;
    var cpu_data_out: logic<32>;
    var cpu_data_in : logic<32>;
    var mem_write   : logic    ;

    // Wait-state window: the CPU's request phases, the bridge's readies and read word
    var fetch_req     : logic    ;
    var fetch_addr    : logic<32>;
    var data_req      : logic    ;
    var instr_ready   : logic    ;
    var data_ready    : logic    ;
    var xmem_rdata    : logic<32>;
    var xmem_req_valid: logic    ;
    var xmem_req_ready: logic    ;
    var xmem_req_we   : logic    ;
    var xmem_req_addr : logic<32>;
    var xmem_req_wdata: logic<32>;
    var xmem_req_wstrb: logic<4> ;
    var xmem_rsp_valid: logic    ;
    var xmem_rsp_rdata: logic<32>;
    var xmem_fetch_sel: logic    ;

    // The window's caches, between the CPU and the bridge: what they pass on (misses,
    // stores), the bridge's readies they complete them with, the words they return
    var icache_mem_sel    : logic    ;
    var icache_rdata      : logic<32>;
    var dcache_mem_sel    : logic    ;
    var dcache_rdata      : logic<32>;
    var bridge_instr_ready: logic    ;
    var bridge_data_ready : logic    ;

    // Memory & MMIO Read Signals
    var rom_data_out  : logic<32>;
    var timer_data_out: logic<32>;
    var sd_data_out   : logic<32>;
    var gpio_data_out : logic<32>;
    var uart_rdata    : logic<8> ;
    var uart_empty    : logic    ;
    var uart_full     : logic    ;
    var uart_overrun  : logic    ;
    var uart_frame_err: logic    ;
    var uart_clr_err  : logic    ;

    // Address Decode Select Signals (Read & Write)
    var rom_sel   : logic;
    var uart_sel  : logic;
    var timer_sel : logic;
    var sd_sel    : logic;
    var gpio_sel  : logic;
    var xmem_sel  : logic;
    var uart_wsel : logic;
    var timer_wsel: logic;
    var sd_wsel   : logic;
    var gpio_wsel : logic;
    var xmem_wsel : logic;

    var uart_we : logic;
    var uart_re : logic;
    var timer_we: logic;
    var sd_we   : logic;
    var gpio_we : logic;

    var timer_irq  : logic    ;
    var mtime      : logic<64>;
    var cpu_byte_we: logic<4> ;
    var raw_led    : logic<6> ;

    // 6x LEDs connected to Software GPIO (controlled by firmware / main.rs)
    assign led = raw_led;

    var mem_read_req: logic;

    var last_rom_sel  : logic   ;
    var last_timer_sel: logic   ;
    var last_sd_sel   : logic   ;
    var last_gpio_sel : logic   ;
    var last_uart_sel : logic   ;
    var last_xmem_sel : logic   ;
    var last_addr_low : logic<4>;

    // Instantiate Unified Dual-ISA CPU Core (Veryl)
    inst cpu_inst: unified_cpu #(
        RESET_VECTOR: 32'h0000_0000,
    ) (
        clk            : clk            ,
        rst            : rst            ,
        soft_rst       : cpu_soft_rst   ,
        boot_mode_valid: boot_mode_valid,
        boot_mode      : boot_mode      ,
        instr_in       : cpu_instr_in   ,
        instr_ready    : instr_ready    , // 1 except while a window access waits
        data_in        : cpu_data_in    ,
        data_ready     : data_ready     ,
        timer_irq_in   : timer_irq      ,
        ext_irq_in     : !uart_empty    , // machine external interrupt: UART RX data waiting
        sw_irq_in      : 1'b0           ,
        mtime_in       : mtime          ,
        pc_out         : instr_addr     ,
        data_addr      : data_addr      ,
        data_waddr     : data_waddr     ,
        data_out       : cpu_data_out   ,
        mem_write      : mem_write      ,
        mem_read_req   : mem_read_req   ,
        mem_byte_we    : cpu_byte_we    ,
        active_mode    : active_mode    ,
        fetch_req      : fetch_req      ,
        fetch_addr     : fetch_addr     ,
        data_req       : data_req       ,
    );

    // Hack's segments in the window (soc_pkg::HACK_I_BASE/HACK_D_BASE), joined from bits:
    // a fetch at {HACK_I_BASE[31:16], pc[15:0]}, the data word A at {HACK_D_BASE[31:17],
    // A[14:0], 2'b00}. Only the caches and the bridge see these; the decode, the MMIO and
    // the trace keep the CPU's own addresses.
    let hack_fetch_addr: logic<32> = {soc_pkg::HACK_I_BASE[31:16], fetch_addr[15:0]};
    let hack_data_waddr: logic<32> = {soc_pkg::HACK_D_BASE[31:17], data_waddr[14:0], 2'b00};
    // The window's addresses of the access: the CPU's in RV32, the segments' in Hack
    let win_fetch_addr: logic<32> = if active_mode ? fetch_addr : hack_fetch_addr;
    let win_data_idx  : logic<9>  = if active_mode ? data_addr[10:2] : data_addr[8:0];
    let win_data_waddr: logic<32> = if active_mode ? data_waddr : hack_data_waddr;

    // Wait-state window. A fetch from it (RV32 region 8 at pc_reg, and every Hack fetch)
    // takes the instruction cache's word; every other fetch reads the boot ROM, which also
    // answers for addresses outside it (README, "Address decoding and aliases").
    assign xmem_fetch_sel = !active_mode || fetch_addr[31:28] == soc_pkg::RV_REGION_XMEM;
    assign cpu_instr_in   = if xmem_fetch_sel ? icache_rdata : instr_data;

    // The caches key lines by the PSRAM word (addr[22:2]) and read them a cycle ahead, at
    // the CPU's pc_out and data_addr (in Hack, the segments' bits of them: pc_out[11:2] is
    // the same, A[8:0] the data line). Their RAMs have no reset: they clear every line while
    // the power-on reset counts (raw_rst low; 1,024 cycles of its 32,768), so they are reset
    // by rst_n, not by it. A store to the window completing invalidates its
    // instruction-cache line. While cpu_soft_rst holds the CPU in FETCH the instruction cache
    // sees no fetch: one it started then (a soft reset into Hack fetches from the window at
    // once) would stay a miss until the bridge, which takes no request then, answered it, so
    // the first fetch after the pulse is a hit or a miss by its line alone.
    inst icache: soc_icache (
        clk                                                          ,
        rst        : rst_n                                           ,
        clear      : !raw_rst                                        ,
        rd_idx     : instr_addr[11:2]                                ,
        fetch_req  : fetch_req && !cpu_soft_rst,
        fetch_sel  : xmem_fetch_sel                                  ,
        fetch_addr : win_fetch_addr[22:2]                            ,
        instr_ready: instr_ready                                     ,
        rdata      : icache_rdata                                    ,
        hit        : _                                               ,
        inv        : data_req && xmem_wsel && mem_write && data_ready,
        inv_idx    : win_data_waddr[11:2]                            ,
        mem_sel    : icache_mem_sel                                  ,
        mem_ready  : bridge_instr_ready                              ,
        mem_rdata  : xmem_rdata                                      ,
    );

    inst dcache: soc_dcache (
        clk                             ,
        rst       : rst_n               ,
        clear     : !raw_rst            ,
        rd_idx    : win_data_idx        ,
        data_req  : data_req            ,
        data_sel  : xmem_wsel           , // data_waddr: the registered access address in MEM_WAIT
        data_addr : win_data_waddr[22:2],
        data_we   : mem_write           ,
        data_wdata: cpu_data_out        ,
        data_wstrb: cpu_byte_we         ,
        data_ready: data_ready          ,
        rdata     : dcache_rdata        ,
        hit       : _                   ,
        mem_sel   : dcache_mem_sel      ,
        mem_ready : bridge_data_ready   ,
        mem_rdata : xmem_rdata          ,
    );

    inst xmem_bridge: soc_xmem_bridge (
        clk        : clk               ,
        rst        : rst               ,
        soft_rst   : cpu_soft_rst      ,
        fetch_req  : fetch_req         ,
        fetch_sel  : icache_mem_sel    ,
        fetch_addr : win_fetch_addr    ,
        data_req   : data_req          ,
        data_sel   : dcache_mem_sel    ,
        data_addr  : win_data_waddr    ,
        data_we    : mem_write         ,
        data_wdata : cpu_data_out      ,
        data_wstrb : cpu_byte_we       ,
        instr_ready: bridge_instr_ready,
        data_ready : bridge_data_ready ,
        rdata      : xmem_rdata        ,
        req_valid  : xmem_req_valid    ,
        req_ready  : xmem_req_ready    ,
        req_we     : xmem_req_we       ,
        req_addr   : xmem_req_addr     ,
        req_wdata  : xmem_req_wdata    ,
        req_wstrb  : xmem_req_wstrb    ,
        rsp_valid  : xmem_rsp_valid    ,
        rsp_rdata  : xmem_rsp_rdata    ,
    );

    // The window's memory: 8 MB of PSRAM. req_addr[23] selects the controller's register
    // space (ID/CR registers), which the CPU must never reach, so it is forced to 0: region
    // 8's 256 MB repeat the 8 MB every 8 MB (0x8080_0020 is the word at 0x8000_0020, not
    // CR0). The controller is reset by rst_n, not by the power-on reset: its power-up
    // (soc_pkg::PSRAM_INIT_CYCLES, about 3,610 cycles) ends inside the 32,768-cycle POR,
    // so the CPU never sees req_ready low for it (test_psram_contract pins both numbers).
    let xmem_addr: logic<24> = {1'b0, xmem_req_addr[soc_pkg::XMEM_ADDR_BITS + 1:0]};

    // The RTL builds for Verilator (sim_runner.py) define VUX9K_PSRAM_MODEL and get the word
    // model instead: same host ports and timing, no pins (the pin-level PSRAM model is
    // Icarus only). Synthesis, lint and Icarus never define it.
    #[ifndef(VUX9K_PSRAM_MODEL)]
    inst xmem_inst: psram::psram_controller #(
        CLK_HZ: soc_pkg::CLK_HZ,
    ) (
        clk                            ,
        rst_n                          ,
        req_valid      : xmem_req_valid,
        req_ready      : xmem_req_ready,
        req_we         : xmem_req_we   ,
        req_addr       : xmem_addr     ,
        req_wdata      : xmem_req_wdata,
        req_wstrb      : xmem_req_wstrb,
        rsp_valid      : xmem_rsp_valid,
        rsp_rdata      : xmem_rsp_rdata,
        init_done      : _             ,
        O_psram_ck                     ,
        O_psram_ck_n                   ,
        O_psram_cs_n                   ,
        O_psram_reset_n                ,
        IO_psram_dq                    ,
        IO_psram_rwds                  ,
        dbg_sample     : _             ,
    );

    #[ifdef(VUX9K_PSRAM_MODEL)]
    inst xmem_inst: psram_word_model (
        clk                      ,
        rst_n                    ,
        req_valid: xmem_req_valid,
        req_ready: xmem_req_ready,
        req_we   : xmem_req_we   ,
        req_addr : xmem_addr     ,
        req_wdata: xmem_req_wdata,
        req_wstrb: xmem_req_wstrb,
        rsp_valid: xmem_rsp_valid,
        rsp_rdata: xmem_rsp_rdata,
        init_done: _             ,
    );

    // Pins of the model build: no PSRAM attached; chip selects high (deselected) and
    // RESET# low (held in reset), the state of a board whose PSRAM is unused; the bus
    // inouts are left undriven
    #[ifdef(VUX9K_PSRAM_MODEL)]
    always_comb {
        O_psram_ck      = 2'b00;
        O_psram_ck_n    = 2'b11;
        O_psram_cs_n    = 2'b11;
        O_psram_reset_n = 2'b00;
    }

    // Instantiate UART Controller (Veryl)
    inst uart_inst: uart_controller #(
        CNT  : soc_pkg::UART_CNT,
        CSIZE: 10               ,
    ) (
        clk      : clk              ,
        rst      : rst              ,
        wdata    : cpu_data_out[7:0],
        rdata    : uart_rdata       ,
        re       : uart_re          ,
        we       : uart_we          ,
        empty    : uart_empty       ,
        full     : uart_full        ,
        overrun  : uart_overrun     ,
        frame_err: uart_frame_err   ,
        clr_err  : uart_clr_err     ,
        txd      : uart_tx          ,
        rxd      : uart_rx          ,
    );

    // The boot ROM (16 KB, region 0): fetches at pc_out, loads at data_addr, each word
    // repeating every 16 KB. Nothing writes it: a store to region 0 is ignored, as is one to
    // an unassigned region.
    inst rom_inst: soc_rom (
        clk                     ,
        i_addr    : instr_addr  ,
        i_data_out: instr_data  ,
        d_addr    : data_addr   ,
        d_data_out: rom_data_out,
    );

    let periph_addr: logic<4> = if mem_write ? data_waddr[3:0] : data_addr[3:0];

    // Instantiate System Timer Core (Veryl)
    inst timer_inst: timer_core (
        clk      : clk           ,
        rst      : rst           ,
        addr     : periph_addr   ,
        data_in  : cpu_data_out  ,
        data_out : timer_data_out,
        we       : timer_we      ,
        timer_irq: timer_irq     ,
        mtime_out: mtime         ,
    );

    // Instantiate SD Card SPI Master Controller (Veryl)
    inst sd_inst: sdcard_spi (
        clk     : clk         ,
        rst     : rst         ,
        addr    : periph_addr ,
        data_in : cpu_data_out,
        data_out: sd_data_out ,
        we      : sd_we       ,
        spi_sclk: sd_sclk     ,
        spi_mosi: sd_mosi     ,
        spi_miso: sd_miso     ,
        spi_cs_n: sd_cs_n     ,
    );

    // Instantiate GPIO Controller (Veryl)
    inst gpio_inst: gpio_controller (
        clk            : clk            ,
        rst            : rst            ,
        addr           : periph_addr    ,
        data_in        : cpu_data_out   ,
        data_out       : gpio_data_out  ,
        we             : gpio_we        ,
        cpu_soft_rst   : cpu_soft_rst   ,
        boot_mode_valid: boot_mode_valid,
        boot_mode      : boot_mode      ,
        gpio_led       : raw_led        ,
        gpio_btn       : btn            ,
    );

    // Address decode of the read address (loads, peripheral read latches) and of the
    // write address (stores, peripheral write enables)
    inst rd_decode: soc_addr_decoder (
        addr     : data_addr   ,
        hack_mode: !active_mode,
        rom      : rom_sel     ,
        uart     : uart_sel    ,
        timer    : timer_sel   ,
        sd       : sd_sel      ,
        gpio     : gpio_sel    ,
        xmem     : xmem_sel    ,
    );
    inst wr_decode: soc_addr_decoder (
        addr     : data_waddr  ,
        hack_mode: !active_mode,
        rom      : _           , // the ROM takes no stores
        uart     : uart_wsel   ,
        timer    : timer_wsel  ,
        sd       : sd_wsel     ,
        gpio     : gpio_wsel   ,
        xmem     : xmem_wsel   ,
    );

    always_comb {
        // Only the data register transmits (RV32 byte offset 0; Hack 0x6000 has [3:0] == 0 too)
        uart_we  = mem_write && uart_wsel && data_waddr[3:0] == 4'h0;
        timer_we = mem_write && timer_wsel;
        sd_we    = mem_write && sd_wsel;
        gpio_we  = mem_write && gpio_wsel;

        // Pop the RX FIFO only when the CPU actually reads the data register (either mode);
        // reading the status register clears the sticky RX error flags
        uart_re      = mem_read_req && last_uart_sel && (last_addr_low == 4'h0);
        uart_clr_err = mem_read_req && last_uart_sel && (last_addr_low != 4'h0);
    }

    always_ff (clk, rst) {
        if_reset {
            last_rom_sel   = 1'b0;
            last_timer_sel = 1'b0;
            last_sd_sel    = 1'b0;
            last_gpio_sel  = 1'b0;
            last_uart_sel  = 1'b0;
            last_xmem_sel  = 1'b0;
            last_addr_low  = 4'd0;
        } else {
            last_rom_sel   = rom_sel;
            last_timer_sel = timer_sel;
            last_sd_sel    = sd_sel;
            last_gpio_sel  = gpio_sel;
            last_uart_sel  = uart_sel;
            last_xmem_sel  = xmem_sel;
            last_addr_low  = data_addr[3:0];
        }
    }

    let uart_data_bus: logic<32> = if last_addr_low == 4'h0 ?
        {24'h0, uart_rdata}
    :
        {28'h0, uart_frame_err, uart_overrun, uart_full, uart_empty}
    ;

    always_comb {
        cpu_data_in = (if last_rom_sel ? rom_data_out : 32'd0) | (if last_uart_sel ? uart_data_bus : 32'd0)
            | (if last_timer_sel ? timer_data_out : 32'd0) | (if last_sd_sel ? sd_data_out : 32'd0)
            | (if last_gpio_sel ? gpio_data_out : 32'd0) | (if last_xmem_sel ? dcache_rdata : 32'd0);
    }
}
