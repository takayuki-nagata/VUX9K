// Tang Nano 9K Top-Level SoC Wrapper in Veryl
// Integrates CPU, RAMs, UART, Machine Timer, SD Card SPI, GPIO, and Address Decoder

#[allow(unused_variable)]
#[allow(unassign_variable)]
pub module soc_top (
    clk  : input clock,
    rst_n: input logic, // Active-Low Hardware Reset (Button S1)
    btn  : input logic, // Active-Low User Button (Button S2)

    // UART Interface
    uart_rx: input  logic,
    uart_tx: output logic,

    // On-Board 6x LEDs (Active-Low)
    led: output logic<6>,

    // SD Card SPI Interface
    sd_sclk: output logic,
    sd_mosi: output logic,
    sd_miso: input  logic,
    sd_cs_n: output logic,
) {
    // Mode Status (1 = RISC-V 32-bit, 0 = Hack 16-bit)
    var active_mode: logic;

    // Power-on Reset & Synchronizer (Active-Low: 0 = Reset, 1 = Running)
    var por_counter: logic<20>;
    var raw_rst    : logic    ;

    always_ff (clk) {
        if ~rst_n {
            por_counter = '0;
            raw_rst     = 1'b0;
        } else {
            if por_counter[19] == 1'b0 {
                por_counter = por_counter + 1'b1;
                raw_rst     = 1'b0;
            } else {
                raw_rst = 1'b1; // Permanently 1 (Running) after 19.4ms Power-on Reset delay
            }
        }
    }
    let rst: reset = raw_rst as reset;

    // Bus Interconnect Signals
    var instr_addr: logic<32>;
    var instr_data: logic<32>;

    var data_addr   : logic<32>;
    var cpu_data_out: logic<32>;
    var cpu_data_in : logic<32>;
    var mem_write   : logic    ;

    // Memory & MMIO Read Signals
    var ram_data_out  : logic<32>;
    var timer_data_out: logic<32>;
    var sd_data_out   : logic<32>;
    var gpio_data_out : logic<32>;
    var uart_rdata    : logic<8> ;
    var uart_empty    : logic    ;
    var uart_full     : logic    ;

    // Address Decode Select Signals
    var ram_sel  : logic;
    var uart_sel : logic;
    var timer_sel: logic;
    var sd_sel   : logic;
    var gpio_sel : logic;

    var uart_we    : logic   ;
    var uart_re    : logic   ;
    var timer_we   : logic   ;
    var timer_re   : logic   ;
    var sd_we      : logic   ;
    var sd_re      : logic   ;
    var gpio_we    : logic   ;
    var gpio_re    : logic   ;
    var ram_we     : logic   ;
    var ram_we_byte: logic<4>;

    var timer_irq  : logic   ;
    var cpu_byte_we: logic<4>;
    var raw_led    : logic<6>;

    // 6x LEDs connected to Software GPIO (controlled by firmware / main.rs)
    assign led = raw_led;

    var mem_read_req: logic;

    // Instantiate Unified Dual-ISA CPU Core (Veryl)
    inst cpu_inst: unified_cpu (
        clk         : clk         ,
        rst         : rst         ,
        instr_in    : instr_data  ,
        data_in     : cpu_data_in ,
        timer_irq_in: timer_irq   ,
        ext_irq_in  : 1'b0        ,
        sw_irq_in   : 1'b0        ,
        pc_out      : instr_addr  ,
        data_addr   : data_addr   ,
        data_out    : cpu_data_out,
        mem_write   : mem_write   ,
        mem_read_req: mem_read_req,
        mem_byte_we : cpu_byte_we ,
        active_mode : active_mode ,
    );

    // Instantiate UART Controller (Veryl) - 27MHz / 115200 baud -> CNT=234
    inst uart_inst: uart_controller #(
        CNT  : 234,
        CSIZE: 10 ,
    ) (
        clk  : clk              ,
        rst  : rst              ,
        wdata: cpu_data_out[7:0],
        rdata: uart_rdata       ,
        re   : uart_re          ,
        we   : uart_we          ,
        empty: uart_empty       ,
        full : uart_full        ,
        txd  : uart_tx          ,
        rxd  : uart_rx          ,
    );

    var i_ram_we: logic;
    assign i_ram_we = mem_write && ram_sel && (active_mode == 1'b1) && (data_addr[31:20] == 12'h000);

    // Instantiate Harvard Memory (16KB I-RAM + 4KB D-RAM BSRAMs)
    inst ram_inst: soc_ram (
        clk        : clk            ,
        rst        : rst            ,
        active_mode: active_mode    ,
        i_addr     : instr_addr     ,
        i_data_out : instr_data     ,
        i_we       : i_ram_we       ,
        i_waddr    : data_addr[13:2],
        i_wdata    : cpu_data_out   ,
        d_addr     : data_addr      ,
        d_data_in  : cpu_data_out   ,
        d_data_out : ram_data_out   ,
        d_we       : ram_we         ,
        d_we_byte  : ram_we_byte    ,
    );

    // Instantiate System Timer Core (Veryl)
    inst timer_inst: timer_core (
        clk      : clk           ,
        rst      : rst           ,
        addr     : data_addr[3:0],
        data_in  : cpu_data_out  ,
        data_out : timer_data_out,
        we       : timer_we      ,
        re       : timer_re      ,
        timer_irq: timer_irq     ,
    );

    // Instantiate SD Card SPI Master Controller (Veryl)
    inst sd_inst: sdcard_spi (
        clk     : clk           ,
        rst     : rst           ,
        addr    : data_addr[3:0],
        data_in : cpu_data_out  ,
        data_out: sd_data_out   ,
        we      : sd_we         ,
        re      : sd_re         ,
        spi_sclk: sd_sclk       ,
        spi_mosi: sd_mosi       ,
        spi_miso: sd_miso       ,
        spi_cs_n: sd_cs_n       ,
    );

    // Instantiate GPIO Controller (Veryl)
    inst gpio_inst: gpio_controller (
        clk     : clk           ,
        rst     : rst           ,
        addr    : data_addr[3:0],
        data_in : cpu_data_out  ,
        data_out: gpio_data_out ,
        we      : gpio_we       ,
        re      : gpio_re       ,
        gpio_led: raw_led       ,
        gpio_btn: btn           ,
    );

    // Address Decoder Combinational Logic
    always_comb {
        ram_sel   = 1'b0;
        uart_sel  = 1'b0;
        timer_sel = 1'b0;
        sd_sel    = 1'b0;
        gpio_sel  = 1'b0;

        if active_mode == 1'b0 {
            // Hack Mode
            if data_addr[15:0] == 16'h6000 {
                uart_sel = 1'b1;
            } else if data_addr[15:0] == 16'h6004 {
                gpio_sel = 1'b1;
            } else if data_addr[15:0] <: 16'h6000 {
                ram_sel = 1'b1;
            }
        } else {
            // RISC-V Mode
            if data_addr[31:20] == 12'h200 || data_addr[31:20] == 12'h000 {
                ram_sel = 1'b1;
            } else if data_addr[31:16] == 16'h4000 {
                if data_addr[15:4] == 12'h000 {
                    uart_sel = 1'b1;
                } else if data_addr[15:4] == 12'h100 {
                    timer_sel = 1'b1;
                } else if data_addr[15:4] == 12'h200 {
                    sd_sel = 1'b1;
                } else if data_addr[15:4] == 12'h300 {
                    gpio_sel = 1'b1;
                }
            }
        }

        ram_we      = mem_write && ram_sel && ((active_mode == 1'b0) || (data_addr[31:20] == 12'h200));
        ram_we_byte = cpu_byte_we;
        uart_we     = mem_write && uart_sel;
        timer_we    = mem_write && timer_sel;
        sd_we       = mem_write && sd_sel;
        gpio_we     = mem_write && gpio_sel;

        uart_re  = if active_mode == 1'b0 ?
            (!mem_write && uart_sel)
        :
            (mem_read_req && uart_sel && (data_addr[3:0] == 4'h0))
        ;
        timer_re = 1'b1;
        sd_re    = 1'b1;
        gpio_re  = 1'b1;

        if ram_sel {
            cpu_data_in = ram_data_out;
        } else if timer_sel {
            cpu_data_in = timer_data_out;
        } else if sd_sel {
            cpu_data_in = sd_data_out;
        } else if gpio_sel {
            cpu_data_in = gpio_data_out;
        } else if uart_sel {
            if active_mode == 1'b0 {
                cpu_data_in = {24'h0, uart_rdata};
            } else if data_addr[3:0] == 4'h0 {
                cpu_data_in = {24'h0, uart_rdata};
            } else {
                cpu_data_in = {30'h0, uart_full, uart_empty};
            }
        } else {
            cpu_data_in = 32'h0;
        }
    }
}
