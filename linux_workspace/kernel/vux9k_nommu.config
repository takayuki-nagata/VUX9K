# Merged over the kernel's rv32_nommu_virt_defconfig (make linux, scripts/kconfig/merge_config.sh):
# one hart in M-mode, RV32IMA without the extensions the CPU lacks, the liteuart console
# (polled: the hart's interrupt controller has no line for it) and the CLINT timer that
# RISCV_M_MODE selects; the initramfs path is added by make linux (build/linux/initramfs.config).
# CONFIG_ARCH_VIRT is not set
# CONFIG_SMP is not set
CONFIG_HZ_100=y
# CONFIG_FPU is not set
# CONFIG_RISCV_ISA_C is not set
# CONFIG_RISCV_ISA_SVNAPOT is not set
# CONFIG_RISCV_ISA_SVPBMT is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_ZAWRS is not set
# CONFIG_RISCV_ISA_ZABHA is not set
# CONFIG_RISCV_ISA_ZACAS is not set
# CONFIG_RISCV_ISA_ZBA is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZBC is not set
# CONFIG_RISCV_ISA_ZBKB is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_RISCV_ISA_ZICBOP is not set
# console= takes the console's name (liteuart), not its tty's (ttyLXU)
CONFIG_CMDLINE="earlycon console=liteuart0"
CONFIG_CMDLINE_FORCE=y
# CONFIG_VIRTIO_MMIO is not set
# CONFIG_VIRTIO_BLK is not set
# CONFIG_EXT2_FS is not set
# CONFIG_SERIAL_8250 is not set
CONFIG_LITEX_SOC_CONTROLLER=y
CONFIG_SERIAL_LITEUART=y
CONFIG_SERIAL_LITEUART_CONSOLE=y
# The SD card: upstream mmc_spi (the card in SPI mode, its data CRC checked) on this tree's
# driver for the SoC's SPI port (patches/0001-spi-vux9k-sd.patch, polled), the MBR partition
# table and FAT32 (vfat), mounted on /mnt/sd at boot. No I/O scheduler: the card is the one
# block device, and mmc_block queues one request at a time
CONFIG_BLOCK=y
CONFIG_MSDOS_PARTITION=y
# CONFIG_IOSCHED_BFQ is not set
CONFIG_SPI=y
CONFIG_SPI_VUX9K_SD=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SPI=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
# The board's LEDs and its button S2 (GPIO 0x4000_3000; linux_workspace/dts/vux9k.dts): upstream's
# gpio-mmio on the LED register and, input only, on the button's, the LEDs as LED class devices
# (/sys/class/leds/led0-5) with the triggers the device tree and the shell give them (mmc's
# own, mmc0, comes with LEDS_TRIGGERS). The button is read through the GPIO character device
# (GPIO_CDEV, GPIOLIB's default) by this tree's sysmon: no INPUT for gpio-keys, no GPIO sysfs
CONFIG_GPIOLIB=y
CONFIG_GPIO_GENERIC_PLATFORM=y
# CONFIG_GPIO_SYSFS is not set
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_TIMER=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_PANIC=y
# Size: the whole system lives in 8 MB, and an executable needs its size in contiguous pages
# (FLAT, loaded into RAM). A 16 KB printk buffer (the default's 64 KB took 264 KB with its
# metadata; a boot logs a few KB). No virtual terminals, input or power management; the
# initramfs uncompressed (gunzip of 1 MB took ~50 s of simulated 18 MHz time on the emulator)
CONFIG_LOG_BUF_SHIFT=14
# Pageblocks of 512 kB (order 7) instead of 4 MB: with 8 MB the kernel turns grouping by
# mobility off unless a pageblock is small enough, and without it small unmovable allocations
# land anywhere and split every free 512 kB block, which each exec of busybox needs (order 7)
CONFIG_PAGE_BLOCK_MAX_ORDER=7
# CONFIG_VT is not set
# CONFIG_INPUT is not set
# CONFIG_PM is not set
# CONFIG_SUSPEND is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_MEMBARRIER is not set
# CONFIG_RSEQ is not set
# CONFIG_RD_GZIP is not set
# CONFIG_RD_ZSTD is not set
CONFIG_INITRAMFS_COMPRESSION_NONE=y
