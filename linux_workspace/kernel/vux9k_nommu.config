# Merged over the kernel's rv32_nommu_virt_defconfig (make linux, scripts/kconfig/merge_config.sh):
# one hart in M-mode, RV32IMA without the extensions the CPU lacks, the liteuart console
# (polled: the hart's interrupt controller has no line for it) and the CLINT timer that
# RISCV_M_MODE selects; the initramfs path is added by make linux (build/linux/initramfs.config).
# CONFIG_ARCH_VIRT is not set
# CONFIG_SMP is not set
CONFIG_HZ_100=y
# CONFIG_FPU is not set
# CONFIG_RISCV_ISA_C is not set
# CONFIG_RISCV_ISA_SVNAPOT is not set
# CONFIG_RISCV_ISA_SVPBMT is not set
# CONFIG_RISCV_ISA_V is not set
# CONFIG_RISCV_ISA_ZAWRS is not set
# CONFIG_RISCV_ISA_ZABHA is not set
# CONFIG_RISCV_ISA_ZACAS is not set
# CONFIG_RISCV_ISA_ZBA is not set
# CONFIG_RISCV_ISA_ZBB is not set
# CONFIG_RISCV_ISA_ZBC is not set
# CONFIG_RISCV_ISA_ZBKB is not set
# CONFIG_RISCV_ISA_ZICBOM is not set
# CONFIG_RISCV_ISA_ZICBOZ is not set
# CONFIG_RISCV_ISA_ZICBOP is not set
# console= takes the console's name (liteuart), not its tty's (ttyLXU)
CONFIG_CMDLINE="earlycon console=liteuart0"
CONFIG_CMDLINE_FORCE=y
# CONFIG_VIRTIO_MMIO is not set
# CONFIG_VIRTIO_BLK is not set
# CONFIG_EXT2_FS is not set
# CONFIG_SERIAL_8250 is not set
CONFIG_LITEX_SOC_CONTROLLER=y
CONFIG_SERIAL_LITEUART=y
CONFIG_SERIAL_LITEUART_CONSOLE=y
