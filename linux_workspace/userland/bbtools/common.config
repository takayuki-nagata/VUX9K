#
# What every one of the card's busyboxes has (KCONFIG_ALLCONFIG for allnoconfig, with the
# tool's own fragment after it): board/busybox.config's settings, and NOMMU, which buildroot's
# busybox package turns on in its configuration fixups (fork is vfork here). No shell: with
# NOMMU (ash needs an MMU), the choice of the shell called sh falls to hush and builds it in,
# and allnoconfig, which runs before NOMMU is on, chose ash.
CONFIG_LFS=y
CONFIG_BUSYBOX=y
CONFIG_NOMMU=y
# CONFIG_SH_IS_ASH is not set
CONFIG_SH_IS_NONE=y
CONFIG_BASH_IS_NONE=y
CONFIG_INSTALL_APPLET_SYMLINKS=y
CONFIG_NO_DEBUG_LIB=y
CONFIG_FEATURE_BUFFERS_USE_MALLOC=y
