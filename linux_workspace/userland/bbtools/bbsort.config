#
# bbsort: sort, uniq, cut, tr, tail. head and wc are the initramfs' busybox's.
CONFIG_SORT=y
# -k, -t, -b, -d, -f, -i, -o, -g, -h, -M, -c, -s and -z (-n, -r and -u are sort's own)
CONFIG_FEATURE_SORT_BIG=y
CONFIG_UNIQ=y
CONFIG_CUT=y
CONFIG_TR=y
# [:upper:] and the other classes
CONFIG_FEATURE_TR_CLASSES=y
CONFIG_TAIL=y
# -q, -s, -v and -F
CONFIG_FEATURE_FANCY_TAIL=y
