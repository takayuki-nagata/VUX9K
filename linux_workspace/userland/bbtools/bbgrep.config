#
# bbgrep: grep and egrep (-E, -i, -v, -c and -n are grep's own). With sed beside it (they share
# libbb's regex code) the exec's block was order 6: sed is bbsed.
CONFIG_GREP=y
CONFIG_EGREP=y
# -A, -B and -C
CONFIG_FEATURE_GREP_CONTEXT=y
