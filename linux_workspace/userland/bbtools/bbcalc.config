#
# bbcalc: expr and dc (the small dc: FEATURE_DC_BIG off; it runs -e SCRIPT, and takes its other
# arguments as files). Its exec's block is 2 KB short of order 6 (expr's ':' pulls in regex),
# so not expr's 64-bit numbers (EXPR_MATH_SUPPORT_64: libgcc's 64-bit division) nor dc's
# power and exp (FEATURE_DC_LIBM: libm).
CONFIG_EXPR=y
CONFIG_DC=y
