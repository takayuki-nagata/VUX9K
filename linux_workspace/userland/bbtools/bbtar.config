#
# bbtar: tar, uncompressed: no gzip or bzip2 (and so no -z, -j or autodetection). The card's
# Python modules come as one archive with an 8.3 name, VUX9K/LINUX/PYLIB.TAR, which the login
# shell's profile extracts with it (linux_workspace/userland/scripts/pylib; docs/agents/linux.md,
# "MicroPython"). A busybox of its own, not bbfiles': busybox counts tar at ~39 KB with every
# feature, and bbfiles' block has ~14 KB left below order 5; and each boot's look at the
# archive executes tar, which a small busybox reads from the card sooner. -c to make archives
# too, GNU long names (above 100 characters); no -T/-X lists, no -m, no user and group names
# (the passwd file's code), no long options (common.config has none).
CONFIG_TAR=y
CONFIG_FEATURE_TAR_CREATE=y
CONFIG_FEATURE_TAR_GNU_EXTENSIONS=y
