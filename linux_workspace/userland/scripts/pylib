#!/bin/sh
# Copyright (c) 2026 Takayuki Nagata
# SPDX-License-Identifier: MIT
#
# pylib: the Python modules MPY imports (docs/agents/linux.md, "MicroPython"). They come to the
# card as one archive with an 8.3 name, VUX9K/LINUX/PYLIB.TAR (the stages and mkfat write no
# other names), which this extracts with their long names into VUX9K/LINUX/PYLIB/, MPY's path,
# when the archive's PYLIB/VERSION (its last member) is not the one there: never by the files'
# times, which a put leaves meaningless. /etc/profile sources it at the login shell's first
# start in a boot; `pylib` by hand looks again. Nothing to do without the card or the archive.
# A failure is reported and leaves no PYLIB/VERSION, so the next boot extracts again; it never
# stops the boot. No exit and no other names than PYLIB_*, unset at the end: sourced, an exit
# would end the login shell. Builtins but tar (the card's bbtar), rm and sync: this hush has
# no $( ), so the archive's version goes through a file in the initramfs.
PYLIB_CARD=/mnt/sd/VUX9K/LINUX
PYLIB_VER=/run/pylib.ver
if [ -f $PYLIB_CARD/PYLIB.TAR ]; then
	PYLIB_NEW=
	PYLIB_OLD=
	tar -xOf $PYLIB_CARD/PYLIB.TAR PYLIB/VERSION >$PYLIB_VER
	read PYLIB_NEW <$PYLIB_VER
	read PYLIB_OLD 2>/dev/null <$PYLIB_CARD/PYLIB/VERSION
	if [ -z "$PYLIB_NEW" ]; then
		echo "pylib: no PYLIB/VERSION in PYLIB.TAR"
	elif [ "$PYLIB_NEW" != "$PYLIB_OLD" ]; then
		echo "pylib: extracting PYLIB.TAR"
		rm -rf $PYLIB_CARD/PYLIB
		if tar -xf $PYLIB_CARD/PYLIB.TAR -C $PYLIB_CARD && sync; then
			echo "pylib: PYLIB.TAR extracted, version $PYLIB_NEW"
		else
			rm -f $PYLIB_CARD/PYLIB/VERSION
			sync
			echo "pylib: PYLIB.TAR not extracted"
		fi
	fi
	unset PYLIB_NEW PYLIB_OLD
fi
unset PYLIB_CARD PYLIB_VER
