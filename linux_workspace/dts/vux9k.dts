// noMMU Linux on VUX9K: the SoC as synthesized, its CLINT block and liteuart registers the
// RTL's, so the same tree is meant for the board and serves the emulator's real profile (vux9k-emu --linux;
// docs/agents/linux.md). The memory is all of the
// PSRAM: the stages' memory (0x806F_0000 up) is free once the kernel runs. The DTB sits in its
// top 64 KB (0x807F_0000), which the kernel keeps.
/dts-v1/;

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	model = "VUX9K";
	compatible = "vux9k,soc";

	chosen {
		stdout-path = &uart0;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		timebase-frequency = <18000000>;

		cpu0: cpu@0 {
			device_type = "cpu";
			reg = <0>;
			compatible = "riscv";
			riscv,isa-base = "rv32i";
			/* No zicntr: mcounteren is 0, so cycle/time/instret trap in U-mode */
			riscv,isa-extensions = "i", "m", "a", "zicsr", "zifencei";
			mmu-type = "riscv,none";

			cpu0_intc: interrupt-controller {
				#address-cells = <0>;
				#interrupt-cells = <1>;
				compatible = "riscv,cpu-intc";
				interrupt-controller;
			};
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x800000>;
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "simple-bus";
		ranges;

		clint@20000000 {
			compatible = "riscv,clint0";
			reg = <0x20000000 0x10000>;
			interrupts-extended = <&cpu0_intc 3>, <&cpu0_intc 7>;
		};

		uart0: serial@40000000 {
			compatible = "litex,liteuart";
			reg = <0x40000000 0x100>;
		};

		/*
		 * The SD card's SPI port (this tree's spi-vux9k-sd, linux_workspace/kernel/patches/):
		 * polled, SCLK = clock-frequency / (2 * divider), 3 MHz at most. The card is
		 * mmc_spi's; with no card-detect line it polls the card every second.
		 */
		spi@40002000 {
			compatible = "vux9k,sd-spi";
			reg = <0x40002000 0x10>;
			clock-frequency = <18000000>;
			#address-cells = <1>;
			#size-cells = <0>;

			mmc@0 {
				compatible = "mmc-spi-slot";
				reg = <0>;
				spi-max-frequency = <3000000>;
				voltage-ranges = <3300 3300>;
			};
		};

		/*
		 * The GPIO block (README's address map) as two of upstream's gpio-mmio chips, one
		 * register each, 32-bit accesses (the block ignores byte strobes): the 6 LEDs'
		 * register at 0x0 (bit n = LED n, 1 = lit, read back; no direction register, so
		 * gpio-mmio makes every line an output), and the button S2's at 0x4 (bit 0, 1 while
		 * pressed), input only. Neither covers 0x8/0xC, the soft reset's registers.
		 * No interrupt: whoever reads the button polls it (sysmon).
		 */
		gpio_leds: gpio@40003000 {
			compatible = "wd,mbl-gpio";
			reg = <0x40003000 0x4>;
			reg-names = "dat";
			ngpios = <6>;
			gpio-controller;
			#gpio-cells = <2>;
		};

		gpio_button: gpio@40003004 {
			compatible = "wd,mbl-gpio";
			reg = <0x40003004 0x4>;
			reg-names = "dat";
			ngpios = <1>;
			no-output;
			gpio-controller;
			#gpio-cells = <2>;
			label = "button";
		};
	};

	/*
	 * /sys/class/leds/led0-5 (the flags cell 0: active high, the GPIO block inverts the
	 * pins): led0 the kernel's heartbeat (faster under load), led1 the SD card's accesses
	 * (mmc0), led2-5 sysmon's bar (linux_workspace/userland/sysmon/). The shell can give any
	 * of them another trigger (echo timer > /sys/class/leds/led0/trigger) or none.
	 */
	leds {
		compatible = "gpio-leds";

		led-0 {
			label = "led0";
			gpios = <&gpio_leds 0 0>;
			linux,default-trigger = "heartbeat";
		};
		led-1 {
			label = "led1";
			gpios = <&gpio_leds 1 0>;
			linux,default-trigger = "mmc0";
		};
		led-2 {
			label = "led2";
			gpios = <&gpio_leds 2 0>;
			default-state = "off";
		};
		led-3 {
			label = "led3";
			gpios = <&gpio_leds 3 0>;
			default-state = "off";
		};
		led-4 {
			label = "led4";
			gpios = <&gpio_leds 4 0>;
			default-state = "off";
		};
		led-5 {
			label = "led5";
			gpios = <&gpio_leds 5 0>;
			default-state = "off";
		};
	};
};
