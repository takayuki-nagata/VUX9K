// Tang Nano 9K Physical Pin Constraints (tangnano9k.cst)
// Gowin GW1NR-LV9QN88PC6/I5

// 27MHz On-Board Oscillator
IO_LOC  "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "rst_n" 4;
IO_PORT "rst_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;

IO_LOC  "btn" 3;
IO_PORT "btn" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// USB-UART (Tang Nano 9K on-board debugger: FPGA TX = Pin 17, FPGA RX = Pin 18)
IO_LOC  "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "uart_rx" 18;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// On-Board 6x LEDs (Active-Low)
IO_LOC  "led[0]" 10;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;
IO_LOC  "led[1]" 11;
IO_PORT "led[1]" IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;
IO_LOC  "led[2]" 13;
IO_PORT "led[2]" IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;
IO_LOC  "led[3]" 14;
IO_PORT "led[3]" IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;
IO_LOC  "led[4]" 15;
IO_PORT "led[4]" IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;
IO_LOC  "led[5]" 16;
IO_PORT "led[5]" IO_TYPE=LVCMOS18 PULL_MODE=NONE DRIVE=8;

// MicroSD Card Slot (SPI Interface)
IO_LOC  "sd_sclk" 36;
IO_PORT "sd_sclk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "sd_mosi" 37;
IO_PORT "sd_mosi" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;
IO_LOC  "sd_miso" 39;
IO_PORT "sd_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "sd_cs_n" 38;
IO_PORT "sd_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// =============================================================================
// Internal SiP PSRAM (Winbond W955D8MBYA, 64Mbit, 2x 32Mb x8)
// =============================================================================

// Channel 0
IO_LOC  "O_psram_ck[0]" IOL8A;
IO_PORT "O_psram_ck[0]" IO_TYPE=LVCMOS18;
IO_LOC  "O_psram_ck_n[0]" IOL7A;
IO_PORT "O_psram_ck_n[0]" IO_TYPE=LVCMOS18;
IO_LOC  "O_psram_cs_n[0]" IOL6B;
IO_PORT "O_psram_cs_n[0]" IO_TYPE=LVCMOS18;
IO_LOC  "O_psram_reset_n[0]" IOL2A;
IO_PORT "O_psram_reset_n[0]" IO_TYPE=LVCMOS18;
IO_LOC  "IO_psram_rwds[0]" IOL17A;
IO_PORT "IO_psram_rwds[0]" IO_TYPE=LVCMOS18;
IO_LOC  "IO_psram_dq[0]" IOL2B;
IO_PORT "IO_psram_dq[0]" IO_TYPE=LVCMOS18;
IO_LOC  "IO_psram_dq[1]" IOL3A;
IO_PORT "IO_psram_dq[1]" IO_TYPE=LVCMOS18;
IO_LOC  "IO_psram_dq[2]" IOL3B;
IO_PORT "IO_psram_dq[2]" IO_TYPE=LVCMOS18;
IO_LOC  "IO_psram_dq[3]" IOL4A;
IO_PORT "IO_psram_dq[3]" IO_TYPE=LVCMOS18;
IO_LOC  "IO_psram_dq[4]" IOL9A;
IO_PORT "IO_psram_dq[4]" IO_TYPE=LVCMOS18;
IO_LOC  "IO_psram_dq[5]" IOL14A;
IO_PORT "IO_psram_dq[5]" IO_TYPE=LVCMOS18;
IO_LOC  "IO_psram_dq[6]" IOL16A;
IO_PORT "IO_psram_dq[6]" IO_TYPE=LVCMOS18;
IO_LOC  "IO_psram_dq[7]" IOL17B;
IO_PORT "IO_psram_dq[7]" IO_TYPE=LVCMOS18;

// Channel 1
IO_LOC  "O_psram_ck[1]" IOL23B;
IO_PORT "O_psram_ck[1]" IO_TYPE=LVCMOS18;
IO_LOC  "O_psram_ck_n[1]" IOL23A;
IO_PORT "O_psram_ck_n[1]" IO_TYPE=LVCMOS18;
IO_LOC  "O_psram_cs_n[1]" IOL22A;
IO_PORT "O_psram_cs_n[1]" IO_TYPE=LVCMOS18;
IO_LOC  "O_psram_reset_n[1]" IOL18A;
IO_PORT "O_psram_reset_n[1]" IO_TYPE=LVCMOS18;
IO_LOC  "IO_psram_rwds[1]" IOL27B;
IO_PORT "IO_psram_rwds[1]" IO_TYPE=LVCMOS18;
IO_LOC  "IO_psram_dq[8]" IOL18B;
IO_PORT "IO_psram_dq[8]" IO_TYPE=LVCMOS18;
IO_LOC  "IO_psram_dq[9]" IOL20A;
IO_PORT "IO_psram_dq[9]" IO_TYPE=LVCMOS18;
IO_LOC  "IO_psram_dq[10]" IOL20B;
IO_PORT "IO_psram_dq[10]" IO_TYPE=LVCMOS18;
IO_LOC  "IO_psram_dq[11]" IOL21A;
IO_PORT "IO_psram_dq[11]" IO_TYPE=LVCMOS18;
IO_LOC  "IO_psram_dq[12]" IOL24B;
IO_PORT "IO_psram_dq[12]" IO_TYPE=LVCMOS18;
IO_LOC  "IO_psram_dq[13]" IOL25A;
IO_PORT "IO_psram_dq[13]" IO_TYPE=LVCMOS18;
IO_LOC  "IO_psram_dq[14]" IOL26A;
IO_PORT "IO_psram_dq[14]" IO_TYPE=LVCMOS18;
IO_LOC  "IO_psram_dq[15]" IOL27A;
IO_PORT "IO_psram_dq[15]" IO_TYPE=LVCMOS18;
